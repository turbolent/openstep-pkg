#!/bin/sh

set -e

ulimit -d 65536
ulimit -s 8192

DESTDIR=$1
case "$DESTDIR" in
//*) DESTDIR="/`echo "$DESTDIR" | sed 's#^/*##'`" ;;
esac

VERSION=$2
BUILDROOT=`pwd`
if [ -f "$BUILDROOT/gcc/cp/cp-lang.c" ]; then
    cd ..
    BUILDROOT=`pwd`
fi
SRCDIR="$BUILDROOT/gcc-gcc-5666.3"
# Keep redirection paths short: stock-built pdksh mishandles the long
# expanded absolute filename under the package cache.
PATCHFILE=gcc-5666.3-openstep.patch
BUILDDIR="$SRCDIR/build-openstep"
# Build the compiler for the architecture this system runs.  OPENSTEP's arch(1)
# prints i386, sparc, ...; GCC42_ARCH overrides it.  i386 stays the default.
case "${GCC42_ARCH:-`/usr/bin/arch 2>/dev/null`}" in
sparc*) ARCH=sparc ;;
*)      ARCH=i386 ;;
esac
TARGET=$ARCH-next-openstep4
PREFIX=/usr/local
PATH=/usr/local/bin:/bin:/usr/bin:/usr/ucb
TMPDIR=/tmp
CONFIG_SHELL=/usr/local/bin/ksh
# Use the stock compiler and its GNU preprocessor for the first stage.
CC='/bin/cc -traditional-cpp'
CC_FOR_BUILD=$CC
CXX=$CC
AWK=/usr/local/bin/gawk
MAKE=/usr/local/bin/gnumake
AS=/bin/as
LD=/bin/ld
NM=/bin/nm
AS_FOR_TARGET=$AS
LD_FOR_TARGET=$LD
NM_FOR_TARGET=$NM
MAKEINFO=/usr/local/bin/makeinfo
FLEX=/usr/local/bin/flex
BISON=/usr/local/bin/bison
BUILD_CFLAGS='-O2 -D_POSIX_SOURCE'
BOOT_CFLAGS="$BUILD_CFLAGS --param ggc-min-expand=5 --param ggc-min-heapsize=4096"
# Extra flags for the stage 2/3 compiles only.  A stage-1 compiler built before
# the sparc/next.h ASM_OUTPUT_ALIGNED_BSS fix needs -fno-zero-initialized-in-bss
# (the same placement the fix gives) when resuming with GCC42_RESUME=1.
BOOT_CFLAGS="$BOOT_CFLAGS $GCC42_BOOT_EXTRA_CFLAGS"
# Stage 2 and 3 link with direct calls, so ld pulls libiberty's getopt.o, whose
# data symbols System also defines.  OPENSTEP/SPARC ld rejects that unless
# multiple definitions are allowed (-m, the first definition wins).
BOOT_LDFLAGS=
if [ "$ARCH" = sparc ]; then
    BOOT_LDFLAGS="-Wl,-m"
fi
SEED_CFLAGS='-O0 -D_POSIX_SOURCE'
CFLAGS=$BUILD_CFLAGS
CXXFLAGS=$BUILD_CFLAGS
CPPFLAGS='-D_POSIX_SOURCE'
CFLAGS_FOR_BUILD=$BUILD_CFLAGS
CXXFLAGS_FOR_BUILD=$BUILD_CFLAGS
CFLAGS_FOR_TARGET=$BUILD_CFLAGS
CXXFLAGS_FOR_TARGET=$BUILD_CFLAGS
am_cv_CC_dependencies_compiler_type=none
ac_cv_func_mmap=no

export ARCH DESTDIR VERSION BUILDROOT SRCDIR PATCHFILE BUILDDIR TARGET PREFIX
export PATH TMPDIR CONFIG_SHELL CC CXX AS LD NM AS_FOR_TARGET LD_FOR_TARGET NM_FOR_TARGET
export MAKEINFO FLEX BISON BUILD_CFLAGS CPPFLAGS CC_FOR_BUILD AWK MAKE CFLAGS CXXFLAGS
export CFLAGS_FOR_BUILD CXXFLAGS_FOR_BUILD CFLAGS_FOR_TARGET CXXFLAGS_FOR_TARGET
export am_cv_CC_dependencies_compiler_type ac_cv_func_mmap

# Same-version dependencies may predate the OPENSTEP snprintf fix.
if [ "`"$AWK" 'BEGIN { printf "%d", -1 }'`" != -1 ]; then
    echo "gcc42: rebuild and reinstall the corrected gawk package first" >&2
    exit 1
fi

# GCC42_RESUME=1 continues an interrupted build in place: it skips the patch,
# the mtime reset and configure, and goes straight back to make.  Run this
# script from inside the extracted source directory, as pkg does.
cd "$SRCDIR"
if [ -z "$GCC42_RESUME" ]; then
# Import only the verified GNU runtime subtree, preserving Apple's compiler.
mv "$BUILDROOT/gcc-runtime/gcc-4.2.1/libstdc++-v3" .
patch -p1 < "$PATCHFILE"

# Normalize the upstream source inputs' mtimes
# after extraction so Automake's clock-sanity check and make dependencies do
# not inherit UTC/local-time skew from the transported archives.
/usr/bin/find . -type f -exec /usr/bin/touch {} \;
fi

test -d "$BUILDDIR" || mkdir "$BUILDDIR"
cd "$BUILDDIR"

if [ -z "$GCC42_RESUME" ]; then
"$CONFIG_SHELL" ../configure \
    --build="$TARGET" \
    --host="$TARGET" \
    --target="$TARGET" \
    --prefix="$PREFIX" \
    --with-as="$AS" \
    --with-ld="$LD" \
    --program-suffix=-4.2 \
    --with-gxx-include-dir=/usr/local/include/c++/4.2.1 \
    --enable-languages=c,c++,objc,obj-c++ \
    --enable-sjlj-exceptions \
    --enable-version-specific-runtime-libs \
    --enable-bootstrap \
    --disable-checking \
    --disable-stage1-checking \
    --disable-libgomp \
    --disable-libmudflap \
    --disable-libssp \
    --disable-multilib \
    --disable-nls \
    --disable-shared \
    --disable-symvers \
    --disable-tls \
    --disable-visibility
fi

# Three native compiler stages, followed by GCC's stage-2/stage-3 comparison.
# Stock cc cannot optimize insn-attrtab.c within this host's resources.
# Optimize the two self-built stages and runtimes; compare stages 2 and 3.
"$MAKE" -j1 SHELL="$CONFIG_SHELL" STAGE1_CFLAGS="$SEED_CFLAGS" \
    BOOT_CFLAGS="$BOOT_CFLAGS" BOOT_LDFLAGS="$BOOT_LDFLAGS" bootstrap

# Force a fresh comparison rather than accepting the existing comparison stamp.
/bin/rm -f compare
"$MAKE" SHELL="$CONFIG_SHELL" compare
"$CONFIG_SHELL" "$SRCDIR/bootstrap-compare"
# compare parks the final compiler/runtime in stage3-*; restore them for install.
"$MAKE" SHELL="$CONFIG_SHELL" unstage

# OPENSTEP ar truncates long member names.  When libtool flattens the
# libsupc++ convenience archive, the long-named exception objects otherwise
# disappear from libstdc++.a.  Merge the complete standalone archive back in.
LIBSTDCXX_A="$BUILDDIR/$TARGET/libstdc++-v3/src/.libs/libstdc++.a"
LIBSUPCXX_A="$BUILDDIR/$TARGET/libstdc++-v3/libsupc++/.libs/libsupc++.a"
LIBSTDCXX_MERGE_DIR="$BUILDDIR/next-libstdcxx-merge"
test -d "$LIBSTDCXX_MERGE_DIR" || mkdir "$LIBSTDCXX_MERGE_DIR"
(
    cd "$LIBSTDCXX_MERGE_DIR"
    /bin/ar x "$LIBSUPCXX_A"
    /bin/rm -f __.SYMDEF*
    /bin/ar r "$LIBSTDCXX_A" *
    /bin/ranlib "$LIBSTDCXX_A"
)

"$MAKE" SHELL="$CONFIG_SHELL" DESTDIR="$DESTDIR" \
    CFLAGS="$BUILD_CFLAGS" CXXFLAGS="$BUILD_CFLAGS" \
    CFLAGS_FOR_BUILD="$BUILD_CFLAGS" CXXFLAGS_FOR_BUILD="$BUILD_CFLAGS" \
    CFLAGS_FOR_TARGET="$BUILD_CFLAGS" CXXFLAGS_FOR_TARGET="$BUILD_CFLAGS" \
    install-gcc
"$MAKE" SHELL="$CONFIG_SHELL" DESTDIR="$DESTDIR" \
    CFLAGS="$BUILD_CFLAGS" CXXFLAGS="$BUILD_CFLAGS" \
    CFLAGS_FOR_BUILD="$BUILD_CFLAGS" CXXFLAGS_FOR_BUILD="$BUILD_CFLAGS" \
    CFLAGS_FOR_TARGET="$BUILD_CFLAGS" CXXFLAGS_FOR_TARGET="$BUILD_CFLAGS" \
    install-target-libstdc++-v3

# The package installer's legacy tar cannot transport these four paths even
# though the OPENSTEP filesystem accepts them.  Stage short-path copies for
# post-install to restore after the image has been extracted.  (i386 only: the
# driverkit headers exist only for that architecture.)
if [ "$ARCH" = i386 ]; then
    DRIVERKIT_FIXED="$DESTDIR/usr/local/lib/gcc/$TARGET/4.2.1/include/driverkit/__next_i386__"
    DRIVERKIT_HOLD="$DESTDIR/usr/local/lib/gcc42-header-hold"
    test -d "$DRIVERKIT_HOLD" || /usr/local/bin/mkdir -p "$DRIVERKIT_HOLD"
    for header in IOEISADeviceDescription.h IOPCMCIADirectDevice.h \
        IOPCIDeviceDescription.h IOPCMCIADeviceDescription.h
    do
        /bin/cp "$DRIVERKIT_FIXED/$header" "$DRIVERKIT_HOLD/$header"
    done
fi

for archive in \
    "$DESTDIR/usr/local/lib/gcc/$TARGET/4.2.1/libgcc.a" \
    "$DESTDIR/usr/local/lib/gcc/$TARGET/4.2.1/libgcc_eh.a" \
    "$DESTDIR/usr/local/lib/gcc/$TARGET/4.2.1/libstdc++.a" \
    "$DESTDIR/usr/local/lib/gcc/$TARGET/4.2.1/libsupc++.a" \
    "$DESTDIR/usr/local/lib/libstdc++.a" \
    "$DESTDIR/usr/local/lib/libsupc++.a"
do
    if [ -f "$archive" ]; then
        /bin/ranlib "$archive"
    fi
done
