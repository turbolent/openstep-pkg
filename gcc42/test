#!/bin/sh

set -e

CC="$ROOT_DIR/usr/local/bin/gcc-4.2"
CXX="$ROOT_DIR/usr/local/bin/g++-4.2"
CPP="$ROOT_DIR/usr/local/bin/cpp-4.2"
GCOV="$ROOT_DIR/usr/local/bin/gcov-4.2"
TMP=/tmp/pkg-gcc42-$$

[ -x "$CC" ]
[ -x "$CXX" ]
[ -x "$CPP" ]
[ -x "$GCOV" ]

MACHINE=`"$CC" -dumpmachine`
case "$MACHINE" in
i386-*) ARCH=i386 ;;
sparc-*) ARCH=sparc ;;
*) echo "gcc42: unexpected target $MACHINE"; exit 1 ;;
esac

if [ "$ARCH" = i386 ]; then
    for header in IOEISADeviceDescription.h IOPCMCIADirectDevice.h \
        IOPCIDeviceDescription.h IOPCMCIADeviceDescription.h
    do
        [ -f "$ROOT_DIR/usr/local/lib/gcc/$MACHINE/4.2.1/include/driverkit/__next_i386__/$header" ]
    done
fi

"$CC" --version | grep '4\.2\.1' >/dev/null 2>&1

/bin/rm -f "$TMP.c" "$TMP.cc" "$TMP.m" "$TMP.mm" "$TMP.s" \
    "$TMP-c" "$TMP-cxx" "$TMP-objc" "$TMP-objcpp" "$TMP.log"

cat > "$TMP.c" <<'EOF'
#include <stdio.h>
#include <stdarg.h>
#include <stdlib.h>
#include <string.h>
long long quad_probe = 0x1122334455667788LL;
volatile long long numerator = -1234567890123LL;
volatile long long divisor = 97;
static double collect(int count, ...) {
    va_list ap; double sum; int i;
    sum = 0.0; va_start(ap, count);
    for (i = 0; i < count; ++i) sum += va_arg(ap, double);
    va_end(ap); return sum;
}
int main(void) {
    long long quotient, remainder;
    char *end;
    double parsed;
    quotient = numerator / divisor; remainder = numerator % divisor;
    if (quotient != -12727504021LL || remainder != -86LL) return 1;
    if (collect(3, 1.25, 2.5, -0.5) != 3.25) return 2;
    if (quad_probe != 0x1122334455667788LL) return 3;
    parsed = strtod("3.25", &end);
    if (parsed != 3.25 || *end != '\0') return 4;
    puts("gcc42 c ok"); return 0;
}
EOF
"$CC" -S "$TMP.c" -o "$TMP.s"
if grep '\.quad' "$TMP.s" >/dev/null 2>&1; then
    echo "gcc42 emitted unsupported .quad"
    exit 1
fi
for level in 0 2; do
    "$CC" -O$level "$TMP.c" -o "$TMP-c"
    [ "`"$TMP-c"`" = "gcc42 c ok" ]
done

cat > "$TMP.cc" <<'EOF'
#include <iostream>
#include <string>
#include <vector>
#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/priority_queue.hpp>
struct Base { virtual ~Base() {} };
struct Derived : Base { int value; Derived() : value(42) {} };
int main() {
    Base *base = new Derived;
    Derived *derived = dynamic_cast<Derived *>(base);
    if (!derived || derived->value != 42) return 1;
    delete base;
    std::vector<int> values(3, 7);
    if (values[0] + values[2] != 14) return 2;
    try { throw std::string("gcc42 cxx ok"); }
    catch (const std::string& message) { std::cout << message << std::endl; return 0; }
    return 3;
}
EOF
for level in 0 2; do
    "$CXX" -O$level "$TMP.cc" -o "$TMP-cxx"
    [ "`"$TMP-cxx"`" = "gcc42 cxx ok" ]
done

cat > "$TMP.m" <<'EOF'
#import <Foundation/Foundation.h>
int main(void)
{
  NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
  NSLog(@"gcc42 objc ok");
  [pool release];
  return 0;
}
EOF
"$CC" "$TMP.m" -o "$TMP-objc" -framework Foundation
"$TMP-objc" > "$TMP.log" 2>&1
grep 'gcc42 objc ok' "$TMP.log" >/dev/null 2>&1

cat > "$TMP.mm" <<'EOF'
#import <Foundation/Foundation.h>
#include <iostream>
int main(void)
{
  NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
  std::cout << "gcc42 objcpp ok" << std::endl;
  [pool release];
  return 0;
}
EOF
"$CXX" "$TMP.mm" -o "$TMP-objcpp" -framework Foundation
[ "`"$TMP-objcpp"`" = "gcc42 objcpp ok" ]

# Exercise classic NeXT aggregate/floating returns, super and forwarding.
cat > "$TMP-return.m" <<'EOF'
#import <Foundation/Foundation.h>
typedef struct { int a, b, c; double d; } BootstrapValue;
@protocol BootstrapProtocol
- (int) protocolValue;
@end
@interface BootstrapBase : NSObject <BootstrapProtocol> { int bias; }
- (id) initWithBias:(int)value;
- (BootstrapValue) result:(int)value;
@end
@interface BootstrapBase (BootstrapCategory)
- (int) categoryValue;
@end
@implementation BootstrapBase
- (id) initWithBias:(int)value { self = [super init]; bias = value; return self; }
- (int) protocolValue { return bias; }
- (BootstrapValue) result:(int)value {
    BootstrapValue result;
    result.a = bias; result.b = value; result.c = bias + value;
    result.d = 3.25;
    return result;
}
@end
@implementation BootstrapBase (BootstrapCategory)
- (int) categoryValue { return [self protocolValue] + 10; }
@end
#include <stdio.h>
@interface BootstrapChild : BootstrapBase { int extra; }
- (id) initWithBias:(int)value;
- (BootstrapValue) result:(int)value;
@end
@implementation BootstrapChild
- (id) initWithBias:(int)value {
    self = [super initWithBias:value]; extra = 100; return self;
}
- (BootstrapValue) result:(int)value {
    BootstrapValue result;
    result = [super result:value]; result.c += extra; return result;
}
@end
#include <stdio.h>
@interface BootstrapForwarder : NSObject { BootstrapBase *target; }
- (id) initWithTarget:(BootstrapBase *)value;
- (BootstrapValue) result:(int)value;
@end
@implementation BootstrapForwarder
- (id) initWithTarget:(BootstrapBase *)value {
    self = [super init]; target = [value retain]; return self;
}
- (void) dealloc { [target release]; [super dealloc]; }
- (NSMethodSignature *) methodSignatureForSelector:(SEL)selector {
    return [target methodSignatureForSelector:selector];
}
- (void) forwardInvocation:(NSInvocation *)invocation {
    [invocation invokeWithTarget:target];
}
@end
int main(void) {
    NSAutoreleasePool *pool;
    BootstrapBase *object;
    BootstrapForwarder *proxy;
    BootstrapValue direct, forwarded;
    NSRange range;
    double number;
    int ok;
    pool = [[NSAutoreleasePool alloc] init];
    object = [[BootstrapChild alloc] initWithBias:7];
    proxy = [[BootstrapForwarder alloc] initWithTarget:object];
    direct = [object result:11];
    forwarded = [proxy result:11];
    range = [@"bootstrap" rangeOfString:@"strap"];
    number = [[NSNumber numberWithDouble:3.25] doubleValue];
    ok = direct.a == 7 && direct.b == 11 && direct.c == 118 && direct.d == 3.25
        && forwarded.a == 7 && forwarded.b == 11 && forwarded.c == 118
        && forwarded.d == 3.25 && range.location == 4 && range.length == 5
        && number == 3.25;
    [proxy release]; [object release]; [pool release];
    if (!ok) return 1;
    puts("gcc42 return ABI ok"); return 0;
}
EOF
for level in 0 2; do
    "$CC" -O$level -S "$TMP-return.m" -o "$TMP-return.s"
    # The i386 runtime has no stret/fpret entry points (aggregates return via
    # %ebx); other architectures' runtimes are checked by the link below.
    if [ "$ARCH" = i386 ] &&
       { grep 'msgSend.*_stret' "$TMP-return.s" >/dev/null 2>&1 ||
         grep 'msgSend.*_fpret' "$TMP-return.s" >/dev/null 2>&1; }; then
        echo "gcc42 emitted a Darwin-only Objective-C return messenger"
        exit 1
    fi
    "$CC" -O$level "$TMP-return.m" -framework Foundation -o "$TMP-return"
    [ "`"$TMP-return"`" = "gcc42 return ABI ok" ]
    "$CXX" -O$level -x objective-c++ "$TMP-return.m" -framework Foundation -o "$TMP-return"
    [ "`"$TMP-return"`" = "gcc42 return ABI ok" ]
done
/bin/rm -f "$TMP-return.m" "$TMP-return.s" "$TMP-return"

/bin/rm -f "$TMP.c" "$TMP.cc" "$TMP.m" "$TMP.mm" "$TMP.s" \
    "$TMP-c" "$TMP-cxx" "$TMP-objc" "$TMP-objcpp" "$TMP.log"

# PR33887 regression: optimized C++ bit-field wraparound and dispatch.
cat > "$TMP-pr33887.cc" <<'EOF'
/* { dg-do run } */

extern "C" void abort (void);
struct S { unsigned int i : 24; } x;
void __attribute__((noinline)) test1()
{
  if (--x.i != 0x00ffffff)
    abort ();
  if (x.i != 0x00ffffff)
    abort ();
}
void __attribute__((noinline)) test2()
{
  if (x.i-- != 0)
    abort ();
  if (x.i != 0x00ffffff)
    abort ();
}
void __attribute__((noinline)) test3()
{
  if (++x.i != 0)
    abort ();
  if (x.i != 0)
    abort ();
}
void __attribute__((noinline)) test4()
{
  if (x.i++ != 0x00ffffff)
    abort ();
  if (x.i != 0)
    abort ();
}
int main()
{
  x.i = 0;
  test1();
  x.i = 0;
  test2();
  x.i = 0x00ffffff;
  test3();
  x.i = 0x00ffffff;
  test4();
  return 0;
}
EOF
for level in 0 1 2 3 s; do
    "$CXX" -O$level "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
    "$CXX" -O$level -x objective-c++ "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
done
cat > "$TMP-pr33887.cc" <<'EOF'
/* { dg-do run } */

extern "C" void abort() __attribute__ ((noreturn));

struct s
{
  unsigned long long f1 : 40;
  unsigned int f2 : 24;
} sv;

int main()
{
  int f2;
  sv.f2 = (1 << 24) - 1;
  __asm__ volatile ("" : : : "memory");
  ++sv.f2;
  f2 = sv.f2;
  if (f2 != 0)
    abort();
  return 0;
}
EOF
for level in 0 1 2 3 s; do
    "$CXX" -O$level "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
    "$CXX" -O$level -x objective-c++ "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
done
cat > "$TMP-pr33887.cc" <<'EOF'
/* { dg-do run } */

extern "C" void abort (void);

struct s
{
  unsigned long long f1 : 40;
  unsigned int f2 : 24;
};

s sv;

void __attribute__((noinline)) foo(unsigned int i)
{
  unsigned int tmp;
  sv.f2 = i;
  tmp = sv.f2;
  if (tmp != 0)
    abort ();
}

int main()
{
  foo (0xff000000u);
  return 0;
}
EOF
for level in 0 1 2 3 s; do
    "$CXX" -O$level "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
    "$CXX" -O$level -x objective-c++ "$TMP-pr33887.cc" -o "$TMP-pr33887"
    "$TMP-pr33887"
done
/bin/rm -f "$TMP-pr33887.cc" "$TMP-pr33887"
# DOSBox descriptor switch with its production -fwrapv flag.
cat > "$TMP-bitfield.cc" <<'EOF'
/* Standalone compiler diagnostic, intentionally fails on Apple GCC 4.2.1
 * build 5666.3. Compile with -fwrapv and -O0, -O1 or -O2, matching
 * the OPENSTEP port's arithmetic flags, to check a toolchain fix.
 * Unlike descriptor_test.cpp, this does not include the DOSBox workaround. */
#include <stdio.h>
struct Descriptor {
    unsigned padding : 8;
    unsigned type : 5;
    unsigned Type() const { return type; }
};
static int __attribute__((noinline)) dispatch(const Descriptor &d) {
    switch (d.Type()) {
    case 4: case 5: case 12: return 1;
    case 9: return 2;
    case 24: case 25: case 26: case 27: return 3;
    case 28: case 29: case 30: case 31: return 4;
    default: return 0;
    }
}
int main() {
    int failures = 0;
    for (unsigned i=0; i<32; ++i) {
        Descriptor d = {0, i};
        int expected = i>=28 ? 4 : i>=24 ? 3 : i==9 ? 2 :
                       i==4 || i==5 || i==12 ? 1 : 0;
        int actual=dispatch(d);
        if(actual!=expected) {
            printf("type=%u actual=%d expected=%d\n",i,actual,expected);
            ++failures;
        }
    }
    printf("failures=%d\n",failures);
    return failures ? 1 : 0;
}
EOF
for language in c++ objective-c++; do
    for level in 0 1 2 3 s; do
        "$CXX" -x "$language" -O$level -fwrapv "$TMP-bitfield.cc" -o "$TMP-bitfield"
        "$TMP-bitfield"
    done
done
/bin/rm -f "$TMP-bitfield.cc" "$TMP-bitfield"
echo "gcc42 package regressions passed"
