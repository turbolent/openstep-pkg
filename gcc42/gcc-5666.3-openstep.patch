+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GNU CC; see the file COPYING.  If not, write to
+the Free Software Foundation, 59 Temple Place - Suite 330,
+Boston, MA 02111-1307, USA.  */
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tm.h"
+#include "flags.h"
+#include "tree.h"
+#include "rtl.h"
+#include "toplev.h"
+#include "output.h"
+#include "tm_p.h"
+#include "langhooks.h"
+#include "target.h"
+
+/* Make everything that used to go in the text section really go there.  */
+
+int flag_no_mach_text_sections = 0;
+
+enum nextstep_section
+{
+  NEXTSTEP_CONST,
+  NEXTSTEP_CSTRING,
+  NEXTSTEP_LITERAL4,
+  NEXTSTEP_LITERAL8,
+  NEXTSTEP_CONSTRUCTOR,
+  NEXTSTEP_DESTRUCTOR,
+  NEXTSTEP_EXCEPTION,
+  NEXTSTEP_EH_FRAME,
+  NEXTSTEP_OBJC_CLASS,
+  NEXTSTEP_OBJC_META_CLASS,
+  NEXTSTEP_OBJC_CATEGORY,
+  NEXTSTEP_OBJC_CLASS_VARS,
+  NEXTSTEP_OBJC_INSTANCE_VARS,
+  NEXTSTEP_OBJC_CLS_METH,
+  NEXTSTEP_OBJC_INST_METH,
+  NEXTSTEP_OBJC_CAT_CLS_METH,
+  NEXTSTEP_OBJC_CAT_INST_METH,
+  NEXTSTEP_OBJC_SELECTOR_REFS,
+  NEXTSTEP_OBJC_SYMBOLS,
+  NEXTSTEP_OBJC_MODULE_INFO,
+  NEXTSTEP_OBJC_PROTOCOL,
+  NEXTSTEP_OBJC_STRING_OBJECT,
+  NEXTSTEP_OBJC_CLASS_NAMES,
+  NEXTSTEP_OBJC_METH_VAR_NAMES,
+  NEXTSTEP_OBJC_METH_VAR_TYPES,
+  NEXTSTEP_OBJC_CLS_REFS,
+  NEXTSTEP_NUM_SECTIONS
+};
+
+static section *nextstep_sections[NEXTSTEP_NUM_SECTIONS];
+
+/* A get_unnamed_section callback used to switch to a classic NeXT
+   Objective-C section.  The old assembler expects all Objective-C
+   sections to have been mentioned before any of them is populated.  */
+
+static void
+nextstep_output_objc_section (const void *directive)
+{
+  static bool initialized;
+
+  if (!initialized)
+    {
+      static const enum nextstep_section objc_sections[] =
+	{
+	  NEXTSTEP_OBJC_CLASS,
+	  NEXTSTEP_OBJC_META_CLASS,
+	  NEXTSTEP_OBJC_CAT_CLS_METH,
+	  NEXTSTEP_OBJC_CAT_INST_METH,
+	  NEXTSTEP_OBJC_CLS_METH,
+	  NEXTSTEP_OBJC_INST_METH,
+	  NEXTSTEP_OBJC_SELECTOR_REFS,
+	  NEXTSTEP_OBJC_SYMBOLS,
+	  NEXTSTEP_OBJC_CATEGORY,
+	  NEXTSTEP_OBJC_PROTOCOL,
+	  NEXTSTEP_OBJC_CLASS_VARS,
+	  NEXTSTEP_OBJC_INSTANCE_VARS,
+	  NEXTSTEP_OBJC_MODULE_INFO,
+	  NEXTSTEP_OBJC_STRING_OBJECT,
+	  NEXTSTEP_OBJC_CLASS_NAMES,
+	  NEXTSTEP_OBJC_METH_VAR_NAMES,
+	  NEXTSTEP_OBJC_METH_VAR_TYPES,
+	  NEXTSTEP_OBJC_CLS_REFS
+	};
+      size_t i;
+
+      initialized = true;
+      for (i = 0; i < ARRAY_SIZE (objc_sections); i++)
+	switch_to_section (nextstep_sections[objc_sections[i]]);
+    }
+
+  output_section_asm_op (directive);
+}
+
+/* Implement TARGET_ASM_INIT_SECTIONS using GCC 4's section objects.  */
+
+void
+nextstep_init_sections (void)
+{
+#define NEXTSTEP_SECTION(NAME, FLAGS, DIRECTIVE) \
+  nextstep_sections[NAME] = \
+    get_unnamed_section (FLAGS, output_section_asm_op, DIRECTIVE)
+#define NEXTSTEP_OBJC_SECTION(NAME, DIRECTIVE) \
+  nextstep_sections[NAME] = \
+    get_unnamed_section (SECTION_WRITE, nextstep_output_objc_section, DIRECTIVE)
+
+  NEXTSTEP_SECTION (NEXTSTEP_CONST, 0, ".const");
+  NEXTSTEP_SECTION (NEXTSTEP_CSTRING, 0, ".cstring");
+  NEXTSTEP_SECTION (NEXTSTEP_LITERAL4, 0, ".literal4");
+  NEXTSTEP_SECTION (NEXTSTEP_LITERAL8, 0, ".literal8");
+  NEXTSTEP_SECTION (NEXTSTEP_CONSTRUCTOR, SECTION_WRITE, ".constructor");
+  NEXTSTEP_SECTION (NEXTSTEP_DESTRUCTOR, SECTION_WRITE, ".destructor");
+  NEXTSTEP_SECTION (NEXTSTEP_EXCEPTION, 0,
+		    ".section __TEXT,__gcc_except_tab,regular");
+  NEXTSTEP_SECTION (NEXTSTEP_EH_FRAME, 0,
+		    ".section __TEXT,__eh_frame,regular");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CLASS, ".objc_class");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_META_CLASS, ".objc_meta_class");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CATEGORY, ".objc_category");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CLASS_VARS, ".objc_class_vars");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_INSTANCE_VARS, ".objc_instance_vars");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CLS_METH, ".objc_cls_meth");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_INST_METH, ".objc_inst_meth");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CAT_CLS_METH, ".objc_cat_cls_meth");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CAT_INST_METH, ".objc_cat_inst_meth");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_SELECTOR_REFS, ".objc_message_refs");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_SYMBOLS, ".objc_symbols");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_MODULE_INFO, ".objc_module_info");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_PROTOCOL, ".objc_protocol");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_STRING_OBJECT, ".objc_string_object");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CLASS_NAMES, ".objc_class_names");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_METH_VAR_NAMES, ".objc_meth_var_names");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_METH_VAR_TYPES, ".objc_meth_var_types");
+  NEXTSTEP_OBJC_SECTION (NEXTSTEP_OBJC_CLS_REFS, ".objc_cls_refs");
+
+#undef NEXTSTEP_OBJC_SECTION
+#undef NEXTSTEP_SECTION
+
+  readonly_data_section = nextstep_sections[NEXTSTEP_CONST];
+  exception_section = nextstep_sections[NEXTSTEP_EXCEPTION];
+  eh_frame_section = nextstep_sections[NEXTSTEP_EH_FRAME];
+}
+
+static section *
+nextstep_objc_section_for_name (const char *name)
+{
+  if (name[0] == 'L' && !strncmp (name + 1, "_OBJC_", 6))
+    name++;
+
+  if (!strncmp (name, "_OBJC_CLASS_METHODS_", 20))
+    return nextstep_sections[NEXTSTEP_OBJC_CLS_METH];
+  if (!strncmp (name, "_OBJC_INSTANCE_METHODS_", 23))
+    return nextstep_sections[NEXTSTEP_OBJC_INST_METH];
+  if (!strncmp (name, "_OBJC_CATEGORY_CLASS_METHODS_", 29))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_CLS_METH];
+  if (!strncmp (name, "_OBJC_CATEGORY_INSTANCE_METHODS_", 32))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_INST_METH];
+  if (!strncmp (name, "_OBJC_CLASS_VARIABLES_", 22))
+    return nextstep_sections[NEXTSTEP_OBJC_CLASS_VARS];
+  if (!strncmp (name, "_OBJC_INSTANCE_VARIABLES_", 25))
+    return nextstep_sections[NEXTSTEP_OBJC_INSTANCE_VARS];
+  if (!strncmp (name, "_OBJC_CLASS_PROTOCOLS_", 22))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_CLS_METH];
+  if (!strncmp (name, "_OBJC_CLASS_NAME_", 17))
+    return nextstep_sections[NEXTSTEP_OBJC_CLASS_NAMES];
+  if (!strncmp (name, "_OBJC_METH_VAR_NAME_", 20))
+    return nextstep_sections[NEXTSTEP_OBJC_METH_VAR_NAMES];
+  if (!strncmp (name, "_OBJC_METH_VAR_TYPE_", 20))
+    return nextstep_sections[NEXTSTEP_OBJC_METH_VAR_TYPES];
+  if (!strncmp (name, "_OBJC_CLASS_REFERENCES", 22))
+    return nextstep_sections[NEXTSTEP_OBJC_CLS_REFS];
+  if (!strncmp (name, "_OBJC_CLASS_", 12))
+    return nextstep_sections[NEXTSTEP_OBJC_CLASS];
+  if (!strncmp (name, "_OBJC_METACLASS_", 16))
+    return nextstep_sections[NEXTSTEP_OBJC_META_CLASS];
+  if (!strncmp (name, "_OBJC_CATEGORY_", 15))
+    return nextstep_sections[NEXTSTEP_OBJC_CATEGORY];
+  if (!strncmp (name, "_OBJC_SELECTOR_REFERENCES", 25))
+    return nextstep_sections[NEXTSTEP_OBJC_SELECTOR_REFS];
+  if (!strncmp (name, "_OBJC_SYMBOLS", 13))
+    return nextstep_sections[NEXTSTEP_OBJC_SYMBOLS];
+  if (!strncmp (name, "_OBJC_MODULES", 13))
+    return nextstep_sections[NEXTSTEP_OBJC_MODULE_INFO];
+  if (!strncmp (name, "_OBJC_PROTOCOL_INSTANCE_METHODS_", 32))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_INST_METH];
+  if (!strncmp (name, "_OBJC_PROTOCOL_CLASS_METHODS_", 29))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_CLS_METH];
+  if (!strncmp (name, "_OBJC_PROTOCOL_REFS_", 20))
+    return nextstep_sections[NEXTSTEP_OBJC_CAT_CLS_METH];
+  if (!strncmp (name, "_OBJC_PROTOCOL_", 15))
+    return nextstep_sections[NEXTSTEP_OBJC_PROTOCOL];
+
+  return NULL;
+}
+
+section *
+nextstep_select_section (exp, reloc, align)
+     tree exp;
+     int reloc;
+     unsigned HOST_WIDE_INT align ATTRIBUTE_UNUSED;
+{
+  section *base_section;
+
+  if (TREE_CODE (exp) == STRING_CST)
+    {
+      if (flag_writable_strings)
+	return data_section;
+      if (TREE_STRING_LENGTH (exp)
+	  != (HOST_WIDE_INT) strlen (TREE_STRING_POINTER (exp)) + 1)
+	return readonly_data_section;
+      return flag_no_mach_text_sections
+	? text_section : nextstep_sections[NEXTSTEP_CSTRING];
+    }
+
+  if (TREE_CODE (exp) == INTEGER_CST || TREE_CODE (exp) == REAL_CST)
+    {
+      tree size = TYPE_SIZE_UNIT (TREE_TYPE (exp));
+      if (!flag_no_mach_text_sections
+	  && TREE_CODE (size) == INTEGER_CST
+	  && TREE_INT_CST_HIGH (size) == 0)
+	{
+	  if (TREE_INT_CST_LOW (size) == 4)
+	    return nextstep_sections[NEXTSTEP_LITERAL4];
+	  if (TREE_INT_CST_LOW (size) == 8)
+	    return nextstep_sections[NEXTSTEP_LITERAL8];
+	}
+      return readonly_data_section;
+    }
+
+  if (TREE_CODE (exp) == CONSTRUCTOR && TREE_TYPE (exp)
+      && TREE_CODE (TREE_TYPE (exp)) == RECORD_TYPE
+      && TYPE_NAME (TREE_TYPE (exp)))
+    {
+      tree name = TYPE_NAME (TREE_TYPE (exp));
+      if (TREE_CODE (name) == TYPE_DECL)
+	name = DECL_NAME (name);
+      if (name && TREE_CODE (name) == IDENTIFIER_NODE
+	  && (!strcmp (IDENTIFIER_POINTER (name), "NXConstantString")
+	      || !strcmp (IDENTIFIER_POINTER (name), "__builtin_ObjCString")))
+	return nextstep_sections[NEXTSTEP_OBJC_STRING_OBJECT];
+    }
+
+  if (TREE_CODE (exp) == VAR_DECL && DECL_NAME (exp)
+      && TREE_CODE (DECL_NAME (exp)) == IDENTIFIER_NODE)
+    {
+      const char *name = IDENTIFIER_POINTER (DECL_NAME (exp));
+      if (!strncmp (name, "_OBJC_", 6)
+	  || !strncmp (name, "L_OBJC_", 7))
+	{
+	  section *objc_section = nextstep_objc_section_for_name (name);
+	  if (objc_section)
+	    return objc_section;
+	}
+    }
+
+  base_section = default_select_section (exp, reloc, align);
+  if (flag_no_mach_text_sections && base_section == readonly_data_section)
+    return text_section;
+  return base_section;
+}
+
+section *
+nextstep_select_rtx_section (mode, x, align)
+     enum machine_mode mode;
+     rtx x ATTRIBUTE_UNUSED;
+     unsigned HOST_WIDE_INT align ATTRIBUTE_UNUSED;
+{
+  if (!flag_no_mach_text_sections && GET_MODE_SIZE (mode) == 8)
+    return nextstep_sections[NEXTSTEP_LITERAL8];
+  if (!flag_no_mach_text_sections && GET_MODE_SIZE (mode) == 4)
+    return nextstep_sections[NEXTSTEP_LITERAL4];
+  return readonly_data_section;
+}
+
+void
+nextstep_file_start (void)
+{
+}
+
+void
+nextstep_file_end (void)
+{
+  ix86_file_end ();
+  if (strcmp (lang_hooks.name, "GNU C++") == 0)
+    {
+      switch_to_section (nextstep_sections[NEXTSTEP_CONSTRUCTOR]);
+      switch_to_section (nextstep_sections[NEXTSTEP_DESTRUCTOR]);
+      assemble_align (BITS_PER_UNIT * 2);
+    }
+}
+
+void
+nextstep_asm_out_constructor (symbol, priority)
+     rtx symbol;
+     int priority ATTRIBUTE_UNUSED;
+{
+  switch_to_section (nextstep_sections[NEXTSTEP_CONSTRUCTOR]);
+  assemble_align (POINTER_SIZE);
+  assemble_integer (symbol, POINTER_SIZE / BITS_PER_UNIT, POINTER_SIZE, 1);
+  fprintf (asm_out_file, ".reference .constructors_used\n");
+}
+
+void
+nextstep_asm_out_destructor (symbol, priority)
+     rtx symbol;
+     int priority ATTRIBUTE_UNUSED;
+{
+  switch_to_section (nextstep_sections[NEXTSTEP_DESTRUCTOR]);
+  assemble_align (POINTER_SIZE);
+  assemble_integer (symbol, POINTER_SIZE / BITS_PER_UNIT, POINTER_SIZE, 1);
+  fprintf (asm_out_file, ".reference .destructors_used\n");
+}
