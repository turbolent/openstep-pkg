+// vector copy construction of zero-sized vector should not allocate
+
+#include <vector>
+#include <new>
+
+void* operator new(std::size_t size) throw(std::bad_alloc)
+{
+    throw std::bad_alloc();
+    void* p = 0;
+    return p;
+}
+
+int main() {
+  std::vector<int> X;
+  std::vector<int> Y(X);
+}
