+/* Minimal NeXT Mach-O crtbegin/crtend placeholders.
+
+   OPENSTEP's compiler and assembler do not support the ELF-style section
+   attributes used by GCC 3.3's generic crtstuff.c.  Constructors and
+   destructors for this target are emitted through the NeXT target hooks, so
+   the startup files only need to provide real object files for the driver
+   specs to link.  */
+
+#ifdef CRT_BEGIN
+void
+__gcc_next_crtbegin (void)
+{
+}
+#endif
+
+#ifdef CRT_END
+void
+__gcc_next_crtend (void)
+{
+}
+#endif
