#!/bin/sh
set -e
PREFIX="$LOCAL_ROOT"
PATH="$PREFIX/bin:/usr/local/bin:/usr/ucb:/bin:/usr/bin"
export PATH
WORK=/tmp/pkg-lha.$$
mkdir "$WORK"
trap 'rm -rf "$WORK"' 0 1 2 3 15
cd "$WORK"

[ -x "$PREFIX/bin/lha" ]

mkdir tree tree/sub
i=0
: > tree/text.txt
while [ $i -lt 200 ]; do
    printf 'OPENSTEP lha test line %d, repeated text compresses well\n' "$i" >> tree/text.txt
    i=`expr $i + 1`
done
printf 'small\n' > "tree/sub/second.txt"
cp /bin/ls tree/binary

# Create, list, test, extract and compare.
lha a archive.lzh tree > /dev/null
[ -f archive.lzh ]
lha l archive.lzh | grep 'text.txt' > /dev/null
lha l archive.lzh | grep 'second.txt' > /dev/null
lha t archive.lzh > /dev/null
mkdir out
cd out
lha x ../archive.lzh > /dev/null
cd ..
cmp tree/text.txt out/tree/text.txt
cmp tree/sub/second.txt out/tree/sub/second.txt
cmp tree/binary out/tree/binary

# Print one member to stdout, and add a file to an existing archive.
lha pq archive.lzh tree/sub/second.txt 2>/dev/null | cmp - tree/sub/second.txt
printf 'later\n' > later.txt
lha a archive.lzh later.txt > /dev/null
lha l archive.lzh | grep 'later.txt' > /dev/null

# Other compression methods (lh5 is the default; lh1 and lh7 exercise others).
lha ao5 methods5.lzh tree/text.txt > /dev/null
lha ao7 methods7.lzh tree/text.txt > /dev/null
mkdir m5 m7
(cd m5; lha x ../methods5.lzh > /dev/null)
(cd m7; lha x ../methods7.lzh > /dev/null)
cmp tree/text.txt m5/tree/text.txt
cmp tree/text.txt m7/tree/text.txt
