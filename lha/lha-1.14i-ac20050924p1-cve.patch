 /* ------------------------------------------------------------------------ */
+/* Move the archive stream to the next header.  POS is the stream position
+   before the member data (or -1 when the stream is not seekable), OFF is
+   the packed size and READ_SIZE the number of bytes already consumed. */
+static int
+skip_to_nextpos(fp, pos, off, read_size)
+    FILE           *fp;
+    off_t           pos;
+    off_t           off;
+    off_t           read_size;
+{
+    if (pos != -1) {
+        if (fseeko(fp, pos + off, SEEK_SET) != 0) {
+            return -1;
+        }
+    }
+    else {
+        off_t i = off - read_size;
+        while (i-- > 0) {
+            if (fgetc(fp) == EOF) {
+                return -1;
+            }
+        }
+    }
+    return 0;
+}
