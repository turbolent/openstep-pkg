 /* ------------------------------------------------------------------------ */
+/* Build the output path NAME from EXTRACT_DIRECTORY and the member path Q,
+   refusing to go through a symbolic link that already exists in any leading
+   directory component (symlink traversal).  Returns FALSE if refused or if
+   the name does not fit. */
+static boolean
+make_name_with_pathcheck(name, namesz, dir, q)
+    char           *name;
+    size_t          namesz;
+    char           *dir;
+    char           *q;
+{
+    int             offset = 0;
+    char           *p;
+    int             sz;
+    struct stat     stbuf;
+
+    if (dir) {
+        sz = xsnprintf(name, namesz, "%s/", dir);
+        if (sz == -1) {
+            return FALSE;
+        }
+        offset += sz;
+    }
+
+    while ((p = strchr(q, '/')) != NULL) {
+        if (namesz - offset < (p - q) + 2) {
+            return FALSE;
+        }
+        memcpy(name + offset, q, (p - q));
+        name[offset + (p - q)] = 0;
+
+        offset += (p - q);
+        q = p + 1;
+
+        if (GETSTAT(name, &stbuf) < 0) {
+            name[offset++] = '/';
+            break;
+        }
+        if (is_symlink(&stbuf)) {
+            return FALSE;
+        }
+        name[offset++] = '/';
+    }
+
+    str_safe_copy(name + offset, q, namesz - offset);
+
+    return TRUE;
+}
+
