#!/bin/sh
set -e
exec < /dev/null
PATH=$LOCAL_ROOT/bin:/usr/ucb:/bin:/usr/bin:$PATH
export PATH
TMP=/usr/tmp/ffmpeg-test.$$
/bin/mkdir "$TMP"
trap '/bin/rm -f "$TMP"/*; /bin/rmdir "$TMP"' 0
trap 'exit 1' 1 2 15
cat > "$TMP/test.c" <<'EOF'
#include <libavcodec/avcodec.h>
#include <libavformat/avformat.h>
#include <libswscale/swscale.h>
#include <libpostproc/postprocess.h>
#include <assert.h>
#include <stdio.h>
int main(int argc, char **argv)
{
    FILE *f;
    int frame, x, y, i;
    assert(argc == 3);
    assert(sizeof(uint64_t) == 8 && sizeof(uint32_t) == 4);
    assert(AVERROR_NOTSUPP == -87 && AVERROR_NOFMT != AVERROR_INVALIDDATA);
    assert(avutil_version() == LIBAVUTIL_VERSION_INT);
    assert(avcodec_version() == LIBAVCODEC_VERSION_INT);
    assert(avformat_version() == LIBAVFORMAT_VERSION_INT);
    assert(swscale_version() == LIBSWSCALE_VERSION_INT);
    assert(av_rescale(3, 1000, 2) == 1500);
    {
        pp_context_t *ctx = pp_get_context(64, 48, 0);
        pp_mode_t *mode = pp_get_mode_by_name_and_quality("de", 3);
        assert(ctx && mode);
        pp_free_mode(mode); pp_free_context(ctx);
    }
    f = fopen(argv[1], "wb"); assert(f);
    for (frame = 0; frame < 5; ++frame) {
        for (y = 0; y < 48; ++y)
            for (x = 0; x < 64; ++x) fputc((x*3+y*5+frame*7)%256, f);
        for (i = 0; i < 768; ++i) fputc(128+frame*5, f);
        for (y = 0; y < 24; ++y)
            for (x = 0; x < 32; ++x) fputc(64+x+y, f);
    }
    assert(!ferror(f)); assert(fclose(f) == 0);
    f = fopen(argv[2], "wb"); assert(f);
    for (i = 0; i < 4410; ++i) {
        unsigned left = (unsigned)(i*31%20000-10000) & 65535;
        unsigned right = (unsigned)(10000-i*29%20000) & 65535;
        fputc(left & 255, f); fputc(left >> 8, f);
        fputc(right & 255, f); fputc(right >> 8, f);
    }
    assert(!ferror(f)); assert(fclose(f) == 0);
    return 0;
}
EOF
/usr/local/bin/gcc-4.2 -O2 $PKG_GCC42_ARCH_FLAGS -DNeXT \
    `pkg-config --cflags libavformat libswscale libpostproc` "$TMP/test.c" \
    `pkg-config --libs libavformat libswscale libpostproc` -o "$TMP/test"
"$TMP/test" "$TMP/input.yuv" "$TMP/input.pcm"
convert()
{
    "$LOCAL_ROOT/bin/ffmpeg" "$@" > "$TMP/run.log" 2>&1 || {
        cat "$TMP/run.log"
        exit 1
    }
}
convert -y -f rawvideo -pix_fmt yuv420p -s 64x48 -r 25 -i "$TMP/input.yuv" \
    -vcodec ffv1 -an "$TMP/video.avi"
convert -y -i "$TMP/video.avi" -an -vcodec rawvideo -pix_fmt yuv420p \
    -f rawvideo "$TMP/output.yuv"
cmp "$TMP/input.yuv" "$TMP/output.yuv"
convert -y -f s16le -ar 44100 -ac 2 -i "$TMP/input.pcm" \
    -acodec pcm_s16le "$TMP/audio.wav"
convert -y -i "$TMP/audio.wav" -acodec pcm_s16le -f s16le "$TMP/output.pcm"
cmp "$TMP/input.pcm" "$TMP/output.pcm"
echo 'FFmpeg installed headers, libraries, FFV1, and PCM tests passed'
