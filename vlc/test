#!/bin/sh
set -e
exec < /dev/null
PATH=$LOCAL_ROOT/bin:/usr/ucb:/bin:/usr/bin:$PATH
export PATH
TMP=/usr/tmp/vlc-test.$$
/bin/mkdir "$TMP"
trap '/bin/rm -f "$TMP"/*; /bin/rmdir "$TMP"' 0
trap 'exit 1' 1 2 15
cd "$TMP"
cat > fixture.c <<'EOF'
#include <assert.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
int main(int argc, char **argv)
{
    FILE *f, *reference;
    int n, x, y, c;
    long bytes = 0;
    if (argc > 2 && !strcmp(argv[1], "run")) {
        /* Bound each player check even if a native wait regresses. */
        alarm(30);
        execv(argv[2], argv + 2);
        perror("execv"); return 1;
    }
    if (argc == 2) {
        f = fopen("output.yuv", "rb"); assert(f);
        reference = fopen("input.yuv", "rb"); assert(reference);
        while ((c = fgetc(f)) != EOF) {
            assert(c == fgetc(reference)); ++bytes;
        }
        assert(!ferror(f));
        /* VLC 0.9's AVI/FFV1 path can retain the final delayed frame. */
        assert(bytes == 16 * 4608 || bytes == 17 * 4608);
        fclose(f); fclose(reference); return 0;
    }
    f = fopen("input.yuv", "wb"); assert(f);
    for (n = 0; n < 17; ++n) {
        for (y = 0; y < 48; ++y)
            for (x = 0; x < 64; ++x) fputc((x*3+y*5+n*7)%256, f);
        for (x = 0; x < 768; ++x) fputc(128+n*3, f);
        for (y = 0; y < 24; ++y)
            for (x = 0; x < 32; ++x) fputc(64+x+y, f);
    }
    assert(!ferror(f)); assert(fclose(f) == 0);
    f = fopen("input.pcm", "wb"); assert(f);
    for (n = 0; n < 4096; ++n) {
        unsigned left = (unsigned)(n*31%20000-10000) & 65535;
        unsigned right = (unsigned)(10000-n*29%20000) & 65535;
        fputc(left & 255, f); fputc(left >> 8, f);
        fputc(right & 255, f); fputc(right >> 8, f);
    }
    assert(!ferror(f)); assert(fclose(f) == 0);
    return 0;
}
EOF
/usr/local/bin/gcc-4.2 -O2 -fno-builtin-memset ${PKG_GCC42_ARCH_FLAGS-} fixture.c -o fixture
./fixture
convert()
{
    ffmpeg "$@" > ffmpeg.log 2>&1 || { cat ffmpeg.log; exit 1; }
}
player()
{
    ./fixture run "$LOCAL_ROOT/bin/vlc" --ignore-config --no-color -I dummy "$@" \
        > vlc.log 2>&1 || { cat vlc.log; exit 1; }
}
player -MachLaunch '1 30' -NXAutoLaunch YES --version
grep 'VLC version 0.9.10' vlc.log
player --list
if grep -i '^  .*sdl' vlc.log; then
    echo 'Unexpected SDL module in the OPENSTEP build'; exit 1
fi
for module in openstep avcodec avformat mpgatofixed32 a52 libmpeg2 lua
do
    grep "$module" vlc.log > /dev/null
done
convert -y -f rawvideo -pix_fmt yuv420p -s 64x48 -r 10 -i input.yuv \
    -vcodec ffv1 -an video.avi
player --no-audio --sout "#transcode{vcodec=I420}:std{access=file,mux=raw,dst=$TMP/output.yuv}" \
    video.avi vlc://quit
./fixture check
convert -y -f s16le -ar 44100 -ac 2 -i input.pcm -acodec pcm_s16le audio.wav
player --no-video --aout file --audiofile-format=s16 --audiofile-channels=2 \
    --no-audiofile-wav --audiofile-file="$TMP/output.pcm" audio.wav vlc://quit
cmp input.pcm output.pcm
player --no-audio --no-osd --no-video-title-show --vout image --image-out-ratio=1 \
    --image-out-prefix="$TMP/frame" video.avi vlc://quit
test -s frame000000.png
convert -y -i video.avi -vframes 1 -pix_fmt rgb24 -f rawvideo reference.rgb
convert -y -i frame000000.png -vframes 1 -pix_fmt rgb24 -f rawvideo output.rgb
cmp reference.rgb output.rgb
test -x "$LOCAL_ROOT/Apps/VLC.app/VLC"
echo 'VLC module registration, FFV1 decoding, PCM output, PNG encoding and launch-argument checks passed'
