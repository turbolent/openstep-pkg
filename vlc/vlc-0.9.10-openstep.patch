+/* Included only in the separate GUI regression executable. */
+#undef NDEBUG
+#include <assert.h>
+- (void)checkPlayback:(id)sender
+{
+    static mtime_t deadline, length, sought;
+    static unsigned phase, saved_completed, saved_presented;
+    static int has_audio;
+    input_thread_t *input;
+    mtime_t now = mdate(), time;
+    vlc_value_t value, saved_length;
+    if (!deadline) { deadline = now + 3000000; return; }
+    if (now < deadline) return;
+    input = playlist_CurrentInput(playlist);
+    if (phase == 5) {
+        assert(!input);
+        [self updatePosition];
+        assert(![position isEnabled] && [position doubleValue] == 0);
+        assert([[elapsed stringValue] isEqual:@"00:00"]);
+        assert([[remaining stringValue] isEqual:@"--:--"]);
+        [self play:nil]; ++phase; deadline = now + 2000000; return;
+    }
+    if (phase == 6) {
+        assert(input && var_GetInteger(input, "state") == PLAYING_S);
+        vlc_object_release(input);
+        fprintf(stderr, "SEEK PASS playing, paused, resume, stop, restart and time displays\n");
+        [self play:nil];
+        [sender invalidate]; [self quit:nil]; return;
+    }
+    assert(input);
+    time = var_GetTime(input, "time");
+    if (phase < 4) {
+        const int sizes[][2] = {{720,480}, {320,240}, {360,560}, {900,400}};
+        NSRect picture, track, label;
+        double aspect = (double)width / height;
+        assert([window styleMask] & NSResizableWindowMask);
+        [window setContentSize:NSMakeSize(sizes[phase][0], sizes[phase][1])];
+        [window displayIfNeeded];
+        picture = [view frame]; track = [position frame]; label = [remaining frame];
+        assert(NSMaxX(track) <= NSMinX(label));
+        assert(NSMaxX(label) <= [[window contentView] bounds].size.width);
+        assert(NSMinY(picture) >= 76 && NSMaxY(picture) <= sizes[phase][1]);
+        assert(picture.size.width > 0 && picture.size.height > 0);
+        assert(picture.size.width / picture.size.height > aspect - 0.02 &&
+               picture.size.width / picture.size.height < aspect + 0.02);
+    }
+    if (phase == 0) {
+        length = var_GetTime(input, "length");
+        assert(length >= 20000000 && time > 0 && [position isEnabled]);
+        assert(![[elapsed stringValue] isEqual:@"00:00"]);
+        assert([[remaining stringValue] hasPrefix:@"-"]);
+        var_Change(input, "audio-es", VLC_VAR_CHOICESCOUNT, &value, NULL);
+        has_audio = value.i_int > 1;
+        /* Unknown duration and non-seekable inputs must remain usable. */
+        var_Get(input, "length", &saved_length);
+        value.i_time = 0;
+        var_Change(input, "length", VLC_VAR_SETVALUE, &value, NULL);
+        value.b_bool = false;
+        var_Change(input, "seekable", VLC_VAR_SETVALUE, &value, NULL);
+        [self updatePosition];
+        assert(![position isEnabled]);
+        assert([[remaining stringValue] isEqual:@"--:--"]);
+        var_Change(input, "length", VLC_VAR_SETVALUE, &saved_length, NULL);
+        value.b_bool = true;
+        var_Change(input, "seekable", VLC_VAR_SETVALUE, &value, NULL);
+        /* A playback timer must not move the knob during AppKit tracking. */
+        position->tracking = YES;
+        [position setDoubleValue:0.75]; [self updatePosition];
+        assert([position doubleValue] == 0.75);
+        assert(var_GetTime(input, "time") < length / 2);
+        position->tracking = NO;
+        [position sendAction:[position action] to:[position target]];
+        saved_completed = completed; saved_presented = presented;
+    } else if (phase == 1) {
+        assert(time > length * 0.65 && time < length * 0.95);
+        assert(presented != saved_presented && (!has_audio || completed > saved_completed));
+        [self play:nil];
+    } else if (phase == 2) {
+        assert(var_GetInteger(input, "state") == PAUSE_S);
+        [position setDoubleValue:0.25];
+        [position sendAction:[position action] to:[position target]];
+        assert(vlc_playback_paused());
+        assert(var_GetTime(input, "time") > length * 0.24);
+        assert(var_GetTime(input, "time") < length * 0.26);
+    } else if (phase == 3) {
+        assert(var_GetInteger(input, "state") == PAUSE_S && vlc_playback_paused());
+        assert(time > length * 0.15 && time < length * 0.35);
+        sought = time;
+        saved_completed = completed; saved_presented = presented;
+        [self play:nil];
+    } else if (phase == 4) {
+        assert(var_GetInteger(input, "state") == PLAYING_S && !vlc_playback_paused());
+        assert(time > sought && time < length / 2);
+        assert(presented != saved_presented && (!has_audio || completed > saved_completed));
+        [self stop:nil];
+    }
+    fprintf(stderr, "SEEK phase=%u elapsed=%s remaining=%s position=%.3f\n",
+            phase, [[elapsed stringValue] cString], [[remaining stringValue] cString],
+            [position doubleValue]);
+    fflush(stderr);
+    vlc_object_release(input);
+    ++phase;
+    deadline = now + (phase == 2 ? 3000000 : phase == 5 ? 1000000 : 2000000);
+}
