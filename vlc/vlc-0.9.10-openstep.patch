+
+static int openstep_mutex_init(vlc_mutex_t *mutex, bool recursive)
+{
+    *mutex = calloc(1, sizeof(**mutex));
+    if (!*mutex) return ENOMEM;
+    mutex_init(&(*mutex)->guard);
+    condition_init(&(*mutex)->available);
+    (*mutex)->recursive = recursive;
+    return 0;
+}
+static void openstep_mutex_destroy(vlc_mutex_t *mutex)
+{
+    assert(!(*mutex)->depth);
+    condition_clear(&(*mutex)->available);
+    mutex_clear(&(*mutex)->guard);
+    free(*mutex); *mutex = NULL;
+}
+void vlc_openstep_mutex_lock(vlc_mutex_t *mutex)
+{
+    vlc_mutex_t m = *mutex;
+    cthread_t self = cthread_self();
+    mutex_lock(&m->guard);
+    if (m->owner == self && !m->recursive) abort();
+    while (m->owner && m->owner != self) condition_wait(&m->available, &m->guard);
+    m->owner = self;
+    if (++m->depth == 0) abort();
+    mutex_unlock(&m->guard);
+}
+void vlc_openstep_mutex_unlock(vlc_mutex_t *mutex)
+{
+    vlc_mutex_t m = *mutex;
+    mutex_lock(&m->guard);
+    if (!m->depth || m->owner != cthread_self()) abort();
+    if (!--m->depth) { m->owner = NULL; condition_signal(&m->available); }
+    mutex_unlock(&m->guard);
+}
+static int openstep_cond_init(vlc_cond_t *cond)
+{
+    *cond = calloc(1, sizeof(**cond));
+    if (!*cond) return ENOMEM;
+    mutex_init(&(*cond)->guard);
+    return 0;
+}
+static void openstep_cond_destroy(vlc_cond_t *cond)
+{
+    assert(!(*cond)->waiters);
+    mutex_clear(&(*cond)->guard);
+    free(*cond); *cond = NULL;
+}
+void vlc_openstep_cond_signal(vlc_cond_t *cond)
+{
+    struct openstep_waiter *w;
+    msg_header_t message;
+    mutex_lock(&(*cond)->guard);
+    for (w = (*cond)->waiters; w && w->signaled; w = w->next) {}
+    if (w) {
+        memset(&message, 0, sizeof(message));
+        message.msg_simple = TRUE;
+        message.msg_size = sizeof(message);
+        message.msg_type = MSG_TYPE_NORMAL;
+        message.msg_remote_port = w->port;
+        w->signaled = true;
+        if (msg_send(&message, SEND_TIMEOUT, 0) != SEND_SUCCESS) abort();
+    }
+    mutex_unlock(&(*cond)->guard);
+}
+int vlc_openstep_cond_wait(vlc_cond_t *cond, vlc_mutex_t *mutex, mtime_t deadline)
+{
+    struct openstep_waiter waiter, **link;
+    msg_header_t message;
+    msg_return_t result;
+    int status;
+    /* cthreads has no timed condition wait. A private receive port preserves
+     * signals arriving between the atomic unlock and the Mach receive. */
+    if (port_allocate(task_self(), &waiter.port) != KERN_SUCCESS) abort();
+    waiter.signaled = false;
+    mutex_lock(&(*cond)->guard);
+    waiter.next = (*cond)->waiters; (*cond)->waiters = &waiter;
+    if ((*mutex)->depth != 1) abort();
+    vlc_openstep_mutex_unlock(mutex);
+    mutex_unlock(&(*cond)->guard);
+    do {
+        mtime_t delay = deadline ? deadline - mdate() : 0;
+        msg_timeout_t ms = delay <= 0 ? 0 : delay / 1000 >= INT_MAX ?
+            INT_MAX : (msg_timeout_t)((delay + 999) / 1000);
+        memset(&message, 0, sizeof(message));
+        message.msg_size = sizeof(message);
+        message.msg_local_port = waiter.port;
+        result = msg_receive(&message, deadline ? RCV_TIMEOUT : MSG_OPTION_NONE, ms);
+    } while (result == RCV_INTERRUPTED ||
+             (result == RCV_TIMED_OUT && deadline > mdate()));
+    if (result != RCV_SUCCESS && result != RCV_TIMED_OUT) abort();
+    mutex_lock(&(*cond)->guard);
+    /* Resolve a signal racing the timeout before destroying its receive port. */
+    status = waiter.signaled ? 0 : ETIMEDOUT;
+    for (link = &(*cond)->waiters; *link != &waiter; link = &(*link)->next) {}
+    *link = waiter.next;
+    if (port_deallocate(task_self(), waiter.port) != KERN_SUCCESS) abort();
+    mutex_unlock(&(*cond)->guard);
+    vlc_openstep_mutex_lock(mutex);
+    return status;
+}
+
+struct vlc_openstep_value {
+    cthread_t thread;
+    void *value;
+    void (*destroy)(void *);
+    struct vlc_openstep_value *next;
+};
+struct vlc_openstep_key {
+    void (*destroy)(void *);
+    struct vlc_openstep_value *values;
+    struct vlc_openstep_key *next;
+};
+static struct mutex tls_lock = MUTEX_INITIALIZER;
+static struct vlc_openstep_key *tls_keys;
+
+/* ponytail: linear lookup over VLC's few TLS keys/threads; use a per-thread
+ * table if profiling ever shows this in the playback hot path. */
+static int openstep_key_create(vlc_threadvar_t *key, void (*destroy)(void *))
+{
+    *key = calloc(1, sizeof(**key));
+    if (!*key) return ENOMEM;
+    (*key)->destroy = destroy;
+    mutex_lock(&tls_lock);
+    (*key)->next = tls_keys;
+    tls_keys = *key;
+    mutex_unlock(&tls_lock);
+    return 0;
+}
+static void openstep_key_delete(vlc_threadvar_t *key)
+{
+    struct vlc_openstep_key **p;
+    struct vlc_openstep_value *v, *next;
+    mutex_lock(&tls_lock);
+    for (p = &tls_keys; *p && *p != *key; p = &(*p)->next) {}
+    if (*p) *p = (*key)->next;
+    for (v = (*key)->values; v; v = next) { next = v->next; free(v); }
+    free(*key);
+    *key = NULL;
+    mutex_unlock(&tls_lock);
+}
+int vlc_openstep_tls_set(vlc_threadvar_t *key, void *value)
+{
+    struct vlc_openstep_value *v;
+    cthread_t self = cthread_self();
+    mutex_lock(&tls_lock);
+    for (v = (*key)->values; v && v->thread != self; v = v->next) {}
+    if (!v) {
+        v = malloc(sizeof(*v));
+        if (!v) { mutex_unlock(&tls_lock); return ENOMEM; }
+        v->thread = self;
+        v->destroy = (*key)->destroy;
+        v->next = (*key)->values;
+        (*key)->values = v;
+    }
+    v->value = value;
+    mutex_unlock(&tls_lock);
+    return 0;
+}
+void *vlc_openstep_tls_get(vlc_threadvar_t *key)
+{
+    struct vlc_openstep_value *v;
+    void *value;
+    cthread_t self = cthread_self();
+    mutex_lock(&tls_lock);
+    for (v = (*key)->values; v && v->thread != self; v = v->next) {}
+    value = v ? v->value : NULL;
+    mutex_unlock(&tls_lock);
+    return value;
+}
+static void openstep_tls_cleanup(void)
+{
+    struct vlc_openstep_key *key;
+    struct vlc_openstep_value **p, *v, *pending, *next;
+    unsigned pass;
+    cthread_t self = cthread_self();
+    /* Match POSIX's four destructor passes, then discard any reassignment. */
+    for (pass = 0; pass <= 4; ++pass) {
+        mutex_lock(&tls_lock);
+        pending = NULL;
+        for (key = tls_keys; key; key = key->next) {
+            for (p = &key->values; *p && (*p)->thread != self; p = &(*p)->next) {}
+            if (*p) {
+                v = *p;
+                *p = v->next;
+                v->next = pending;
+                pending = v;
+            }
+        }
+        mutex_unlock(&tls_lock);
+        if (!pending) break;
+        for (v = pending; v; v = next) {
+            next = v->next;
+            if (pass < 4 && v->destroy && v->value) v->destroy(v->value);
+            free(v);
+        }
+    }
+}
