+static struct mutex playback_lock = MUTEX_INITIALIZER;
+static bool playback_active, playback_paused;
+static mtime_t playback_offset, playback_pause_date;
+
+void vlc_playback_pause( bool paused )
+{
+    mutex_lock( &playback_lock );
+    playback_active = true;
+    if( paused != playback_paused )
+    {
+        const mtime_t now = mdate();
+        if( paused ) playback_pause_date = now;
+        else playback_offset += now - playback_pause_date;
+        playback_paused = paused;
+    }
+    mutex_unlock( &playback_lock );
+}
+
+bool vlc_playback_active( void )
+{
+    bool active;
+    mutex_lock( &playback_lock );
+    active = playback_active;
+    mutex_unlock( &playback_lock );
+    return active;
+}
+
+bool vlc_playback_paused( void )
+{
+    bool paused;
+    mutex_lock( &playback_lock );
+    paused = playback_paused;
+    mutex_unlock( &playback_lock );
+    return paused;
+}
+
+mtime_t vlc_playback_date( void )
+{
+    mtime_t date;
+    mutex_lock( &playback_lock );
+    date = (playback_paused ? playback_pause_date : mdate()) - playback_offset;
+    mutex_unlock( &playback_lock );
+    return date;
+}
