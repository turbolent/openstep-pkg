+        if (timeout > 0) msleep((mtime_t)timeout * 1000);
+        else if (timeout < 0) { pause(); errno = EINTR; return -1; }
+        return ready;
+    }
+    tv.tv_sec = timeout / 1000; tv.tv_usec = (timeout % 1000) * 1000;
+    result = select(highest + 1, &rd, &wr, &ex, timeout < 0 ? NULL : &tv);
+    if (result < 0) return -1;
+    for (i = 0; i < nfds; ++i) {
+        int fd = fds[i].fd;
+        if (fd < 0 || fds[i].revents == POLLNVAL) continue;
+        fds[i].revents = (FD_ISSET(fd, &rd) ? POLLIN : 0) |
+                        (FD_ISSET(fd, &wr) ? POLLOUT : 0) |
+                        (FD_ISSET(fd, &ex) ? POLLPRI : 0);
+        if (fds[i].revents) ++ready;
+    }
