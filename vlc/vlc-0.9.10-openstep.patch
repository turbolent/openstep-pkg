+/* Included only in the separate GUI regression executable. */
+#undef NDEBUG
+#include <assert.h>
+- (void)checkPlayback:(id)sender
+{
+    static mtime_t deadline, action_date, last_change, first_change;
+    static unsigned phase, cycles, saved_completed;
+    static int has_audio;
+    static unsigned char *previous;
+    static size_t bytes;
+    static input_thread_t *initial_input;
+    mtime_t now = mdate();
+    input_thread_t *input;
+    vlc_value_t choices;
+    int state, input_state;
+    unsigned n;
+    NSButton *button = nil;
+    NSArray *views;
+    if (!deadline) { deadline = now + 4000000; return; }
+    if (previous) assert(frame && bytes == width * height * 4);
+    if (previous && !dirty && memcmp(previous, frame, bytes)) {
+        memcpy(previous, frame, bytes);
+        last_change = now;
+        if (!first_change) first_change = now;
+    }
+    if (now < deadline) return;
+    vlc_object_lock(playlist);
+    state = playlist->status.i_status;
+    input = playlist->p_input;
+    input_state = input ? var_GetInteger(input, "state") : -1;
+    vlc_object_unlock(playlist);
+    if (phase == 4) {
+        assert(state == PLAYLIST_STOPPED && !input && !vlc_playback_paused());
+        saved_completed = completed;
+        first_change = 0;
+        [self play:nil]; phase = 5; deadline = now + 2000000; return;
+    }
+    if (phase == 5) {
+        assert(state == PLAYLIST_RUNNING && input && first_change);
+        assert(!has_audio || completed > saved_completed);
+        fprintf(stderr, "PLAYBACK PASS stop while paused, restart, quit while paused\n");
+        free(previous); previous = NULL;
+        [sender invalidate]; [self play:nil]; [self quit:nil]; return;
+    }
+    if (!previous) {
+        assert(input && frame && frames > 10);
+        var_Change(input, "audio-es", VLC_VAR_CHOICESCOUNT, &choices, NULL);
+        has_audio = choices.i_int > 1; /* Includes the Disable choice. */
+        assert(!has_audio || completed > 10);
+        initial_input = input;
+        bytes = width * height * 4;
+        previous = malloc(bytes);
+        assert(previous);
+        memcpy(previous, frame, bytes);
+    }
+    assert(input == initial_input && bytes == width * height * 4);
+    if (phase == 1 || phase == 2) {
+        assert(state == PLAYLIST_PAUSED && input_state == PAUSE_S && (!has_audio || paused));
+        if (phase == 1) {
+            fprintf(stderr, "LATENCY pause cycle=%u last_motion_ms=%ld\n",
+                    cycles+1, (long)((last_change-action_date)/1000));
+            assert(last_change == action_date);
+            saved_completed = completed;
+        } else {
+            assert(completed == saved_completed && last_change == action_date);
+        }
+    } else {
+        assert(state == PLAYLIST_RUNNING && input_state == PLAYING_S && (!has_audio || !paused));
+        if (phase == 3) {
+            assert(first_change && (!has_audio || completed > saved_completed));
+            fprintf(stderr, "LATENCY resume cycle=%u first_motion_ms=%ld\n",
+                    ++cycles, (long)((first_change-action_date)/1000));
+            assert(first_change - action_date < 200000);
+            if (cycles == 4) {
+                [self play:nil]; [self stop:nil];
+                phase = 4; deadline = now + 1000000; return;
+            }
+        }
+    }
+    if (phase == 0 || phase == 2) {
+        views = [[window contentView] subviews];
+        for (n = 0; n < [views count]; ++n) {
+            id candidate = [views objectAtIndex:n];
+            if ([candidate isKindOfClass:[NSButton class]] &&
+                [[candidate title] isEqual:@"Play/Pause"]) {
+                button = candidate; break;
+            }
+        }
+        assert(button);
+        [button performClick:nil];
+        action_date = last_change = mdate(); first_change = 0;
+        /* Ignore any frame already presented during the button animation. */
+        memcpy(previous, frame, bytes);
+    }
+    fflush(stderr);
+    phase = (phase + 1) % 4;
+    /* Include a long pause to expose stale decoder timestamps on resume. */
+    deadline = mdate() + (phase == 0 ? 200000 :
+                         phase == 2 && cycles == 0 ? 6000000 : 1000000);
+}
