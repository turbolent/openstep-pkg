+#include <vlc_common.h>
+#include <vlc_network.h>
+#include <sys/time.h>
+#undef NDEBUG
+#include <assert.h>
+#include <unistd.h>
+int main(void)
+{
+    int pipefd[2];
+    struct pollfd fds[3];
+    char byte;
+    mtime_t before = mdate();
+    assert(vlc_poll(NULL, 0, 50) == 0);
+    assert(mdate() - before >= 40000);
+    assert(pipe(pipefd) == 0);
+    fds[0].fd = -1; fds[0].events = POLLIN;
+    fds[1].fd = pipefd[0]; fds[1].events = POLLIN;
+    fds[2].fd = FD_SETSIZE; fds[2].events = POLLIN;
+    assert(vlc_poll(fds, 3, 5000) == 1);
+    assert(fds[0].revents == 0 && fds[1].revents == 0 && fds[2].revents == POLLNVAL);
+    assert(write(pipefd[1], "x", 1) == 1);
+    assert(vlc_poll(fds, 2, 100) == 1 && (fds[1].revents & POLLIN));
+    assert(read(pipefd[0], &byte, 1) == 1 && byte == 'x');
+    close(pipefd[0]); close(pipefd[1]);
+    assert(vlc_poll(fds, 2, 0) == 1 && fds[1].revents == POLLNVAL);
+    return 0;
+}
