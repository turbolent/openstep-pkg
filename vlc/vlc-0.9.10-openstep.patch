+#!/bin/sh
+# Run from the source root after building modules, before linking the core.
+# VLC 0.9's configure list omits modules selected by Modules.am.
+set -e
+modules=`find modules -name 'lib*_plugin.la' -print | sed 's|.*/lib||; s|_plugin.la$||' | sort -u`
+test -n "$modules"
+target=src/modules/builtin.h
+cat src/modules/builtin.h.in > "$target.tmp"
+for module in $modules; do
+    echo "int vlc_entry__$module (module_t *);" >> "$target.tmp"
+done
+echo '#define ALLOCATE_ALL_BUILTINS() do { \' >> "$target.tmp"
+for module in $modules; do
+    echo "ALLOCATE_BUILTIN($module); \\" >> "$target.tmp"
+done
+echo '} while (0);' >> "$target.tmp"
+mv "$target.tmp" "$target"
