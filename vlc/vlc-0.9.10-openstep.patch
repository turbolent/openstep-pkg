+struct vout_sys_t {
+    unsigned char *pixels;
+    int width, height;
+    unsigned serial;
+};
+/* ponytail: one native player per process; add separate bridges only if
+ * concurrent embedded players are required. No AppKit calls on VLC threads. */
+static struct mutex bridge = MUTEX_INITIALIZER;
+static condition_t readers_done;
+static int interface_reserved, gui_running, sound_rate;
+static vout_sys_t *video;
+static aout_instance_t *audio;
+static unsigned audio_readers, audio_epoch, video_serial;
+
+static int VideoInit(vout_thread_t *v)
+{
+    vout_thread_t *p_vout = v;
+    picture_t *picture = NULL;
+    int i;
+    I_OUTPUTPICTURES = 0;
+    v->output.i_chroma = VLC_FOURCC('R','V','3','2');
+    /* The core's window size includes cropping and sample aspect ratio. */
+    v->output.i_width = v->i_window_width;
+    v->output.i_height = v->i_window_height;
+    v->output.i_aspect = v->render.i_aspect;
+    v->output.i_rmask = 0xff0000;
+    v->output.i_gmask = 0x00ff00;
+    v->output.i_bmask = 0x0000ff;
+    v->output.pf_setpalette = NULL;
+    if (v->output.i_width <= 0 || v->output.i_width > 8192 ||
+        v->output.i_height <= 0 || v->output.i_height > 8192) return VLC_EGENERIC;
+    v->p_sys->width = v->output.i_width;
+    v->p_sys->height = v->output.i_height;
+    v->p_sys->pixels = malloc(v->output.i_width * v->output.i_height * 4);
+    if (!v->p_sys->pixels) return VLC_ENOMEM;
+    for (i = 0; i < VOUT_MAX_PICTURES; ++i)
+        if (v->p_picture[i].i_status == FREE_PICTURE) { picture = &v->p_picture[i]; break; }
+    if (!picture) return VLC_EGENERIC;
+    vout_AllocatePicture(VLC_OBJECT(v), picture, v->output.i_chroma,
+                        v->output.i_width, v->output.i_height, v->output.i_aspect);
+    if (!picture->i_planes) return VLC_ENOMEM;
+    picture->i_status = DESTROYED_PICTURE;
+    picture->i_type = DIRECT_PICTURE;
+    PP_OUTPUTPICTURE[0] = picture;
+    I_OUTPUTPICTURES = 1;
+    mutex_lock(&bridge);
+    if (video) {
+        mutex_unlock(&bridge);
+        free(picture->p_data_orig);
+        I_OUTPUTPICTURES = 0;
+        return VLC_EGENERIC;
+    }
+    video = v->p_sys;
+    mutex_unlock(&bridge);
+    return VLC_SUCCESS;
+}
+static void VideoDisplay(vout_thread_t *v, picture_t *picture)
+{
+    int y;
+    mutex_lock(&bridge);
+    for (y = 0; y < v->p_sys->height; ++y)
+        memcpy(v->p_sys->pixels + y * v->p_sys->width * 4,
+               picture->p[0].p_pixels + y * picture->p[0].i_pitch,
+               v->p_sys->width * 4);
+    v->p_sys->serial = ++video_serial;
+    mutex_unlock(&bridge);
+}
+static void VideoEnd(vout_thread_t *p_vout)
+{
+    int i;
+    mutex_lock(&bridge);
+    if (video == p_vout->p_sys) video = NULL;
+    mutex_unlock(&bridge);
+    for (i = 0; i < I_OUTPUTPICTURES; ++i)
+        free(PP_OUTPUTPICTURE[i]->p_data_orig);
+    I_OUTPUTPICTURES = 0;
+    free(p_vout->p_sys->pixels);
+    p_vout->p_sys->pixels = NULL;
+}
+static int OpenVideo(vlc_object_t *obj)
+{
+    vout_thread_t *v = (vout_thread_t *)obj;
+    int available;
+    mutex_lock(&bridge); available = gui_running && !video; mutex_unlock(&bridge);
+    if (!available) return VLC_EGENERIC;
+    v->p_sys = calloc(1, sizeof(*v->p_sys));
+    if (!v->p_sys) return VLC_ENOMEM;
+    v->pf_init = VideoInit;
+    v->pf_end = VideoEnd;
+    v->pf_manage = NULL;
+    v->pf_render = NULL;
+    v->pf_display = VideoDisplay;
+    return VLC_SUCCESS;
+}
+static void CloseVideo(vlc_object_t *obj)
+{
+    vout_thread_t *v = (vout_thread_t *)obj;
+    mutex_lock(&bridge);
+    if (video == v->p_sys) video = NULL;
+    mutex_unlock(&bridge);
+    free(v->p_sys->pixels);
+    free(v->p_sys);
+}
+
+static void AudioPlay(aout_instance_t *a) { (void)a; }
+static int OpenAudio(vlc_object_t *obj)
+{
+    aout_instance_t *a = (aout_instance_t *)obj;
+    mutex_lock(&bridge);
+    if (!gui_running || !sound_rate || audio) {
+        mutex_unlock(&bridge); return VLC_EGENERIC;
+    }
+    a->output.output.i_format = AOUT_FMT_S16_NE;
+    a->output.output.i_rate = sound_rate;
+    a->output.output.i_physical_channels = AOUT_CHAN_LEFT | AOUT_CHAN_RIGHT;
+    a->output.i_nb_samples = 1024;
+    a->output.pf_play = AudioPlay;
+    audio = a;
+    ++audio_epoch;
+    mutex_unlock(&bridge);
+    aout_VolumeSoftInit(a);
+    return VLC_SUCCESS;
+}
+static void CloseAudio(vlc_object_t *obj)
+{
+    mutex_lock(&bridge);
+    if (audio == (aout_instance_t *)obj) { audio = NULL; ++audio_epoch; }
+    while (audio_readers) condition_wait(readers_done, &bridge);
+    mutex_unlock(&bridge);
+}
+static aout_buffer_t *AudioBuffer(mtime_t date, unsigned *epoch)
+{
+    aout_instance_t *a;
+    aout_buffer_t *buffer;
+    mutex_lock(&bridge);
+    a = audio; *epoch = audio_epoch;
+    if (a) ++audio_readers;
+    mutex_unlock(&bridge);
+    if (!a) return NULL;
+    buffer = aout_OutputNextBuffer(a, date, false);
+    mutex_lock(&bridge);
+    --audio_readers;
+    condition_broadcast(readers_done);
+    if (*epoch != audio_epoch && buffer) { aout_BufferFree(buffer); buffer = NULL; }
+    mutex_unlock(&bridge);
+    return buffer;
+}
