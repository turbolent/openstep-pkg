+    vlc_object_lock(playlist);
+    /* PLAYLIST_PAUSE toggles both input and playlist state. PLAYLIST_PLAY
+     * alone leaves the playlist paused when an existing input resumes. */
+    playlist_Control(playlist, playlist->status.i_status == PLAYLIST_STOPPED ?
+                     PLAYLIST_PLAY : PLAYLIST_PAUSE, pl_Locked);
+    state = playlist->status.i_status;
+    vlc_object_unlock(playlist);
+    vlc_playback_pause(state == PLAYLIST_PAUSED);
+    [self soundTick:state != PLAYLIST_RUNNING];
+}
