+        char *cwd = getcwd(NULL, 0);
+        char path[MAXPATHLEN];
+        DIR *dir;
+        struct direct *entry;
+        char first[MAXPATHLEN];
+        int status, child;
+        assert(cwd && cwd[0] == '/');
+        assert(getcwd(path, sizeof(path)) == path && !strcmp(cwd, path));
+        assert(getcwd(small, 1) == NULL && errno == ERANGE);
+        assert(getcwd(path, 0) == NULL && errno == EINVAL);
+        free(cwd);
+        dir = opendir(".");
+        assert(dir);
+        assert(dirfd(dir) >= 0);
+        entry = (struct direct *)readdir(dir);
+        assert(entry);
+        strcpy(first, entry->d_name);
+        while (readdir(dir)) { }
+        rewinddir(dir);
+        entry = (struct direct *)readdir(dir);
+        assert(entry && !strcmp(first, entry->d_name));
+        closedir(dir);
+        child = fork();
+        assert(child >= 0);
+        if (!child) _exit(7);
+        assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 7);
+    }
+    return 0;
