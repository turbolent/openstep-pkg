+        if (fds[i].events & POLLIN) FD_SET(fd, &rd);
+        if (fds[i].events & POLLOUT) FD_SET(fd, &wr);
+        if (fds[i].events & POLLPRI) FD_SET(fd, &ex);
+    }
+    if (ready) timeout = 0;
