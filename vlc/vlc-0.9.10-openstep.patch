+#!/bin/sh
+# From a configured/built source root, pass generic-exec, desktop PID and
+# a moving video lasting at least 10 seconds (audio is optional).
+# Avoid loop boundaries; the installed app is untouched.
+set -e
+check=playback
+if test "${1-}" = --seek; then check=seek; shift; fi
+if test "${1-}" = --quit; then check=quit; shift; fi
+test "$#" -ge 3 || { echo 'usage: ksh modules/gui/openstep-playback-check.sh [--seek|--quit] /path/generic-exec desktop-pid /path/media [VLC options]'; exit 1; }
+# The seek check needs at least 20 seconds of seekable media.
+PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
+CONFIG_SHELL=/usr/local/bin/ksh
+export PATH CONFIG_SHELL
+ulimit -c 0
+{
+    echo '#include <assert.h>'
+    sed "/@implementation OSPlayer/r src/test/openstep_$check.inc" modules/gui/openstep.m | sed '
+/    playlist_Play(playlist);/a\
+    alarm(40); [NSTimer scheduledTimerWithTimeInterval:0.02 target:self selector:@selector(checkPlayback:) userInfo:nil repeats:YES];
+'
+} > openstep-playback.m
+gcc-4.2 -O2 -std=gnu99 -fno-builtin-memset -fno-fast-math -march=i486 ${CFLAGS-} \
+    -DNeXT -D_POSIX_SOURCE -D_NEXT_SOURCE -DHAVE_CONFIG_H -I. -Iinclude \
+    -Imodules/gui -I/usr/local/include -I/usr/local/include/libavutil \
+    -D__BUILTIN__ -DMODULE_STRING=\"openstep\" \
+    -DMODULE_NAME=openstep -x objective-c -c openstep-playback.m -o openstep-playback.o
+(
+    cd bin
+    /bin/gnumake SHELL="$CONFIG_SHELL" EXEEXT=-playback-check \
+        'vlc_OBJECTS=vlc-vlc.o ../openstep-playback.o' vlc-playback-check
+    /bin/strip vlc-playback-check
+    /bin/sh ../modules/gui/openstep-fix-macho.sh vlc-playback-check
+)
+helper=$1; desktop=$2; media=$3; shift 3
+if test -n "$media"; then set -- "$media" "$@"; fi
+exec "$helper" "$desktop" "$PWD/bin/vlc-playback-check" --ignore-config --no-color \
+    --no-osd --no-video-title-show "$@"
