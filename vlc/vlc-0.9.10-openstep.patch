+#ifndef VLC_OPENSTEP_GCRYPT_H
+#define VLC_OPENSTEP_GCRYPT_H
+#include <mach/cthreads.h>
+#include <errno.h>
+static int os_gcrypt_lock_init(void **lock)
+{
+    *lock = mutex_alloc();
+    return *lock ? 0 : ENOMEM;
+}
+static int os_gcrypt_lock_destroy(void **lock)
+{
+    mutex_free((mutex_t)*lock);
+    return 0;
+}
+static int os_gcrypt_lock(void **lock)
+{
+    mutex_lock((mutex_t)*lock);
+    return 0;
+}
+static int os_gcrypt_unlock(void **lock)
+{
+    mutex_unlock((mutex_t)*lock);
+    return 0;
+}
+static const struct gcry_thread_cbs gcry_threads_openstep = {
+    GCRY_THREAD_OPTION_USER, NULL, os_gcrypt_lock_init, os_gcrypt_lock_destroy,
+    os_gcrypt_lock, os_gcrypt_unlock
