+/* Concurrent sleep regression for OPENSTEP. GPL version 2 or later. */
+#include "config.h"
+#include <vlc_common.h>
+#undef NDEBUG
+#include <assert.h>
+static any_t sleeper(any_t unused)
+{
+    mtime_t start = mdate();
+    int n;
+    (void)unused;
+    for (n = 0; n < 20; ++n) msleep(10000);
+    assert(mdate() - start >= 200000);
+    return NULL;
+}
+int main(void)
+{
+    cthread_t a, b;
+    mtime_t paused, wall, resumed;
+    vlc_object_t object;
+    int n;
+    alarm(10);
+    cthread_init();
+    a = cthread_fork(sleeper, NULL);
+    b = cthread_fork(sleeper, NULL);
+    assert(a && b);
+    sleeper(NULL);
+    cthread_join(a);
+    cthread_join(b);
+    msleep(0);
+    msleep(-1);
+    assert(!vlc_playback_active());
+    memset(&object, 0, sizeof(object));
+    object.p_libvlc = (libvlc_int_t *)&object;
+    wall = mdate();
+    vlc_playback_wait(&object, wall + 20000);
+    assert(mdate() - wall >= 20000);
+    for (n = 0; n < 4; ++n) {
+        vlc_playback_pause(true);
+        paused = vlc_playback_date(); wall = mdate();
+        msleep(30000);
+        assert(vlc_playback_date() == paused && mdate() - wall >= 30000);
+        vlc_playback_wait(&object, paused + 1000000);
+        vlc_playback_pause(false);
+        resumed = vlc_playback_date();
+        assert(resumed >= paused && resumed - paused < 10000);
+        vlc_playback_wait(&object, resumed + 30000);
+        assert(vlc_playback_date() - resumed >= 30000);
+    }
+    object.b_die = true;
+    vlc_playback_wait(&object, vlc_playback_date() + 1000000);
+    return 0;
+}
