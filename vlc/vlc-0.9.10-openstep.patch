+/* Native mutex, condition and TLS regression. GPL version 2 or later. */
+#include "config.h"
+#include <vlc_common.h>
+#undef NDEBUG
+#include <assert.h>
+#include "../misc/openstep_threads.inc"
+
+static vlc_threadvar_t key;
+static vlc_mutex_t lock;
+static vlc_cond_t cond;
+static vlc_cond_t wake;
+static unsigned ready;
+static unsigned released;
+struct context { unsigned calls; };
+
+static void destroy(void *value)
+{
+    struct context *ctx = value;
+    assert(vlc_openstep_tls_get(&key) == NULL);
+    ++ctx->calls;
+    /* Deliberately reassign forever: cleanup must bound destructor calls. */
+    assert(vlc_openstep_tls_set(&key, value) == 0);
+}
+static any_t worker(any_t unused)
+{
+    struct context ctx = {0};
+    unsigned i;
+    assert(vlc_openstep_tls_get(&key) == NULL);
+    for (i = 0; i < 1000; ++i) {
+        assert(vlc_openstep_tls_set(&key, &ctx) == 0);
+        assert(vlc_openstep_tls_get(&key) == &ctx);
+        cthread_yield();
+    }
+    openstep_tls_cleanup();
+    assert(ctx.calls == 4);
+    assert(vlc_openstep_tls_get(&key) == NULL);
+    vlc_mutex_lock(&lock);
+    ++ready;
+    vlc_cond_signal(&cond);
+    while (!released) vlc_cond_wait(&wake, &lock);
+    /* Exercise signal/timeout races and repeated port allocation. */
+    for (i = 0; i < 100; ++i) {
+        int result = vlc_cond_timedwait(&wake, &lock, mdate() + 1000);
+        assert(result == 0 || result == ETIMEDOUT);
+        vlc_cond_signal(&wake);
+    }
+    vlc_mutex_unlock(&lock);
+    return NULL;
+}
+int main(void)
+{
+    cthread_t threads[4];
+    struct context parent = {0};
+    mtime_t before;
+    unsigned i;
+    cthread_init();
+    alarm(15);
+    assert(openstep_key_create(&key, destroy) == 0);
+    assert(vlc_openstep_tls_set(&key, &parent) == 0);
+    assert(openstep_mutex_init(&lock, true) == 0);
+    vlc_mutex_lock(&lock);
+    vlc_mutex_lock(&lock);
+    vlc_mutex_unlock(&lock);
+    vlc_mutex_unlock(&lock);
+    openstep_mutex_destroy(&lock);
+    assert(openstep_mutex_init(&lock, false) == 0);
+    assert(openstep_cond_init(&cond) == 0);
+    assert(openstep_cond_init(&wake) == 0);
+    vlc_mutex_lock(&lock);
+    for (i = 0; i < 4; ++i) {
+        threads[i] = cthread_fork(worker, NULL);
+        assert(threads[i]);
+    }
+    while (ready != 4)
+        assert(vlc_cond_timedwait(&cond, &lock, mdate() + 2000000) == 0);
+    before = mdate();
+    assert(vlc_cond_timedwait(&cond, &lock, before + 100000) == ETIMEDOUT);
+    assert(mdate() - before >= 100000);
+    assert(vlc_cond_timedwait(&cond, &lock, 0) == ETIMEDOUT);
+    released = 1;
+    for (i = 0; i < 4; ++i) vlc_cond_signal(&wake);
+    vlc_mutex_unlock(&lock);
+    for (i = 0; i < 4; ++i) cthread_join(threads[i]);
+    assert(vlc_openstep_tls_get(&key) == &parent);
+    openstep_key_delete(&key);
+    assert(parent.calls == 0 && tls_keys == NULL);
+    openstep_cond_destroy(&cond);
+    openstep_cond_destroy(&wake);
+    openstep_mutex_destroy(&lock);
+    return 0;
+}
