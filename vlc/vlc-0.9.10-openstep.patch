+static inline unsigned long long vlc_openstep_strtoull(const char *text,
+                                                      char **end, int base)
+{
+    const unsigned char *p = (const unsigned char *)text;
+    unsigned long long value = 0, maximum = ~0ULL;
+    int negative, any = 0, overflow = 0;
+    if (end) *end = (char *)text;
+    if (base && (base < 2 || base > 36)) { errno = EINVAL; return 0; }
+    while (isspace(*p)) ++p;
+    negative = *p == '-';
+    if (*p == '-' || *p == '+') ++p;
+    if ((base == 0 || base == 16) && p[0] == '0' &&
+        (p[1] == 'x' || p[1] == 'X') && isxdigit(p[2])) {
+        base = 16; p += 2;
+    }
+    if (!base) base = *p == '0' ? 8 : 10;
+    for (; *p; ++p) {
+        unsigned digit;
+        if (*p >= '0' && *p <= '9') digit = *p - '0';
+        else if (*p >= 'a' && *p <= 'z') digit = *p - 'a' + 10;
+        else if (*p >= 'A' && *p <= 'Z') digit = *p - 'A' + 10;
+        else break;
+        if (digit >= (unsigned)base) break;
+        any = 1;
+        if (value > (maximum - digit) / base) overflow = 1;
+        else value = value * base + digit;
+    }
+    if (end && any) *end = (char *)p;
+    if (overflow) { errno = ERANGE; return maximum; }
+    return negative ? 0ULL - value : value;
+}
+#define strtoull vlc_openstep_strtoull
+static inline int vlc_openstep_waitpid(int pid, int *status, int options)
+{
+    return wait4(pid, (union wait *)status, options, NULL);
+}
+#define waitpid vlc_openstep_waitpid
+
+static inline int vlc_openstep_strerror_r(int error, char *buf, size_t size)
+{
+    const char *text = strerror(error);
+    size_t length = strlen(text);
+    if (size) {
+        size_t copied = length < size ? length : size - 1;
+        memcpy(buf, text, copied);
+        buf[copied] = 0;
+    }
+    return length < size ? 0 : ERANGE;
+}
+#define strerror_r vlc_openstep_strerror_r
+
+static inline const char *vlc_openstep_strsignal(int number)
+{
+    /* The native signal descriptions are immutable. */
+    extern const char *sys_siglist[];
+    return number > 0 && number < NSIG ? sys_siglist[number] : "Unknown signal";
+}
+#define strsignal vlc_openstep_strsignal
+
+static inline char *vlc_openstep_getcwd(char *buf, size_t size)
+{
+    char path[MAXPATHLEN];
+    size_t length;
+    if (!getwd(path)) return NULL;
+    length = strlen(path) + 1;
+    if (buf && !size) { errno = EINVAL; return NULL; }
+    if (size && size < length) { errno = ERANGE; return NULL; }
+    if (!buf) {
+        buf = (char *)malloc(size ? size : length);
+        if (!buf) { errno = ENOMEM; return NULL; }
+    }
+    memcpy(buf, path, length);
+    return buf;
+}
+#define getcwd vlc_openstep_getcwd
+
+/* curl handles ll/z formats; its snprintf returns a truncated length.
+ * Preserve the C99 required-length result used by VLC's callers. */
+static inline int vlc_openstep_vsnprintf(char *dst, size_t size,
+                                       const char *fmt, va_list ap)
+{
+    char *text;
+    size_t length, copied;
+    if (size) dst[0] = 0;
+    text = curl_mvaprintf(fmt, ap);
+    if (!text) return -1;
+    length = strlen(text);
+    if (length > INT_MAX) { free(text); return -1; }
+    if (size) {
+        copied = length < size ? length : size - 1;
+        memcpy(dst, text, copied); dst[copied] = 0;
+    }
+    free(text);
+    return (int)length;
+}
+static inline int vlc_openstep_snprintf(char *dst, size_t size, const char *fmt, ...)
+{
+    va_list ap;
+    int result;
+    va_start(ap, fmt);
+    result = vlc_openstep_vsnprintf(dst, size, fmt, ap);
+    va_end(ap);
+    return result;
+}
