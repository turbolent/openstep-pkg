+/* Included only in the separate GUI regression executable.
+ * VLC_QUIT_TEST_MODE: playing (default), paused, stopped, ended or idle.
+ * For ended, pass --stop-time=1; for idle, pass an empty media argument. */
+#undef NDEBUG
+#include <assert.h>
+- (void)checkPlayback:(id)sender
+{
+    static mtime_t deadline;
+    static int phase;
+    const char *mode = getenv("VLC_QUIT_TEST_MODE");
+    input_thread_t *input;
+    int state;
+    if (!mode) mode = "playing";
+    if (!deadline) { deadline = mdate() + 3000000; return; }
+    if (mdate() < deadline) return;
+    if (!phase) {
+        if (!strcmp(mode, "paused")) [self play:nil];
+        if (!strcmp(mode, "stopped")) [self stop:nil];
+        phase = 1; deadline = mdate() + 1000000; return;
+    }
+    input = playlist_CurrentInput(playlist);
+    state = input ? var_GetInteger(input, "state") : -1;
+    if (!strcmp(mode, "playing")) assert(input && state == PLAYING_S);
+    else if (!strcmp(mode, "paused")) assert(input && state == PAUSE_S);
+    else assert(!input);
+    if (input) vlc_object_release(input);
+    fprintf(stderr, "QUIT action mode=%s\n", mode); fflush(stderr);
+    [sender invalidate];
+    /* A shutdown hang must fail, even after the AppKit timer stops running. */
+    alarm(5);
+    [self quit:nil];
+}
