+- (void)seek:(id)sender
+{
+    input_thread_t *input = playlist_CurrentInput(playlist);
+    (void)sender;
+    if (!input) return;
+    if (vlc_object_alive(input) && var_GetBool(input, "seekable")) {
+        var_SetFloat(input, "position", [position doubleValue]);
+        [self resetSound];
+    }
+    vlc_object_release(input);
+    [self updatePosition];
+}
+- (void)updatePosition
+{
+    input_thread_t *input = playlist_CurrentInput(playlist);
+    mtime_t time = 0, length = 0;
+    double value = 0;
+    BOOL seekable = NO;
+    char text[MSTRTIME_MAX_SIZE];
+    if (input) {
+        int state = var_GetInteger(input, "state");
+        if (vlc_object_alive(input) && (state == PLAYING_S || state == PAUSE_S)) {
+            time = var_GetTime(input, "time");
+            length = var_GetTime(input, "length");
+            value = var_GetFloat(input, "position");
+            seekable = var_GetBool(input, "seekable");
+        }
+        vlc_object_release(input);
+    }
+    [position setEnabled:seekable];
+    /* The AppKit tracking loop also runs our playback timer. Leave the knob
+     * under the mouse and preview its time until mouse-up commits the seek. */
+    if (position->tracking && seekable) {
+        if (length > 0) time = length * [position doubleValue];
+    } else [position setDoubleValue:value < 0 ? 0 : value > 1 ? 1 : value];
+    if (time < 0) time = 0;
+    if (length > 0 && time > length) time = length;
+    [elapsed setStringValue:[NSString stringWithCString:
+        secstotimestr(text, time / 1000000)]];
+    [remaining setStringValue:length > 0 ? [NSString stringWithFormat:@"-%s",
+        secstotimestr(text, (length - time) / 1000000)] : @"--:--"];
