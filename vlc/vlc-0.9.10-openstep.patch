+- (void)tick:(id)sender
+{
+    int state, changed = 0, w = 0, h = 0;
+    (void)sender;
+    if (!vlc_object_alive(intf) || !vlc_object_alive(intf->p_libvlc)) {
+        vlc_playback_pause(false);
+        if (inPanel) [NSApp abortModal];
+        else {
+            [NSApp stop:nil];
+            [NSApp postEvent:[NSEvent otherEventWithType:NSApplicationDefined
+                location:NSMakePoint(0,0) modifierFlags:0 timestamp:0 windowNumber:0
+                context:[NSDPSContext currentContext] subtype:0 data1:0 data2:0] atStart:NO];
+        }
+        return;
+    }
+    vlc_object_lock(playlist); state = playlist->status.i_status; vlc_object_unlock(playlist);
+    vlc_playback_pause(state == PLAYLIST_PAUSED);
+    [status setStringValue:state == PLAYLIST_RUNNING ? @"Playing" :
+                          state == PLAYLIST_PAUSED ? @"Paused" : @"Ready"];
+    if (mdate() >= nextPositionUpdate) {
+        [self updatePosition]; nextPositionUpdate = mdate() + 100000;
+    }
+    [self soundTick:state != PLAYLIST_RUNNING];
+    mutex_lock(&bridge);
+    if (state != PLAYLIST_PAUSED && video && video->serial && video->serial != presented) {
+        w = video->width; h = video->height;
+        if (w != width || h != height) {
+            unsigned char *next = realloc(frame, w*h*4);
+            if (next) { frame = next; changed = 1; }
+            else { w = h = 0; }
+        }
+        if (w && h) {
+            memcpy(frame, video->pixels, w*h*4);
+            presented = video->serial; dirty = 1;
+        }
+    }
+    mutex_unlock(&bridge);
+    if (changed) {
+        width = w; height = h;
+        [self layout];
+    }
+    if (bitmap && frame && dirty && ![window isMiniaturized]) {
+        int ok = 0, layout;
+        int dw = [view bounds].size.width, dh = [view bounds].size.height;
+        /* Clear exposed background and paint controls before writing directly
+         * into the framebuffer, including during the resize tracking loop. */
+        [window displayIfNeeded];
+        [bitmap updateForRect:[view convertRect:[view bounds] toView:nil] inWindow:window];
+        [bitmap setDirectMapped:YES];
+        [bitmap setBuffered:[bitmap isDirectMapped] ? NO : YES];
+        if (![bitmap tryLockBitmap]) return;
+        layout = os_pixel_layout([[bitmap pixelEncoding] cString]);
+        if ([bitmap pixelsWide] >= dw && [bitmap pixelsHigh] >= dh && layout != OS_BAD) {
+            if (dw == width && dh == height)
+                ok = os_pixel_blit((unsigned char *)[bitmap data], [bitmap bytesPerRow],
+                                   frame, width, height, layout);
+            else {
+                enum PixelFormat format = layout == OS_BGRX ? PIX_FMT_RGB32 :
+                    layout == OS_RGBX ? PIX_FMT_BGR32 :
+                    layout == OS_RGB555 ? PIX_FMT_RGB555 : PIX_FMT_RGB565;
+                uint8_t *src[] = {frame, NULL, NULL, NULL};
+                uint8_t *dst[] = {(uint8_t *)[bitmap data], NULL, NULL, NULL};
+                int src_stride[] = {width*4, 0, 0, 0};
+                int dst_stride[] = {[bitmap bytesPerRow], 0, 0, 0};
+                scaler = sws_getCachedContext(scaler, width, height, PIX_FMT_RGB32,
+                    dw, dh, format, SWS_FAST_BILINEAR, NULL, NULL, NULL);
+                if (scaler) ok = sws_scale(scaler, src, src_stride, 0, height,
+                                           dst, dst_stride) == dh;
+            }
+        }
+        [bitmap unlockBitmap];
+        if (ok) { [bitmap flushIn:[view bounds]]; PSWait(); ++frames; dirty = 0; }
+        else {
+            msg_Err(intf, "cannot render Interceptor bitmap");
+            [bitmap setDirectMapped:NO]; [bitmap release]; bitmap = nil;
+        }
+    }
+}
+- (BOOL)soundResult:(NXSoundDeviceError)error
+{
+    if (error == NX_SoundDeviceErrorNone) return YES;
+    msg_Err(intf, "SoundKit: %s", [[NXSoundDevice textForError:error] cString]);
+    sound_ok = 0;
+    mutex_lock(&bridge); sound_rate = 0; mutex_unlock(&bridge);
+    [stream deactivate];
+    return NO;
+}
+- (void)setupSound
+{
+    const float *rates = NULL;
+    unsigned count = 0, n;
+    float low, high;
+    int supports22 = 0, supports44 = 0;
+    id <NXSoundParameters> parameters;
+    [NXSoundDevice setTimeout:1000]; [NXSoundDevice setUseSeparateThread:NO];
+    if (!device) device = [[NXSoundOut alloc] init];
+    if (!device) { msg_Err(intf, "SoundKit: no output device"); return; }
+    if ([device acceptsContinuousStreamSamplingRates]) {
+        if (![self soundResult:[device getStreamSamplingRatesLow:&low high:&high]]) return;
+        supports22 = low <= 22050 && high >= 22050;
+        supports44 = low <= 44100 && high >= 44100;
+    } else {
+        if (![self soundResult:[device getStreamSamplingRates:&rates count:&count]]) return;
+        for (n = 0; rates && n < count; ++n) {
+            if (rates[n] == 22050) supports22 = 1;
+            if (rates[n] == 44100) supports44 = 1;
+        }
+    }
+    rate = supports44 ? 44100 : supports22 ? 22050 : 0;
+    if (!rate) { msg_Err(intf, "SoundKit: neither 44100 nor 22050 Hz supported"); return; }
+    if (!stream) {
+        parameters = [[NXSoundParameters alloc] init];
+        stream = [[NXPlayStream alloc] initOnDevice:device withParameters:parameters];
+        [(id)parameters release];
+    }
+    if (!stream) { msg_Err(intf, "SoundKit: cannot create stream"); return; }
+    parameters = [stream parameters];
+    [parameters setParameter:NX_SoundStreamDataEncoding toInt:NX_SoundStreamDataEncoding_Linear16];
+    [parameters setParameter:NX_SoundStreamSamplingRate toFloat:rate];
+    [parameters setParameter:NX_SoundStreamChannelCount toInt:2];
+    stride = ((4096 + vm_page_size - 1) / vm_page_size) * vm_page_size;
+    /* Keep the stream, delegate and VM buffers alive for late SoundKit replies. */
+    if (!memory && vm_allocate(task_self(), &memory, stride*8, TRUE) != KERN_SUCCESS) {
+        memory = 0; msg_Err(intf, "SoundKit: cannot allocate buffers"); return;
+    }
+    [stream setDelegate:self];
+    if (![self soundResult:[stream activate]]) return;
+    sound_ok = 1;
+    [self resetSound];
+    mutex_lock(&bridge); sound_rate = sound_ok ? rate : 0; seen_epoch = audio_epoch; mutex_unlock(&bridge);
+    msg_Info(intf, "SoundKit: %d Hz, stereo Linear16", rate);
+}
+- (void)resetSound
+{
+    if (!sound_ok) return;
+    [stream abort:nil];
+    if (![self soundResult:[stream lastError]]) return;
+    if (![self soundResult:[stream pauseAtTime:NX_SOUNDSTREAM_TIME_NULL]]) return;
+    paused = 1; queued = 0; memset(slots, 0, sizeof(slots));
+}
+- (void)soundTick:(int)hold
+{
+    unsigned epoch;
+    int n;
+    if (!sound_ok) return;
+    mutex_lock(&bridge); epoch = audio_epoch; mutex_unlock(&bridge);
+    if (epoch != seen_epoch) { [self resetSound]; seen_epoch = epoch; }
+    if (!sound_ok) return;
+    if (hold) {
+        if (!paused && [self soundResult:[stream pauseAtTime:NX_SOUNDSTREAM_TIME_NULL]]) paused = 1;
+        return;
+    }
+    if (!queued && !paused) {
+        if (![self soundResult:[stream pauseAtTime:NX_SOUNDSTREAM_TIME_NULL]]) return;
+        paused = 1;
+    }
+    for (n = 0; n < 8; ++n) if (!slots[n].busy) {
+        aout_buffer_t *buffer = AudioBuffer(mdate() + (mtime_t)queued*1000000/(rate*4), &epoch);
+        NXSoundDeviceError error;
+        unsigned bytes;
+        void *dest = (void *)(memory+n*stride);
+        if (!buffer) break;
+        if (epoch != seen_epoch || buffer->i_nb_bytes <= 0 ||
+            buffer->i_nb_bytes > 4096 || (buffer->i_nb_bytes & 3)) {
+            aout_BufferFree(buffer); break;
+        }
+        bytes = buffer->i_nb_bytes;
+#ifdef WORDS_BIGENDIAN
+        memcpy(dest, buffer->p_buffer, bytes);
+#else
+        swab((char *)buffer->p_buffer, (char *)dest, bytes);
+#endif
+        aout_BufferFree(buffer);
+        slots[n].tag = tag++ & 0x7fffffff;
+        error = [stream playBuffer:dest size:bytes tag:slots[n].tag];
+        if (![self soundResult:error]) return;
+        slots[n].bytes = bytes; slots[n].busy = 1; queued += bytes; ++submitted;
+    }
+    if (queued && paused && [self soundResult:[stream resumeAtTime:NX_SOUNDSTREAM_TIME_NULL]]) paused = 0;
+}
+- (void)soundStream:(id)sender didCompleteBuffer:(int)number
+{
+    int n;
+    if (sender != stream || !sound_ok) return;
+    for (n = 0; n < 8; ++n) if (slots[n].busy && slots[n].tag == (unsigned)number) {
+        queued -= slots[n].bytes; slots[n].busy = 0; ++completed; break;
+    }
+}
+- (void)soundStreamDidAbort:(id)sender deviceReserved:(BOOL)reserved
+{
+    if (sender == stream && reserved && sound_ok) {
+        msg_Err(intf, "SoundKit: device reserved by another application");
+        sound_ok = 0;
+        mutex_lock(&bridge); sound_rate = 0; mutex_unlock(&bridge);
+    }
+}
+@end
