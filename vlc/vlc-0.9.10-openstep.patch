+/* OPENSTEP Interceptor pixel layouts.
+ * GPL version 2 or later. Intel storage order, including legacy 18-bit RGB565. */
+#ifndef VLC_OPENSTEP_PIXELS_H
+#define VLC_OPENSTEP_PIXELS_H
+#include <string.h>
+#include <limits.h>
+enum { OS_BAD, OS_BGRX, OS_RGBX, OS_RGB555, OS_RGB565 };
+static int os_pixel_layout(const char *encoding)
+{
+    if (!encoding) return OS_BAD;
+    if (!strcmp(encoding, "--------RRRRRRRRGGGGGGGGBBBBBBBB")) return OS_BGRX;
+    if (!strcmp(encoding, "RRRRRRRRGGGGGGGGBBBBBBBBAAAAAAAA") ||
+        !strcmp(encoding, "RRRRRRRRGGGGGGGGBBBBBBBB--------")) return OS_RGBX;
+    if (!strcmp(encoding, "RRRRRGGGGGBBBBB") ||
+        !strcmp(encoding, "-RRRRRGGGGGBBBBB")) return OS_RGB555;
+    if (!strcmp(encoding, "RRRRRRGGGGGGBBBBBB") ||
+        !strcmp(encoding, "RRRRRGGGGGGBBBBB")) return OS_RGB565;
+    return OS_BAD;
+}
+static int os_pixel_blit(unsigned char *dst, int stride,
+                         const unsigned char *bgrx, int width, int height,
+                         int layout)
+{
+    int x, y, bytes = layout == OS_RGB555 || layout == OS_RGB565 ? 2 : 4;
+    if (!dst || !bgrx || layout < OS_BGRX || layout > OS_RGB565 ||
+        width <= 0 || width > INT_MAX / 4 || height <= 0 ||
+        stride / bytes < width || height > INT_MAX / stride ||
+        height > INT_MAX / (width * 4)) return 0;
+    for (y = 0; y < height; ++y) {
+        unsigned char *out = dst + y * stride;
+        const unsigned char *in = bgrx + y * width * 4;
