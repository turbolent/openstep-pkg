+            } else {
+                unsigned pixel = layout == OS_RGB555 ?
+                    ((in[2] >> 3) << 10) | ((in[1] >> 3) << 5) | (in[0] >> 3) :
+                    ((in[2] >> 3) << 11) | ((in[1] >> 2) << 5) | (in[0] >> 3);
