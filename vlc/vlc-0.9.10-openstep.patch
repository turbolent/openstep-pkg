+#!/bin/sh
+# OPENSTEP's loader expects the i486 subtype for portable i386 executables.
+set -e
+/usr/bin/perl -0777 -pi -e '
+    die "not a little-endian i386 Mach-O executable\n"
+        unless unpack("V", substr($_, 0, 4)) == 0xfeedface
+            && unpack("V", substr($_, 4, 4)) == 7;
+    substr($_, 8, 4) = pack("V", 4);
+' "$1"
