+static int OpenIntf(vlc_object_t *obj)
+{
+    intf_thread_t *i = (intf_thread_t *)obj;
+    mutex_lock(&bridge);
+    if (!readers_done) readers_done = condition_alloc();
+    if (interface_reserved || !readers_done) { mutex_unlock(&bridge); return VLC_EGENERIC; }
+    interface_reserved = 1;
+    mutex_unlock(&bridge);
+    i->pf_run = RunIntf;
+    i->b_should_run_on_first_thread = true;
+    return VLC_SUCCESS;
+}
+static void CloseIntf(vlc_object_t *obj)
+{
+    (void)obj;
+    mutex_lock(&bridge); interface_reserved = 0; mutex_unlock(&bridge);
+}
+static void RunIntf(intf_thread_t *intf)
+{
+    NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+    NSTimer *timer;
+    [NSApplication sharedApplication];
+    if (!player) player = [[OSPlayer alloc] init];
+    [player start:intf];
+    timer = [NSTimer timerWithTimeInterval:0.01 target:player
+                  selector:@selector(tick:) userInfo:nil repeats:YES];
+    [[NSRunLoop currentRunLoop] addTimer:timer forMode:NSDefaultRunLoopMode];
+    [[NSRunLoop currentRunLoop] addTimer:timer forMode:NSModalPanelRunLoopMode];
+    [[NSRunLoop currentRunLoop] addTimer:timer forMode:NSEventTrackingRunLoopMode];
+    /* OPENSTEP modal panels need an outer application run level to unwind. */
+    [NSApp run];
+    [timer invalidate];
+    [player finish];
+    [pool release];
+}
