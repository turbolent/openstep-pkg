diff -ruN a/tc.func.c b/tc.func.c
--- a/tc.func.c	2026-10-06 04:38:14.544376003 +0000
+++ b/tc.func.c	2026-10-06 04:53:54.234910322 +0000
@@ -2051,7 +2051,19 @@
 {
     struct sigaction sa;
     struct strbuf hostname = strbuf_INIT;
-    int fds[2], wait_options, status;
+    int fds[2], wait_options;
+#ifdef NeXT
+    /* OPENSTEP has BSD union wait (its WIF*() macros need it) and no
+       waitpid(); wait4() is the same call plus an rusage. */
+    union wait status;
+    extern int wait4();
+# define waitpid(p, s, o)	wait4((p), (s), (o), (void *) 0)
+# ifndef WEXITSTATUS
+#  define WEXITSTATUS(w)	((w).w_retcode)
+# endif
+#else
+    int status;
+#endif
     pid_t pid, wait_res;
 
     sa.sa_handler = SIG_DFL; /* Make sure a zombie is created */
