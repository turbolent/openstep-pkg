diff -ruN a/CPP/myWindows/StdAfx.h b/CPP/myWindows/StdAfx.h
--- a/CPP/myWindows/StdAfx.h	2026-10-06 04:22:58.310849924 +0000
+++ b/CPP/myWindows/StdAfx.h	2026-10-06 04:22:58.353151421 +0000
@@ -29,8 +29,185 @@
 #include <stddef.h>
 #include <ctype.h>
 #include <unistd.h>
+#ifdef ENV_OPENSTEP
+/* OPENSTEP's <unistd.h> declares almost nothing; read(), write(), close(),
+   open(), lseek() and friends are declared by <libc.h>. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+#include <libc.h>
+/* <libc.h> does not declare getppid() either. */
+extern int getppid(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
 #include <errno.h>
 #include <math.h>
+#ifdef ENV_OPENSTEP
+/* OPENSTEP's libc has no snprintf().  p7zip only formats short messages and
+   paths with it, so format into a large local buffer and copy out what fits. */
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+static inline int openstep_snprintf(char *buf, size_t size, const char *fmt, ...)
+{
+  char tmp[8192];
+  va_list ap;
+  int n;
+  va_start(ap, fmt);
+  n = vsprintf(tmp, fmt, ap);
+  va_end(ap);
+  if (n < 0)
+    return n;
+  if (size > 0)
+  {
+    size_t m = ((size_t)n < size - 1) ? (size_t)n : size - 1;
+    memcpy(buf, tmp, m);
+    buf[m] = 0;
+  }
+  return n;
+}
+#define snprintf openstep_snprintf
+
+/* OPENSTEP's utime() is `int utime(char *, time_t *)` where the second argument
+   is a two-element array {actime, modtime}; there is no struct utimbuf
+   parameter and no const.  Wrap the POSIX form p7zip uses. */
+#ifdef __cplusplus
+extern "C" int utime(char *, time_t *);
+#else
+extern int utime(char *, time_t *);
+#endif
+static inline int openstep_utime(const char *path, const struct utimbuf *b)
+{
+  time_t t[2];
+  t[0] = b->actime;
+  t[1] = b->modtime;
+  return utime((char *)path, t);
+}
+#define utime openstep_utime
+
+/* File type and permission macros that OPENSTEP's <sys/stat.h> hides without
+   _POSIX_SOURCE (the standard BSD values). */
+#ifndef S_ISDIR
+# define S_ISDIR(m)	(((m) & 0170000) == 0040000)
+#endif
+#ifndef S_ISREG
+# define S_ISREG(m)	(((m) & 0170000) == 0100000)
+#endif
+#ifndef S_ISLNK
+# define S_ISLNK(m)	(((m) & 0170000) == 0120000)
+#endif
+#ifndef S_ISCHR
+# define S_ISCHR(m)	(((m) & 0170000) == 0020000)
+#endif
+#ifndef S_ISBLK
+# define S_ISBLK(m)	(((m) & 0170000) == 0060000)
+#endif
+#ifndef S_ISFIFO
+# define S_ISFIFO(m)	(((m) & 0170000) == 0010000)
+#endif
+#ifndef S_ISSOCK
+# define S_ISSOCK(m)	(((m) & 0170000) == 0140000)
+#endif
+#ifndef S_IRUSR
+# define S_IRUSR	0000400
+# define S_IWUSR	0000200
+# define S_IXUSR	0000100
+#endif
+#ifndef S_IRWXU
+# define S_IRWXU	0000700
+#endif
+#ifndef S_IRGRP
+# define S_IRGRP	0000040
+# define S_IWGRP	0000020
+# define S_IXGRP	0000010
+# define S_IRWXG	0000070
+#endif
+#ifndef S_IROTH
+# define S_IROTH	0000004
+# define S_IWOTH	0000002
+# define S_IXOTH	0000001
+# define S_IRWXO	0000007
+#endif
+
+/* No getcwd() in libc; the BSD getwd() does the job. */
+extern "C" char *getwd(char *);
+static inline char *openstep_getcwd(char *buf, size_t size)
+{
+  char path[2048];
+  size_t len;
+  if (buf != 0 && size == 0)
+  {
+    errno = EINVAL;
+    return 0;
+  }
+  if (getwd(path) == 0)
+  {
+    errno = EACCES;
+    return 0;
+  }
+  len = strlen(path) + 1;
+  if (buf == 0)
+  {
+    if (size < len)
+      size = len;
+    buf = (char *)malloc(size);
+    if (buf == 0)
+      return 0;
+  }
+  else if (size < len)
+  {
+    errno = ERANGE;
+    return 0;
+  }
+  memcpy(buf, path, len);
+  return buf;
+}
+#define getcwd openstep_getcwd
+
+/* No putenv() or setenv() either. */
+extern "C" { extern char **environ; }
+static inline int openstep_putenv(char *str)
+{
+  char *eq = strchr(str, '=');
+  size_t nlen, n = 0;
+  char **e, **newenv;
+  if (eq == 0)
+    return -1;
+  nlen = (size_t)(eq - str);
+  for (e = environ; e != 0 && *e != 0; e++, n++)
+    if (strncmp(*e, str, nlen) == 0 && (*e)[nlen] == '=')
+    {
+      *e = str;
+      return 0;
+    }
+  newenv = (char **)malloc((n + 2) * sizeof(char *));
+  if (newenv == 0)
+    return -1;
+  if (n != 0)
+    memcpy(newenv, environ, n * sizeof(char *));
+  newenv[n] = str;
+  newenv[n + 1] = 0;
+  environ = newenv;
+  return 0;
+}
+#define putenv openstep_putenv
+static inline int openstep_setenv(const char *name, const char *value, int overwrite)
+{
+  char *str;
+  if (!overwrite && getenv(name) != 0)
+    return 0;
+  str = (char *)malloc(strlen(name) + strlen(value) + 2);
+  if (str == 0)
+    return -1;
+  strcpy(str, name);
+  strcat(str, "=");
+  strcat(str, value);
+  return openstep_putenv(str);
+}
+#define setenv openstep_setenv
+#endif
 
