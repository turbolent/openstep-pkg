+++ b/perl.h	2026-10-06 14:18:48.652745172 +0000
@@ -557,6 +557,25 @@
 #   include <unistd.h>
 #endif
 
+#ifdef NeXT
+#include <sys/param.h>	/* NGROUPS */
+#ifndef NGROUPS
+#  define NGROUPS 16
+#endif
+extern char *getwd(char *);
+/* Declared without a prototype: <unistd.h> may already declare it, with a
+   different group type, and a prototype of ours would then conflict. */
+extern int getgroups();
+/* BSD getgroups doesn't implement the POSIX zero-size query. */
+static int
+Perl_next_getgroups(int count, void *groups)
+{
+    int query[NGROUPS];
+    return getgroups(count ? count : NGROUPS, count ? groups : (void *)query);
+}
+#define getgroups Perl_next_getgroups
+#endif
