+
 #ifdef NETWARE
 	#define _POSIX_
 	/*
@@ -226,6 +230,63 @@
 
 typedef int SysRet;
 typedef long SysRetLong;
+#ifdef NeXT
+/* OPENSTEP declares POSIX signals but only implements the BSD interface. */
+#define SA_RESTART 0x10000000
+static int next_sigvalid(int sig)
+{ if (sig > 0 && sig < NSIG) return 1; errno = EINVAL; return 0; }
+static int next_sigemptyset(sigset_t *set) { *set = 0; return 0; }
+static int next_sigfillset(sigset_t *set) { *set = 0x7fffffff; return 0; }
+static int next_sigaddset(sigset_t *set, int sig)
+{ if (!next_sigvalid(sig)) return -1; *set |= 1U << (sig - 1); return 0; }
+static int next_sigdelset(sigset_t *set, int sig)
+{ if (!next_sigvalid(sig)) return -1; *set &= ~(1U << (sig - 1)); return 0; }
+static int next_sigismember(const sigset_t *set, int sig)
+{ if (!next_sigvalid(sig)) return -1; return !!(*set & (1U << (sig - 1))); }
+static int next_sigprocmask(int how, const sigset_t *set, sigset_t *old)
+{
+    int previous;
+    if (!set) previous = sigblock(0);
+    else switch (how) {
+    case SIG_BLOCK: previous = sigblock(*set); break;
+    case SIG_UNBLOCK: previous = sigsetmask(sigblock(0) & ~*set); break;
+    case SIG_SETMASK: previous = sigsetmask(*set); break;
+    default: errno = EINVAL; return -1;
+    }
+    if (old) *old = previous;
+    return 0;
+}
+static int next_sigaction(int sig, const struct sigaction *action,
+                          struct sigaction *old)
+{
+    struct sigvec vector, previous;
+    int result;
+    if (action) {
+        if (action->sa_flags & ~SA_RESTART) { errno = EINVAL; return -1; }
+        vector.sv_handler = action->sa_handler;
+        vector.sv_mask = action->sa_mask;
+        vector.sv_flags = action->sa_flags & SA_RESTART ? 0 : SV_INTERRUPT;
+    }
+    result = sigvec(sig, action ? &vector : NULL, old ? &previous : NULL);
+    if (!result && old) {
+        old->sa_handler = previous.sv_handler;
+        old->sa_mask = previous.sv_mask;
+        old->sa_flags = previous.sv_flags & SV_INTERRUPT ? 0 : SA_RESTART;
+    }
+    return result;
+}
+#define sigemptyset next_sigemptyset
+#define sigfillset next_sigfillset
+#define sigaddset next_sigaddset
+#define sigdelset next_sigdelset
+#define sigismember next_sigismember
+#define sigprocmask next_sigprocmask
+#define sigaction(n,a,o) next_sigaction(n,a,o)
+#define sigsuspend(s) sigpause(*(s))
+/* There is no BSD equivalent for querying pending signals. */
+#define sigpending(s) not_here("sigpending")
+#endif
+
 typedef sigset_t* POSIX__SigSet;
 typedef HV* POSIX__SigAction;
