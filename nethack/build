#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC=/usr/local/bin/gcc-4.2
export PATH CC
if test -d "NetHack-$VERSION"; then cd "NetHack-$VERSION"; fi
. "$PKG_BUILD_HELPERS"
pkg_apply_patch "nethack-$VERSION-openstep.patch"

# OPENSTEP is treated as a BSD system (the patch sets that up for -DNeXT).
# The game installs under /usr/local/lib/nethackdir with a launcher in
# /usr/local/bin.  There is no games user or group here, so ownership is left
# alone and the score and save files are writable by everyone who can run it.
# OPENSTEP's libc has no strdup(), which the X libraries use; the X11 build links
# a small definition in unless libXpm (which defines its own) is used.
/bin/cat > openstep_strdup.c <<'SDEOF'
#include <stdlib.h>
#include <string.h>

char *
strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != 0)
	memcpy(p, s, n);
    return p;
}
SDEOF
$CC $PKG_GCC42_ARCH_FLAGS -O2 -c openstep_strdup.c -o openstep_strdup.o
strdup_shim=`pwd`/openstep_strdup.o
strdup_obj=

hints=sys/unix/hints/openstep
/bin/cat > "$hints" <<'HEOF'
#-PRE
# OPENSTEP hints (generated by the pkg build script)
PREFIX=/usr/local
HACKDIR=$(PREFIX)/lib/$(GAME)dir
INSTDIR=$(DESTDIR)$(HACKDIR)
VARDIR=$(DESTDIR)$(HACKDIR)
SHELLDIR=$(DESTDIR)$(PREFIX)/bin

CFLAGS=@CFLAGS@ -I../include -DNeXT -DNOTPARMDECL
CFLAGS+=-DDLB -DTIMED_DELAY
CFLAGS+=-DCOMPRESS=\"/usr/local/bin/gzip\" -DCOMPRESS_EXTENSION=\".gz\"
CFLAGS+=-DHACKDIR=\"$(HACKDIR)\"
LINK=$(CC)

WINSRC = $(WINTTYSRC)
WINOBJ = $(WINTTYOBJ)
WINLIB = $(WINTTYLIB)
WINTTYLIB = @STRDUP@ -ltermcap

CHOWN=true
CHGRP=true
ROOTCHECK=true
DIRPERM = 0755
FILEPERM = 0644
EXEPERM = 0755
GAMEPERM = 0755
VARDIRPERM = 0777
VARFILEPERM = 0666
HEOF

if test "$HAVE_X11" = 1; then
    # X11 interface in addition to tty; tty stays the default.  The Athena
    # widgets come from neXtaw (a dependency when HAVE_X11 is 1), which has the
    # same programming interface, through an X11/Xaw include alias.
    x11=${X11_PREFIX:-/usr/X11R6}
    if test ! -f /usr/local/include/X11/neXtaw/Label.h; then
        echo "nethack: HAVE_X11=1 but neXtaw is not installed" >&2
        exit 1
    fi
    if test ! -f "$x11/include/X11/Intrinsic.h"; then
        echo "nethack: no X11 headers under $x11; set X11_PREFIX in pkg.conf" >&2
        exit 1
    fi
    /usr/local/bin/mkdir -p openstep-inc/X11
    /bin/ln -s /usr/local/include/X11/neXtaw openstep-inc/X11/Xaw
    xaw_inc="-I`pwd`/openstep-inc"
    # (Static archives: each library must come before the ones it needs, so libXpm
    # goes ahead of libX11.)
    # libSM and libICE are only there when the X11 install has session
    # management; libXpm only when it has pixmap support (tiles and the tombstone).
    sm_libs=
    if ls "$x11"/lib/libSM* > /dev/null 2>&1 && ls "$x11"/lib/libICE* > /dev/null 2>&1; then
        sm_libs="-lSM -lICE"
    fi
    xpm_lib=
    xpm_def=
    if test -f "$x11/include/X11/xpm.h" && ls "$x11"/lib/libXpm* > /dev/null 2>&1; then
        xpm_lib=-lXpm
        xpm_def=-DUSE_XPM
    fi
    # libXpm carries its own strdup() (it defines one in misc.o), which would
    # clash with ours; only supply ours when libXpm is not in the link.
    if test -z "$xpm_lib"; then
        strdup_obj=$strdup_shim
    fi
    /bin/cat >> "$hints" <<HEOF
CFLAGS+=-DX11_GRAPHICS $xpm_def -I$x11/include $xaw_inc -idirafter /usr/local/include
LFLAGS=-L/usr/local/lib -L$x11/lib
WINSRC = \$(WINTTYSRC) \$(WINX11SRC)
WINOBJ = \$(WINTTYOBJ) \$(WINX11OBJ)
WINLIB = \$(WINTTYLIB) \$(WINX11LIB)
WINX11LIB = -lneXtaw $xpm_lib -lXmu -lXt $sm_libs -lXext -lX11
VARDATND = x11tiles NetHack.ad pet_mark.xbm pilemark.xbm
HEOF
    if test -n "$xpm_def"; then
        echo 'VARDATND += rip.xpm' >> "$hints"
    fi
fi

/bin/sed -e "s|@CFLAGS@|-O2 $PKG_GCC42_ARCH_FLAGS|" -e "s|@STRDUP@|$strdup_obj|" "$hints" > "$hints.new"
/bin/mv "$hints.new" "$hints"

# The distribution carries pre-generated lex and yacc output; use it instead of
# depending on the system's yacc and lex.
/bin/cp sys/share/lev_comp.h sys/share/dgn_comp.h include/
/bin/cp sys/share/lev_lex.c sys/share/lev_yacc.c sys/share/dgn_lex.c sys/share/dgn_yacc.c util/

/bin/sh sys/unix/setup.sh sys/unix/hints/openstep
# The old Bourne /bin/sh treats an unquoted ^ as a pipe, so dat/Makefile's
# "grep ^#define ..." (building NetHack.ad) ran grep with no arguments and left
# the X resource file empty.  Quote the patterns.
/bin/cat > nh-fix.sed <<'FEOF'
s/grep ^#define/grep '^#define'/
s/grep -v ^#define/grep -v '^#define'/
FEOF
/bin/sed -f nh-fix.sed dat/Makefile > dat/Makefile.new
/bin/mv dat/Makefile.new dat/Makefile
/bin/rm -f nh-fix.sed
# lev_comp and dgn_comp (util/) use strdup(), which this libc lacks.
echo "LFLAGS += $strdup_shim" >> util/Makefile
# Use NetHack's own pattern matcher instead of the system regcomp(); this has to
# be set in the generated makefile because the object list is read early.
/bin/sed 's/^REGEXOBJ = posixregex.o/REGEXOBJ = pmatchregex.o/' src/Makefile > src/Makefile.new
/bin/mv src/Makefile.new src/Makefile
# "make all" would also format the Guidebook with nroff; install builds what the
# game needs.
/bin/gnumake install DESTDIR="$DESTDIR"

# This build uses a system configuration file (SYSCF is on by default) and the
# game refuses to start without one: install the stock sysconf.
/bin/cp sys/unix/sysconf "$DESTDIR/usr/local/lib/nethackdir/sysconf"
/bin/chmod 644 "$DESTDIR/usr/local/lib/nethackdir/sysconf"

# Replace the stock launcher (it uses shell features the system sh lacks).
/bin/cat > "$DESTDIR/usr/local/bin/nethack" <<'LEOF'
#!/bin/sh
HACKDIR=/usr/local/lib/nethackdir
export HACKDIR
XUSERFILESEARCHPATH=$HACKDIR/%N.ad
export XUSERFILESEARCHPATH
cd $HACKDIR
exec $HACKDIR/nethack ${1+"$@"}
LEOF
/bin/chmod 755 "$DESTDIR/usr/local/bin/nethack"

test -x "$DESTDIR/usr/local/lib/nethackdir/nethack"
test -f "$DESTDIR/usr/local/lib/nethackdir/nhdat"
test -f "$DESTDIR/usr/local/lib/nethackdir/sysconf"
