+
+// OPENSTEP provides the BSD signal interface, not POSIX sigaction/sigset_t.
+static struct sigvec prev_sigvec;
+static volatile sig_atomic_t timeout_flag = FALSE;
+static int timer_active = FALSE;
+
+    static void
+set_flag SIGDEFARG(sigarg)
+{
+    timeout_flag = TRUE;
+}
+
+    void
+stop_timeout(void)
+{
+    struct itimerval disarm = {{0, 0}, {0, 0}};
+    struct sigvec ignore_alarm;
+    int saved_mask;
+
+    if (timer_active)
+    {
+	saved_mask = sigblock(sigmask(SIGALRM));
+	if (setitimer(ITIMER_REAL, &disarm, NULL) < 0)
+	    semsg(_(e_could_not_clear_timeout_str), strerror(errno));
+	// Discard a pending alarm before restoring the previous disposition.
+	ignore_alarm.sv_handler = SIG_IGN;
+	ignore_alarm.sv_mask = 0;
+	ignore_alarm.sv_flags = 0;
+	(void)sigvec(SIGALRM, &ignore_alarm, NULL);
+	if (sigvec(SIGALRM, &prev_sigvec, NULL) < 0)
+	    semsg(_(e_could_not_reset_handler_for_timeout_str), strerror(errno));
+	timer_active = FALSE;
+	(void)sigsetmask(saved_mask);
+    }
+    timeout_flag = FALSE;
+}
+
+    volatile sig_atomic_t *
+start_timeout(long msec)
+{
+    struct itimerval interval = {{0, 0},
+	{msec / 1000, (msec % 1000) * 1000}};
+    struct sigvec handle_alarm;
+    int saved_mask;
+
+    stop_timeout();
+    saved_mask = sigblock(sigmask(SIGALRM));
+    handle_alarm.sv_handler = set_flag;
+    handle_alarm.sv_mask = 0;
+    handle_alarm.sv_flags = 0;
+    if (sigvec(SIGALRM, &handle_alarm, &prev_sigvec) < 0)
+	semsg(_(e_could_not_set_handler_for_timeout_str), strerror(errno));
+    else
+    {
+	timer_active = TRUE;
+	if (setitimer(ITIMER_REAL, &interval, NULL) < 0)
+	{
+	    semsg(_(e_could_not_set_timeout_str), strerror(errno));
+	    stop_timeout();
+	}
+    }
+    (void)sigsetmask(saved_mask);
+    return &timeout_flag;
+}
+
