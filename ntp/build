/bin/chmod 755 sntp/scripts/genLocInfo
# --disable-all-clocks: no radio/GPS/modem reference-clock drivers (they need
# hardware, sys/ipc.h and more that OPENSTEP lacks); the network is the time
# source, with the local clock driver kept as a fallback.
# --disable-thread-support: configure finds <cthreads.h> and then cannot link
# Mach CThreads; ntpd copes without threads (name lookups use a child process).
# Everything stays under /usr/local; configuration is /usr/local/etc/ntpd.conf
# (start ntpd with -c /usr/local/etc/ntpd.conf).
# ntp wants arc4random_buf() (and strdup, which this libc lacks) for random numbers when OpenSSL is absent, and
# otherwise falls back to libevent's copy -- but the libevent tearoff does not
# compile here (no IPv6 types) and nothing else needs it.  Supply a small
# arc4random_buf(): an RC4 keystream keyed from the system clock, process ids
# and /dev/random or /dev/urandom when they exist.  The configure step is told
# the function exists, the libevent directory is left unbuilt, and ntp-keygen
# and ntpd link this object instead.
/bin/cat > openstep_rand.c <<'REOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <sys/types.h>
#include <sys/time.h>
#include <sys/stat.h>
#include <unistd.h>

static unsigned char rc4_s[256];
static unsigned char rc4_i, rc4_j;
static int rc4_ready;
static unsigned long rc4_count;

static void
rc4_seed(void)
{
    unsigned char key[256];
    struct timeval tv;
    unsigned long mix;
    int i, j, n;
    unsigned char t;
    FILE *fp;
    static const char *devs[] = { "/dev/urandom", "/dev/random", 0 };

    memset(key, 0, sizeof(key));
    n = 0;
    for (i = 0; devs[i] != 0 && n == 0; i++) {
	fp = fopen(devs[i], "r");
	if (fp != 0) {
	    n = (int)fread(key, 1, 128, fp);
	    fclose(fp);
	}
    }
    gettimeofday(&tv, (struct timezone *)0);
    mix = (unsigned long)tv.tv_sec ^ ((unsigned long)tv.tv_usec << 12)
	^ ((unsigned long)getpid() << 5) ^ (unsigned long)clock()
	^ (unsigned long)(char *)&tv ^ (unsigned long)getppid();
    for (i = 0; i < 16; i++) {
	key[128 + i] ^= (unsigned char)(mix >> ((i & 3) * 8));
	mix = mix * 1103515245UL + 12345UL;
    }
    for (i = 0; i < 256; i++)
	rc4_s[i] = (unsigned char)i;
    j = 0;
    for (i = 0; i < 256; i++) {
	j = (j + rc4_s[i] + key[i]) & 255;
	t = rc4_s[i]; rc4_s[i] = rc4_s[j]; rc4_s[j] = t;
    }
    rc4_i = rc4_j = 0;
    for (i = 0; i < 3072; i++) {	/* discard the weak start of the stream */
	rc4_i++;
	rc4_j += rc4_s[rc4_i];
	t = rc4_s[rc4_i]; rc4_s[rc4_i] = rc4_s[rc4_j]; rc4_s[rc4_j] = t;
    }
    rc4_ready = 1;
    rc4_count = 0;
}

/* OPENSTEP's libc has no strdup(). */
char *
strdup(const char *str)
{
    size_t n = strlen(str) + 1;
    char *p = (char *)malloc(n);

    if (p != 0)
	memcpy(p, str, n);
    return p;
}

void
arc4random_buf(void *buf, size_t nbytes)
{
    unsigned char *p = (unsigned char *)buf;
    unsigned char t;

    if (!rc4_ready || rc4_count > 1600000UL)
	rc4_seed();
    while (nbytes-- > 0) {
	rc4_i++;
	rc4_j += rc4_s[rc4_i];
	t = rc4_s[rc4_i]; rc4_s[rc4_i] = rc4_s[rc4_j]; rc4_s[rc4_j] = t;
	*p++ = rc4_s[(unsigned char)(rc4_s[rc4_i] + rc4_s[rc4_j])];
	rc4_count++;
    }
}
REOF
$CC $CFLAGS -c openstep_rand.c -o openstep_rand.o
# Link the shim as a library: libtool refuses a bare .o in LIBS when it builds
# libopts.la ("cannot build libtool library from non-libtool objects").
# POSIX functions this libc lacks: getcwd (via getwd), waitpid (via wait4) and
# the termios calls (via the BSD ioctls).  ntp_refclock.c and ntpd use them even
# with no hardware clocks configured.
/bin/cat > openstep_posix.c <<'PXEOF'
/* The header's prototypes for the two speed setters use a parameter type I cannot
   see from here, and other headers (<sys/ioctl.h>) pull <sys/termios.h> in early.
   Rename the names before anything is included so the header declares its copies
   under other names, and define ours with a plain integer. */
#define cfsetispeed hdr_cfsetispeed
#define cfsetospeed hdr_cfsetospeed
#include <sys/types.h>
#include <sys/ioctl.h>
#include <sys/file.h>
#include <termios.h>
#undef cfsetispeed
#undef cfsetospeed
#include <errno.h>
#include <string.h>

extern char *getwd();
extern int wait4();

char *
getcwd(char *buf, size_t size)
{
    char tmp[1024];

    if (buf == 0 || size == 0) {
	errno = EINVAL;
	return 0;
    }
    if (getwd(tmp) == 0)
	return 0;
    if (strlen(tmp) >= size) {
	errno = ERANGE;
	return 0;
    }
    strcpy(buf, tmp);
    return buf;
}

int
waitpid(int pid, int *status, int options)
{
    return wait4(pid, (void *) status, options, (void *) 0);
}

int
tcgetattr(int fd, struct termios *t)
{
    return ioctl(fd, TIOCGETA, (char *) t);
}

int
tcsetattr(int fd, int actions, const struct termios *t)
{
    switch (actions) {
    case 0:	/* TCSANOW */
	return ioctl(fd, TIOCSETA, (char *) t);
    case 1:	/* TCSADRAIN */
	return ioctl(fd, TIOCSETAW, (char *) t);
    case 2:	/* TCSAFLUSH */
	return ioctl(fd, TIOCSETAF, (char *) t);
    }
    errno = EINVAL;
    return -1;
}

int
tcflush(int fd, int queue)
{
    int what;

    switch (queue) {
    case 1:	/* TCIFLUSH */
	what = FREAD;
	break;
    case 2:	/* TCOFLUSH */
	what = FWRITE;
	break;
    case 3:	/* TCIOFLUSH */
	what = FREAD | FWRITE;
	break;
    default:
	errno = EINVAL;
	return -1;
    }
    return ioctl(fd, TIOCFLUSH, (char *) &what);
}

#ifdef HAVE_TERMIOS_SPEED_FIELDS
int
cfsetispeed(struct termios *t, unsigned long speed)
{
    t->c_ispeed = speed;
    return 0;
}

int
cfsetospeed(struct termios *t, unsigned long speed)
{
    t->c_ospeed = speed;
    return 0;
}
#else
int
cfsetispeed(struct termios *t, unsigned long speed)
{
    return 0;
}

int
cfsetospeed(struct termios *t, unsigned long speed)
{
    return 0;
}
#endif
PXEOF
# Does struct termios here carry c_ispeed/c_ospeed?
/bin/cat > probe_ts.c <<'PEOF'
#include <sys/types.h>
#include <termios.h>
int probe_f(struct termios *t) { t->c_ispeed = 0; t->c_ospeed = 0; return 0; }
PEOF
nx_tsdef=
if $CC $CFLAGS -c probe_ts.c -o probe_ts.o > /dev/null 2>&1; then
    nx_tsdef=-DHAVE_TERMIOS_SPEED_FIELDS
fi
/bin/rm -f probe_ts.c probe_ts.o
$CC $CFLAGS $nx_tsdef -c openstep_posix.c -o openstep_posix.o
/bin/rm -f libopenstepntp.a
/bin/ar rc libopenstepntp.a openstep_rand.o openstep_posix.o
/bin/ranlib libopenstepntp.a
LIBS="-L`pwd` -lopenstepntp"
ac_cv_func_arc4random_buf=yes
export LIBS ac_cv_func_arc4random_buf

run_configure --prefix=/usr/local --sysconfdir=/usr/local/etc \
    --build=$PKG_TARGET --host=$PKG_TARGET \
    --without-crypto --without-sntp --without-ntpsnmpd --disable-debugging \
    --disable-thread-support --disable-dependency-tracking \
    --disable-all-clocks --enable-LOCAL-CLOCK
# Leave the libevent tearoff unbuilt (see above).
/bin/sed 's|cd $(top_builddir)/sntp/libevent && $(MAKE) $(AM_MAKEFLAGS)|: libevent is not needed|' \
    libntp/Makefile > libntp/Makefile.new
/bin/mv libntp/Makefile.new libntp/Makefile
/bin/sed 's|^am__append_1 = libevent$|am__append_1 =|' sntp/Makefile > sntp/Makefile.new
/bin/mv sntp/Makefile.new sntp/Makefile
/bin/gnumake LDADD_LIBEVENT=
/bin/gnumake install DESTDIR="$DESTDIR" LDADD_LIBEVENT=

# ntp installs the daemon into bin; it belongs in sbin.
/usr/local/bin/mkdir -p "$DESTDIR/usr/local/sbin"
/bin/mv "$DESTDIR/usr/local/bin/ntpd" "$DESTDIR/usr/local/sbin/ntpd"

# Ship the default configuration as ntpd.conf.dist; post-install copies it to
# ntpd.conf only when there is none, so a reinstall never replaces the
# administrator's file.
/usr/local/bin/mkdir -p "$DESTDIR/usr/local/etc" "$DESTDIR/usr/local/var/db"
/bin/cat > "$DESTDIR/usr/local/etc/ntpd.conf.dist" <<'CEOF'
# ntpd configuration.  Start with: /usr/local/sbin/ntpd -c /usr/local/etc/ntpd.conf
server 0.pool.ntp.org iburst
server 1.pool.ntp.org iburst
server 2.pool.ntp.org iburst
server 3.pool.ntp.org iburst

driftfile /usr/local/var/db/ntp.drift

# Answer time queries from this machine only; never let others change or
# query the daemon.
restrict default nomodify notrap nopeer noquery
restrict 127.0.0.1
CEOF

# Never ship a configuration file: a reinstall would replace the administrator's.
for stray in etc usr/lib; do
    if test -e "$DESTDIR/$stray"; then
        echo "ntp: the image contains $stray outside /usr/local; refusing to ship it" >&2
        exit 1
    fi
done
test -x "$DESTDIR/usr/local/sbin/ntpd"
test -f "$DESTDIR/usr/local/etc/ntpd.conf.dist"
test ! -e "$DESTDIR/usr/local/etc/ntpd.conf"
