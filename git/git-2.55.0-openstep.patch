+#include "../git-compat-util.h"
+
+extern int setpgrp(int, int);
+extern int next_bsd_getpgrp(int) __asm__("_getpgrp");
+
+#undef fflush
+extern void _fwalk(int (*)(FILE *));
+static int next_flush_status;
+static int next_flush_one(FILE *stream)
+{
+    if ((stream->_flag & (_IOWRT | _IORW)) && fflush(stream) == EOF)
+        next_flush_status = EOF;
+    return 0;
+}
+int git_next_fflush(FILE *stream)
+{
+    if (stream) return fflush(stream);
+    next_flush_status = 0;
+    _fwalk(next_flush_one);
+    return next_flush_status;
+}
+
+#undef utime
+int git_next_utime(const char *path, const struct utimbuf *times)
+{
+    struct utimbuf now;
+    if (!times) {
+        now.actime = now.modtime = time(NULL);
+        times = &now;
+    }
+    return utime(path, (struct utimbuf *)times);
+}
+
+char *getcwd(char *buffer, size_t size)
+{
+    char path[MAXPATHLEN];
+    size_t needed;
+    if (!getwd(path)) return NULL;
+    needed = strlen(path) + 1;
+    if (!buffer) {
+        if (!size) size = needed;
+        if (size < needed) { errno = ERANGE; return NULL; }
+        buffer = malloc(size);
+        if (!buffer) { errno = ENOMEM; return NULL; }
+    } else if (size < needed) { errno = ERANGE; return NULL; }
+    memcpy(buffer, path, needed);
+    return buffer;
+}
+
+long sysconf(int name)
+{
+    switch (name) {
+    case _SC_OPEN_MAX: return getdtablesize();
+    case _SC_CLK_TCK: return CLK_TCK;
+    default: errno = EINVAL; return -1;
+    }
+}
+
+pid_t waitpid(pid_t pid, int *status, int options)
+{
+    union wait result;
+    int child;
+    /* NeXT wait4 uses zero for any child and negative process groups. */
+    if (pid == -1) pid = 0;
+    else if (pid == 0) pid = -next_bsd_getpgrp(0);
+    child = wait4(pid, &result, options, NULL);
+    if (child > 0 && status) memcpy(status, &result, sizeof(*status));
+    return child;
+}
+
+int uname(struct utsname *name)
+{
+    memset(name, 0, sizeof(*name));
+    memcpy(name->sysname, "OPENSTEP", 9);
+    memcpy(name->release, "4.2", 4);
+    memcpy(name->version, "Mach", 5);
+#if defined(__i386__) || defined(i386)
+    memcpy(name->machine, "i386", 5);
+#elif defined(__m68k__)
+    memcpy(name->machine, "m68k", 5);
+#else
+    memcpy(name->machine, "unknown", 8);
+#endif
+    if (gethostname(name->nodename, sizeof(name->nodename) - 1) < 0) return -1;
+    return 0;
+}
+
+int git_next_getpgid(int pid)
+{
+    return next_bsd_getpgrp(pid);
+}
+
+pid_t setsid(void)
+{
+    int pid = getpid();
+    if (setpgrp(0, pid) < 0) return -1;
+    return pid;
+}
+
+pid_t tcgetpgrp(int fd)
+{
+    int group;
+    if (ioctl(fd, TIOCGPGRP, &group) < 0) return -1;
+    return group;
+}
+
+int sigemptyset(sigset_t *set) { *set = 0; return 0; }
+int sigfillset(sigset_t *set) { *set = ~0U; return 0; }
+int sigaddset(sigset_t *set, int signo)
+{
+    if (signo <= 0 || signo >= NSIG) { errno = EINVAL; return -1; }
+    *set |= (1U << (signo - 1));
+    return 0;
+}
+int sigprocmask(int how, const sigset_t *set, sigset_t *old)
+{
+    int previous;
+    if (!set) previous = sigblock(0);
+    else if (how == SIG_BLOCK) previous = sigblock(*set);
+    else if (how == SIG_SETMASK) previous = sigsetmask(*set);
+    else if (how == SIG_UNBLOCK) {
+        previous = sigblock(0);
+        sigsetmask(previous & ~*set);
+    } else { errno = EINVAL; return -1; }
+    if (old) *old = previous;
+    return 0;
+}
+int sigaction(int signo, const struct sigaction *act, struct sigaction *old)
+{
+    struct sigvec next, previous;
+    int result;
+    if (act) {
+        next.sv_handler = act->sa_handler;
+        next.sv_mask = act->sa_mask;
+        /* BSD restarts calls by default. Extra SIGCHLD wakeups on stop
+         * are harmless to Git's waitpid(WNOHANG) reaper. */
+        next.sv_flags = 0;
+    }
+    result = sigvec(signo, act ? &next : NULL, old ? &previous : NULL);
+    if (!result && old) {
+        old->sa_handler = previous.sv_handler;
+        old->sa_mask = previous.sv_mask;
+        old->sa_flags = 0;
+    }
+    return result;
+}
+
+int putenv(char *entry)
+{
+    extern char **environ;
+    static char **owned;
+    char *equals = strchr(entry, '=');
+    size_t length = equals ? (size_t)(equals - entry) : strlen(entry);
+    size_t count = 0, slot;
+    char **next;
+    if (!length) { errno = EINVAL; return -1; }
+    while (environ && environ[count]) count++;
+    for (slot = 0; slot < count; slot++)
+        if (!strncmp(environ[slot], entry, length) && environ[slot][length] == '=') break;
+    if (!equals) {
+        if (slot < count)
+            memmove(environ + slot, environ + slot + 1, (count - slot) * sizeof(char *));
+        return 0;
+    }
+    if (slot < count) { environ[slot] = entry; return 0; }
+    next = malloc((count + 2) * sizeof(char *));
+    if (!next) { errno = ENOMEM; return -1; }
+    if (count) memcpy(next, environ, count * sizeof(char *));
+    next[count] = entry;
+    next[count + 1] = NULL;
+    if (environ == owned) free(owned);
+    environ = owned = next;
+    return 0;
+}
