+/* Convert without narrowing through the 32-bit host strtoul(). */
+static uint64_t next_parse_integer(const char *s, char **end, int base,
+                                  int *negative, int *overflow)
+{
+    const char *start = s, *digits;
+    uint64_t value = 0;
+    unsigned int d;
+    *negative = *overflow = 0;
+    while (isspace((unsigned char)*s)) s++;
+    if (*s == '-' || *s == '+') *negative = *s++ == '-';
+    if (base && (base < 2 || base > 36)) {
+        errno = EINVAL;
+        if (end) *end = (char *)start;
+        return 0;
+    }
+    if ((base == 0 || base == 16) && s[0] == '0' &&
+        (s[1] == 'x' || s[1] == 'X') && isxdigit((unsigned char)s[2])) {
+        s += 2; base = 16;
+    }
+    if (!base) base = *s == '0' ? 8 : 10;
+    digits = s;
+    for (;; s++) {
+        unsigned char c = *s;
+        if (c >= '0' && c <= '9') d = c - '0';
+        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;
+        else break;
+        if (d >= (unsigned int)base) break;
+        if (value > (UINT64_MAX - d) / base) *overflow = 1;
+        else value = value * base + d;
+    }
+    if (end) *end = (char *)(s == digits ? start : s);
+    return value;
+}
+
+unsigned long long git_next_strtoull(const char *s, char **end, int base)
+{
+    int negative, overflow;
+    uint64_t v = next_parse_integer(s, end, base, &negative, &overflow);
+    if (overflow) { errno = ERANGE; return UINT64_MAX; }
+    return negative ? -v : v;
+}
+
+long long git_next_strtoll(const char *s, char **end, int base)
+{
+    int negative, overflow;
+    uint64_t v = next_parse_integer(s, end, base, &negative, &overflow);
+    uint64_t limit = negative ? (uint64_t)INT64_MAX + 1 : INT64_MAX;
+    if (overflow || v > limit) {
+        errno = ERANGE;
+        return negative ? INT64_MIN : INT64_MAX;
+    }
+    return negative ? -(int64_t)(v - (v != 0)) - (v != 0) : (int64_t)v;
+}
+
+int git_next_scan_uint64(const char *s, uint64_t *out)
+{
+    char *end;
+    uint64_t v = git_next_strtoull(s, &end, 10);
+    if (end == s) return 0;
+    *out = v;
+    return 1;
+}
+/*
+ * NeXT's memcmp(), strcmp() and strncmp() may compare bytes as signed char
+ * (they do on SPARC), which sorts object ids with a first byte of 0x80 or more
+ * before all others and corrupts pack indexes.  Compare as unsigned bytes.
+ */
+#undef memcmp
+#undef strcmp
+#undef strncmp
+int git_next_memcmp(const void *a, const void *b, size_t n)
+{
+    const unsigned char *p = (const unsigned char *)a;
+    const unsigned char *q = (const unsigned char *)b;
+    while (n-- > 0) {
+        if (*p != *q)
+            return *p < *q ? -1 : 1;
+        p++;
+        q++;
+    }
+    return 0;
+}
+int git_next_strcmp(const char *a, const char *b)
+{
+    const unsigned char *p = (const unsigned char *)a;
+    const unsigned char *q = (const unsigned char *)b;
+    while (*p && *p == *q) {
+        p++;
+        q++;
+    }
+    return *p == *q ? 0 : (*p < *q ? -1 : 1);
+}
+int git_next_strncmp(const char *a, const char *b, size_t n)
+{
+    const unsigned char *p = (const unsigned char *)a;
+    const unsigned char *q = (const unsigned char *)b;
+    while (n > 0 && *p && *p == *q) {
+        p++;
+        q++;
+        n--;
+    }
+    if (n == 0)
+        return 0;
+    return *p == *q ? 0 : (*p < *q ? -1 : 1);
+}
