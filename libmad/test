#!/bin/sh
set -e
TMP=/usr/tmp/libmad-test.$$
trap '/bin/rm -f "$TMP" "$TMP.c"' 0
trap 'exit 1' 1 2 15
cat > "$TMP.c" <<'EOF'
#include <mad.h>
int main(void)
{
    struct mad_stream stream;
    struct mad_frame frame;
    unsigned char data[32] = {0};
    int result;
    mad_stream_init(&stream);
    mad_frame_init(&frame);
    mad_stream_buffer(&stream, data, sizeof(data));
    result = mad_frame_decode(&frame, &stream);
    mad_frame_finish(&frame);
    mad_stream_finish(&stream);
    return result == -1 ? 0 : 1;
}
EOF
/usr/local/bin/gcc-4.2 -O2 $PKG_GCC42_ARCH_FLAGS -DNeXT -I"$LOCAL_ROOT/include" \
    "$TMP.c" -L"$LOCAL_ROOT/lib" -lmad -lm -o "$TMP"
"$TMP"
echo "libmad installed-package tests passed"
