+static void
+get_group_list(int *group_list_len, gid_t **group_list)
+{
+	int len;
+
+	len = getgroups(0, NULL);
+#ifdef HAVE_NEXT
+	if (len < 0 && errno == EINVAL) {
+		/*
+		 * OPENSTEP's getgroups(0, NULL) rejects the POSIX size probe.
+		 * Query with a bounded buffer and use the returned count.
+		 */
+		len = NGROUPS_MAX;
+		if (len <= 0)
+			len = 16;
+	}
+#endif
+	if (len < 0)
+		fatal("getgroups: %.100s", strerror(errno));
+	if (len > 0) {
+		*group_list = xreallocarray(*group_list, len, sizeof(gid_t));
+		len = getgroups(len, *group_list);
+		if (len < 0)
+			fatal("getgroups: %.100s", strerror(errno));
+	} else {
+		free(*group_list);
+		*group_list = NULL;
+	}
+	*group_list_len = len;
+}
