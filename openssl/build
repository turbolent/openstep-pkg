#!/bin/sh

set -e

DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
PATCHFILE="openssl-$VERSION-openstep.patch"
CVEPATCH="openssl-$VERSION-cve.patch"
SRCDIR="openssl-$VERSION"

export DESTDIR VERSION PATH

if [ -d "$SRCDIR" ]; then
    cd "$SRCDIR"
fi

. "$PKG_BUILD_HELPERS"

patch -p1 < "$PATCHFILE"
patch -p1 < "$CVEPATCH"

# OPENSTEP's SPARC libc compares bytes as signed in memcmp(), strcmp() and
# strncmp(); see pkg_cmp_shim in build-helpers.sh.  Empty on x86.  libcrypto
# keeps certificate names, key ids and object names in sorted stacks, and the
# signed comparison broke certificate lookups on SPARC ("unable to verify the
# first certificate" against a bundle that verifies on x86).
CMPFLAGS=`pkg_cmp_shim "\`pwd\`/openstep-cmp"`

/bin/gnumake CC=/bin/cc CFLAGS="$PKG_SYSCC_ARCH_FLAGS -pipe -O $CMPFLAGS"
/bin/gnumake CC=/bin/cc CFLAGS="$PKG_SYSCC_ARCH_FLAGS -pipe -O $CMPFLAGS" install_sw DESTDIR="$DESTDIR"

test -d "$DESTDIR/usr" || mkdir "$DESTDIR/usr"
test -d "$DESTDIR/usr/local" || mkdir "$DESTDIR/usr/local"
test -d "$DESTDIR/usr/local/ssl" || mkdir "$DESTDIR/usr/local/ssl"
test -d "$DESTDIR/usr/local/ssl/certs" || mkdir "$DESTDIR/usr/local/ssl/certs"
test -d "$DESTDIR/usr/local/ssl/private" || mkdir "$DESTDIR/usr/local/ssl/private"
test -d "$DESTDIR/usr/local/ssl/misc" || mkdir "$DESTDIR/usr/local/ssl/misc"
