#!/bin/sh

set -e

DESTDIR=$1

PATH=/usr/local/bin:$PATH
export PATH

# Old GNU tar extracts GitHub's pax_global_header as a sibling file, so pkg
# may start us in the build root instead of the extracted source directory.
if [ ! -d openstep ]; then
    cd quake2-openstep-*
fi

cd openstep
/usr/local/bin/gnumake -f Makefile.openstep CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"

test -d "$DESTDIR/usr" || mkdir "$DESTDIR/usr"
test -d "$DESTDIR/usr/local" || mkdir "$DESTDIR/usr/local"
test -d "$DESTDIR/usr/local/bin" || mkdir "$DESTDIR/usr/local/bin"
test -d "$DESTDIR/usr/local/Apps" || mkdir "$DESTDIR/usr/local/Apps"

cp -R output/quake2.app "$DESTDIR/usr/local/Apps/quake2.app"

cat > "$DESTDIR/usr/local/bin/quake2" <<'EOF'
#!/bin/sh

GAME_HOME=/usr/local/Apps/quake2.app

cd "$GAME_HOME" || exit 1
exec "$GAME_HOME/quake2" "$@"
EOF

chmod 755 "$DESTDIR/usr/local/bin/quake2" "$DESTDIR/usr/local/Apps/quake2.app/quake2"
