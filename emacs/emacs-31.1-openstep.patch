+char *strdup (const char *s)
+{
+  size_t n = strlen (s) + 1;
+  char *copy = malloc (n);
+  if (copy) memcpy (copy, s, n);
+  return copy;
+}
+/* Preserve putenv's ownership contract: the caller owns the string. */
+extern char **environ;
+int putenv (char *entry)
+{
+  static char **owned;
+  char *equals = strchr (entry, '=');
+  size_t length = equals ? equals - entry : strlen (entry);
+  size_t count = 0, i;
+  char **replacement;
+  if (!length) { errno = EINVAL; return -1; }
+  while (environ && environ[count])
+    {
+      if (!strncmp (environ[count], entry, length) && environ[count][length] == '=')
+        {
+          if (equals) environ[count] = entry;
+          else do environ[count] = environ[count + 1]; while (environ[count++]);
+          return 0;
+        }
+      count++;
+    }
+  if (!equals) return 0;
+  if (count > SIZE_MAX / sizeof (char *) - 2) { errno = ENOMEM; return -1; }
+  replacement = malloc ((count + 2) * sizeof (char *));
+  if (!replacement) { errno = ENOMEM; return -1; }
+  for (i = 0; i < count; ++i) replacement[i] = environ[i];
+  replacement[count] = entry;
+  replacement[count + 1] = NULL;
+  if (environ == owned) free (owned);
+  owned = environ = replacement;
+  return 0;
+}
+
+/* POSIX signal masks use the same 32-bit representation as BSD masks. */
+int sigemptyset (sigset_t *set) { *set = 0; return 0; }
+int sigfillset (sigset_t *set) { *set = 0x7fffffff; return 0; }
+static int openstep_signal_valid (int sig)
+{ if (sig > 0 && sig < 32) return 1; errno = EINVAL; return 0; }
+int sigaddset (sigset_t *set, int sig)
+{ if (!openstep_signal_valid (sig)) return -1; *set |= 1U << (sig - 1); return 0; }
+int sigdelset (sigset_t *set, int sig)
+{ if (!openstep_signal_valid (sig)) return -1; *set &= ~(1U << (sig - 1)); return 0; }
+int sigismember (const sigset_t *set, int sig)
+{ return openstep_signal_valid (sig) ? !!(*set & (1U << (sig - 1))) : -1; }
+int sigprocmask (int how, const sigset_t *set, sigset_t *old)
+{
+  int previous;
+  if (!set) previous = sigblock (0);
+  else switch (how)
+    {
+    case SIG_BLOCK: previous = sigblock (*set); break;
+    case SIG_UNBLOCK: previous = sigsetmask (sigblock (0) & ~*set); break;
+    case SIG_SETMASK: previous = sigsetmask (*set); break;
+    default: errno = EINVAL; return -1;
+    }
+  if (old) *old = previous;
+  return 0;
+}
+int sigsuspend (const sigset_t *set) { return sigpause (*set); }
+int sigaction (int sig, const struct sigaction *action, struct sigaction *old)
+{
+  struct sigvec vector, previous;
+  int result;
+  if (action)
+    {
+      if (action->sa_flags & ~SA_RESTART) { errno = EINVAL; return -1; }
+      vector.sv_handler = action->sa_handler;
+      vector.sv_mask = action->sa_mask;
+      vector.sv_flags = action->sa_flags & SA_RESTART ? 0 : SV_INTERRUPT;
+    }
+  result = sigvec (sig, action ? &vector : NULL, old ? &previous : NULL);
+  if (!result && old)
+    {
+      old->sa_handler = previous.sv_handler;
+      old->sa_mask = previous.sv_mask;
+      old->sa_flags = previous.sv_flags & SV_INTERRUPT ? 0 : SA_RESTART;
+    }
+  return result;
+}
+extern int setpgrp (int, int);
+int setpgid (pid_t pid, pid_t group)
+{
+  if (pid < 0 || group < 0) { errno = EINVAL; return -1; }
+  if (!pid) pid = getpid ();
+  return setpgrp (pid, group ? group : pid);
+}
+pid_t setsid (void)
+{
+  pid_t pid = getpid ();
+  int fd;
+  if (getpgrp () == pid) { errno = EPERM; return -1; }
+  if (setpgrp (0, pid) < 0) return -1;
+  fd = open ("/dev/tty", O_RDWR);
+  if (fd >= 0) { ioctl (fd, TIOCNOTTY, 0); close (fd); }
+  return pid;
+}
+extern unsigned long long strtoull (const char *, char **, int);
+uintmax_t strtoumax (const char *s, char **end, int base)
+{ return strtoull (s, end, base); }
+
+/* Numeric IPv4 conversion for gnulib's resolver adapter.  Parsing never
+   consults DNS, and copies bytes only after the entire address is valid. */
+int inet_pton (int family, const char *text, void *address)
+{
+  unsigned char bytes[4];
+  int i;
+  if (family != AF_INET) { errno = EAFNOSUPPORT; return -1; }
+  for (i = 0; i < 4; ++i)
+    {
+      unsigned int value = 0, digits = 0;
+      while (*text >= '0' && *text <= '9')
+        {
+          value = value * 10 + *text++ - '0';
+          if (++digits > 3 || value > 255) return 0;
+        }
+      if (!digits) return 0;
+      bytes[i] = value;
+      if (i != 3) { if (*text++ != '.') return 0; }
+      else if (*text) return 0;
+    }
+  memcpy (address, bytes, 4);
+  return 1;
+}
+const char *inet_ntop (int family, const void *address, char *text, socklen_t size)
+{
+  const unsigned char *bytes = address;
+  char buffer[16];
+  int length;
+  if (family != AF_INET) { errno = EAFNOSUPPORT; return NULL; }
+  length = snprintf (buffer, sizeof buffer, "%u.%u.%u.%u",
+                     bytes[0], bytes[1], bytes[2], bytes[3]);
+  if (size <= length) { errno = ENOSPC; return NULL; }
+  memcpy (text, buffer, length + 1);
+  return text;
+}
+const char *gai_strerror (int code)
+{
+  switch (code)
+    {
+    case 0: return "Success";
+    case EAI_BADFLAGS: return "Invalid resolver flags";
+    case EAI_NONAME: return "Unknown host or service";
+    case EAI_AGAIN: return "Temporary name resolution failure";
+    case EAI_FAIL: return "Name resolution failed";
+    case EAI_NODATA: return "No address for host";
+    case EAI_FAMILY: case EAI_ADDRFAMILY: return "Unsupported address family";
+    case EAI_SOCKTYPE: return "Unsupported socket type";
+    case EAI_SERVICE: return "Unsupported service";
+    case EAI_MEMORY: return "Out of memory";
+    case EAI_SYSTEM: return "System error";
+    case EAI_OVERFLOW: return "Resolver buffer too small";
+    default: return "Unknown resolver error";
+    }
+}
+
+pid_t waitpid (pid_t pid, int *status, int options)
+{ return wait4 (pid, (union wait *) status, options, NULL); }
+/* Queries used by Emacs; other sysconf selectors remain unsupported. */
+long sysconf (int name)
+{
+  switch (name)
+    {
+    case _SC_ARG_MAX: return ARG_MAX;
+    case _SC_OPEN_MAX: return getdtablesize ();
+    default: errno = EINVAL; return -1;
+    }
+}
+/* OPENSTEP off_t and the native stdio offsets are both signed long. */
+typedef char openstep_off_t_fits_long[sizeof (off_t) == sizeof (long) ? 1 : -1];
+int fseeko (FILE *stream, off_t offset, int whence)
+{ return fseek (stream, offset, whence); }
+off_t ftello (FILE *stream)
+{ return ftell (stream); }
+pid_t tcgetpgrp (int fd)
+{
+  int group;
+  return ioctl (fd, TIOCGPGRP, &group) < 0 ? -1 : group;
+}
+int tcsetpgrp (int fd, pid_t group)
+{ return ioctl (fd, TIOCSPGRP, &group); }
+
+/* The kernel implements termios ioctls, but libsys omits these interfaces. */
+int tcgetattr (int fd, struct termios *attributes)
+{ return ioctl (fd, TIOCGETA, attributes); }
+int tcsetattr (int fd, int action, const struct termios *attributes)
+{
+  struct termios copy = *attributes;
+  unsigned long request;
+  if (action & TCSASOFT)
+    { copy.c_cflag |= CIGNORE; action &= ~TCSASOFT; }
+  switch (action)
+    {
+    case TCSANOW: request = TIOCSETA; break;
+    case TCSADRAIN: request = TIOCSETAW; break;
+    case TCSAFLUSH: request = TIOCSETAF; break;
+    default: errno = EINVAL; return -1;
+    }
+  return ioctl (fd, request, &copy);
+}
+speed_t cfgetispeed (const struct termios *attributes)
+{ return attributes->c_ispeed; }
+speed_t cfgetospeed (const struct termios *attributes)
+{ return attributes->c_ospeed; }
+int cfsetispeed (struct termios *attributes, int speed)
+{
+  if (speed < B0 || speed > B57600) { errno = EINVAL; return -1; }
+  attributes->c_ispeed = speed ? speed : attributes->c_ospeed;
+  return 0;
+}
+int cfsetospeed (struct termios *attributes, int speed)
+{
+  if (speed < B0 || speed > B57600) { errno = EINVAL; return -1; }
+  attributes->c_ospeed = speed;
+  return 0;
+}
+void cfmakeraw (struct termios *attributes)
+{
+  attributes->c_iflag &= ~(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR
+                           | IGNCR | ICRNL | IXON);
+  attributes->c_oflag &= ~OPOST;
+  attributes->c_lflag &= ~(ECHO | ECHONL | ICANON | ISIG | IEXTEN);
+  attributes->c_cflag = (attributes->c_cflag & ~(CSIZE | PARENB)) | CS8;
+  attributes->c_cc[VMIN] = 1;
+  attributes->c_cc[VTIME] = 0;
+}
+int tcdrain (int fd) { return ioctl (fd, TIOCDRAIN, 0); }
+int tcflush (int fd, int queue)
+{
+  int mask;
+  switch (queue)
+    {
+    case TCIFLUSH: mask = 1; break; /* FREAD */
+    case TCOFLUSH: mask = 2; break; /* FWRITE */
+    case TCIOFLUSH: mask = 3; break;
+    default: errno = EINVAL; return -1;
+    }
+  return ioctl (fd, TIOCFLUSH, &mask);
+}
+int tcflow (int fd, int action)
+{
+  struct termios attributes;
+  unsigned char byte;
+  ssize_t result;
+  if (action == TCOOFF) return ioctl (fd, TIOCSTOP, 0);
+  if (action == TCOON) return ioctl (fd, TIOCSTART, 0);
+  if (action != TCIOFF && action != TCION) { errno = EINVAL; return -1; }
+  if (tcgetattr (fd, &attributes) < 0) return -1;
+  byte = attributes.c_cc[action == TCIOFF ? VSTOP : VSTART];
+  if (byte == (unsigned char) -1) return 0;
+  do result = write (fd, &byte, 1); while (result < 0 && errno == EINTR);
+  return result == 1 ? 0 : -1;
+}
+
+/* Keep gnulib's directory descriptor metadata in step with libc. */
+#undef close
+#undef dup
+#undef opendir
+#undef closedir
+int rpl_close (int fd)
+{
+  int result = close (fd);
+  if (result >= 0) _gl_unregister_fd (fd);
+  return result;
+}
+int rpl_dup (int fd)
+{
+  int result = dup (fd);
+  return result < 0 ? result : _gl_register_dup (fd, result);
+}
+DIR *rpl_opendir (const char *name)
+{
+  DIR *dir = opendir (name);
+  if (dir && _gl_register_fd (dirfd (dir), name) < 0)
+    { closedir (dir); return NULL; }
+  return dir;
+}
+int rpl_closedir (DIR *dir)
+{
+  int fd = dirfd (dir);
+  int result = closedir (dir);
+  if (!result) _gl_unregister_fd (fd);
+  return result;
+}
+
+/* libcurl accepts ll and z, but not C99 j and t length modifiers.
+   On this 32-bit ABI intmax_t is long long and ptrdiff_t fits long. */
+static char *
+openstep_format (const char *format)
+{
+  size_t length = strlen (format);
+  char *result, *out;
+  int conversion = 0;
+  if (length > (size_t) INT_MAX / 2) { errno = EOVERFLOW; return NULL; }
+  result = malloc (2 * length + 1);
+  if (!result) { errno = ENOMEM; return NULL; }
+  out = result;
+  for (; *format; ++format)
+    {
+      int c = (unsigned char) *format;
+      if (!conversion) conversion = c == '%';
+      else if (c == 'j') { *out++ = 'l'; c = 'l'; }
+      else if (c == 't') c = 'l';
+      else if (strchr ("diouxXfFeEgGaAcspn%", c)) conversion = 0;
+      *out++ = c;
+    }
+  *out = 0;
+  return result;
+}
+
+int
+openstep_vfprintf (FILE *stream, const char *format, va_list ap)
+{
+  char *converted = openstep_format (format);
+  int count;
+  if (!converted) return -1;
+  count = curl_mvfprintf (stream, converted, ap);
+  free (converted);
+  return count;
+}
+
+int openstep_vprintf (const char *format, va_list ap)
+{ return openstep_vfprintf (stdout, format, ap); }
+
+int openstep_vsprintf (char *dst, const char *format, va_list ap)
+{
+  char *converted = openstep_format (format);
+  int count;
+  if (!converted) return -1;
+  count = curl_mvsprintf (dst, converted, ap);
+  free (converted);
+  return count;
+}
+
+int openstep_printf (const char *format, ...)
+{
+  va_list ap; int count;
+  va_start (ap, format);
+  count = openstep_vprintf (format, ap);
+  va_end (ap); return count;
+}
+int openstep_fprintf (FILE *stream, const char *format, ...)
+{
+  va_list ap; int count;
+  va_start (ap, format);
+  count = openstep_vfprintf (stream, format, ap);
+  va_end (ap); return count;
+}
+int openstep_sprintf (char *dst, const char *format, ...)
+{
+  va_list ap; int count;
+  va_start (ap, format);
+  count = openstep_vsprintf (dst, format, ap);
+  va_end (ap); return count;
+}
+
+/* libcurl's formatter returns the bytes stored, so retry in a growing
+   buffer to implement C99's untruncated result count.  Use that count,
+   rather than strlen, to preserve embedded NUL characters. */
+int
+vsnprintf (char *dst, size_t size, const char *format, va_list ap)
+{
+  size_t capacity = 128;
+  char *buffer;
+  int count, saved_errno = errno;
+  char *converted = openstep_format (format);
+  if (!converted) return -1;
+  for (;;)
+    {
+      va_list copy;
+      buffer = malloc (capacity);
+      if (!buffer) { free (converted); errno = ENOMEM; return -1; }
+      __builtin_va_copy (copy, ap);
+      count = curl_mvsnprintf (buffer, capacity, converted, copy);
+      va_end (copy);
+      if (count < 0) { free (buffer); free (converted); return -1; }
+      if ((size_t) count < capacity - 1) break;
+      free (buffer);
+      if (capacity > INT_MAX / 2)
+        { free (converted); errno = EOVERFLOW; return -1; }
+      capacity *= 2;
+    }
+  if (size)
+    {
+      size_t n = (size_t) count < size - 1 ? count : size - 1;
+      memcpy (dst, buffer, n);
+      dst[n] = 0;
+    }
+  free (buffer);
+  free (converted);
+  errno = saved_errno;
+  return count;
+}
+
+int
+snprintf (char *dst, size_t size, const char *format, ...)
+{
+  va_list ap;
+  int count;
+  va_start (ap, format);
+  count = vsnprintf (dst, size, format, ap);
+  va_end (ap);
+  return count;
+}
+
+extern char *getwd (char *);
+char *
+getcwd (char *buffer, size_t size)
+{
+  char path[MAXPATHLEN + 1];
+  size_t length;
+  if (!getwd (path)) return NULL;
+  length = strlen (path) + 1;
+  if (!buffer)
+    {
+      if (!size) size = length;
+      if (size < length) { errno = ERANGE; return NULL; }
+      buffer = malloc (size);
+      if (!buffer) { errno = ENOMEM; return NULL; }
+    }
+  else if (size < length) { errno = size ? ERANGE : EINVAL; return NULL; }
+  memcpy (buffer, path, length);
+  return buffer;
+}
+#endif
