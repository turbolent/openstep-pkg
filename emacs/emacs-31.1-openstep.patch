+/* OPENSTEP libc compatibility for Emacs and its helper programs.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of GNU Emacs, distributed under GPL version 3 or later. */
+#include <config.h>
+#ifdef NeXT
+#include <stdio.h>
