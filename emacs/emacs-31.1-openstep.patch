diff --git a/src/nsfont-openstep.m b/src/nsfont-openstep.m
new file mode 100644
index 0000000..4f6b95f
--- /dev/null
+++ b/src/nsfont-openstep.m
@@ -0,0 +1,217 @@
+/* Native OPENSTEP font backend, using NSFont and NSString drawing.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of GNU Emacs, distributed under the GNU GPL version
+   3 or later.  See COPYING.  */
+#include <config.h>
+#include "lisp.h"
+#include "blockinput.h"
+#include "dispextern.h"
+#include "frame.h"
+#include "font.h"
+#include "nsterm.h"
+#include "pdumper.h"
+#include <math.h>
+
+static Lisp_Object
+osfont_cache (struct frame *f)
+{ return FRAME_DISPLAY_INFO (f)->name_list_element; }
+
+static Lisp_Object
+osfont_entity (NSFont *font)
+{
+  Lisp_Object e = font_make_entity ();
+  unsigned traits = [[NSFontManager sharedFontManager] traitsOfFont:font];
+  ASET (e, FONT_TYPE_INDEX, Qns);
+  ASET (e, FONT_FOUNDRY_INDEX, intern ("next"));
+  ASET (e, FONT_FAMILY_INDEX, intern ([[font familyName] UTF8String]));
+  ASET (e, FONT_REGISTRY_INDEX, Qiso10646_1);
+  FONT_SET_STYLE (e, FONT_WEIGHT_INDEX, traits & NSBoldFontMask ? Qbold : Qnormal);
+  FONT_SET_STYLE (e, FONT_SLANT_INDEX, traits & NSItalicFontMask ? Qitalic : Qnormal);
+  FONT_SET_STYLE (e, FONT_WIDTH_INDEX, Qnormal);
+  ASET (e, FONT_SIZE_INDEX, make_fixnum (0));
+  ASET (e, FONT_AVGWIDTH_INDEX, make_fixnum (0));
+  ASET (e, FONT_SPACING_INDEX, make_fixnum ([font isFixedPitch] ? 100 : 0));
+  ASET (e, FONT_EXTRA_INDEX, list1 (Fcons (QCname, [[font fontName] lispString])));
+  ASET (e, FONT_OBJLIST_INDEX, Qnil);
+  return e;
+}
+
+static Lisp_Object
+osfont_list (struct frame *f, Lisp_Object spec)
+{
+  Lisp_Object family = AREF (spec, FONT_FAMILY_INDEX), result = Qnil;
+  NSString *wanted = NILP (family) ? nil : [NSString stringWithLispString:SYMBOL_NAME(family)];
+  NSEnumerator *names = [[[NSFontManager sharedFontManager] availableFonts] objectEnumerator];
+  NSString *name;
+  block_input ();
+  while ((name = [names nextObject]))
+    {
+      NSFont *font = [NSFont fontWithName:name size:12];
+      if (font && (!wanted || [wanted caseInsensitiveCompare:[font familyName]] == NSOrderedSame
+                   || [wanted caseInsensitiveCompare:name] == NSOrderedSame
+                   || (([wanted isEqualToString:@"monospace"] || [wanted isEqualToString:@"Monospace"])
+                       && [font isFixedPitch])))
+        result = Fcons (osfont_entity (font), result);
+    }
+  unblock_input ();
+  return result;
+}
+
+static Lisp_Object
+osfont_match (struct frame *f, Lisp_Object spec)
+{
+  Lisp_Object family = AREF (spec, FONT_FAMILY_INDEX);
+  NSString *name = NILP (family) ? @"Courier" : [NSString stringWithLispString:SYMBOL_NAME(family)];
+  unsigned traits = 0;
+  NSFont *font;
+  int weight = FONT_WEIGHT_NUMERIC (spec);
+  if (weight >= 180) traits |= NSBoldFontMask;
+  if (FONT_SLANT_NUMERIC (spec) > 100) traits |= NSItalicFontMask;
+  if ([name caseInsensitiveCompare:@"Monospace"] == NSOrderedSame
+      || [name caseInsensitiveCompare:@"fixed"] == NSOrderedSame) name = @"Courier";
+  font = [[NSFontManager sharedFontManager] fontWithFamily:name traits:traits
+                            weight:weight >= 180 ? 9 : 5 size:12];
+  if (!font) font = [NSFont fontWithName:name size:12];
+  if (!font) return Qnil;
+  return osfont_entity (font);
+}
+
+static Lisp_Object
+osfont_families (struct frame *f)
+{
+  Lisp_Object result = Qnil, family;
+  NSEnumerator *names = [[[NSFontManager sharedFontManager] availableFonts] objectEnumerator];
+  NSString *name;
+  while ((name = [names nextObject]))
+    {
+      NSFont *font = [NSFont fontWithName:name size:12];
+      if (!font) continue;
+      family = intern ([[font familyName] UTF8String]);
+      if (NILP (Fmemq (family, result))) result = Fcons (family, result);
+    }
+  return result;
+}
+
+static Lisp_Object
+osfont_open (struct frame *f, Lisp_Object e, int size)
+{
+  Lisp_Object entry = Fassq (QCname, AREF (e, FONT_EXTRA_INDEX));
+  NSFont *nf;
+  struct nsfont_info *info;
+  struct font *font;
+  Lisp_Object obj;
+  if (!CONSP (entry)) return Qnil;
+  if (size <= 0) size = 12;
+  nf = [NSFont fontWithName:[NSString stringWithLispString:XCDR(entry)] size:size];
+  if (!nf) return Qnil;
+  obj = font_make_object (VECSIZE (struct nsfont_info), e, size);
+  info = (struct nsfont_info *) XFONT_OBJECT (obj);
+  font = &info->font;
+  /* font_make_object initializes Lisp slots only.  In particular,
+     baseline_offset and default_ascent must not contain allocator data. */
+  memset (&font->min_width, 0,
+          sizeof *info - offsetof (struct font, min_width));
+  info->nsfont = [nf retain];
+  info->name = xstrdup ([[nf fontName] UTF8String]);
+  info->width = [nf widthOfString:@"0"];
+  info->size = size;
+  font->driver = &nsfont_driver;
+  font->pixel_size = size;
+  font->encoding_charset = font->repertory_charset = -1;
+  font->ascent = (int)ceil ([nf ascender]);
+  font->descent = (int)ceil (-[nf descender]);
+  font->height = font->ascent + font->descent;
+  font->space_width = max (1, (int)lrint([nf widthOfString:@" "]));
+  font->average_width = max (1, (int)lrint(info->width));
+  font->min_width = font->space_width;
+  font->max_width = max(font->average_width, (int)ceil([nf maximumAdvancement].width));
+  font->underline_position = (int)lrint(-[nf underlinePosition]);
+  font->underline_thickness = max(1, (int)lrint([nf underlineThickness]));
+  info->height = font->height;
+  info->bold = ([[NSFontManager sharedFontManager] traitsOfFont:nf] & NSBoldFontMask) != 0;
+  info->ital = ([[NSFontManager sharedFontManager] traitsOfFont:nf] & NSItalicFontMask) != 0;
+  font->props[FONT_NAME_INDEX] = Ffont_xlfd_name (obj, Qnil, Qnil);
+  font->props[FONT_FULLNAME_INDEX] = build_string (info->name);
+  return obj;
+}
+
+static void osfont_close (struct font *font)
+{
+  struct nsfont_info *info = (struct nsfont_info *)font;
+  [info->nsfont release]; info->nsfont = nil;
+  xfree(info->name); info->name = NULL;
+}
+
+static int osfont_has_char (Lisp_Object font, int c) { return c < 0x10000 ? -1 : 0; }
+
+static unsigned osfont_encode (struct font *font, int c)
+{
+  struct nsfont_info *info = (struct nsfont_info *)font;
+  unichar ch = c;
+  NSString *s;
+  if (c < 0 || c > 0xffff) return FONT_INVALID_CODE;
+  s = [NSString stringWithCharacters:&ch length:1];
+  return [s canBeConvertedToEncoding:[info->nsfont mostCompatibleStringEncoding]]
+    ? c : FONT_INVALID_CODE;
+}
+
+static void osfont_extents (struct font *font, const unsigned *code, int n,
+                            struct font_metrics *metrics)
+{
+  NSFont *nf = ((struct nsfont_info *)font)->nsfont;
+  int i, width = 0;
+  for (i=0; i<n; ++i)
+    {
+      unichar ch = code[i];
+      width += lrint([nf widthOfString:[NSString stringWithCharacters:&ch length:1]]);
+    }
+  metrics->lbearing = 0; metrics->rbearing = metrics->width = width;
+  metrics->ascent = font->ascent; metrics->descent = font->descent;
+}
+
+static int osfont_draw (struct glyph_string *s, int from, int to, int x, int y,
+                       bool with_background)
+{
+  struct nsfont_info *info = (struct nsfont_info *)s->font;
+  NSColor *fg = s->hl == DRAW_CURSOR ? FRAME_BACKGROUND_COLOR(s->f)
+    : [NSColor colorWithUnsignedLong:NS_FACE_FOREGROUND(s->face)];
+  NSDictionary *attrs = [NSDictionary dictionaryWithObjectsAndKeys:
+                         info->nsfont, NSFontAttributeName, fg, NSForegroundColorAttributeName, nil];
+  int i;
+  if (with_background && s->first_glyph->type != COMPOSITE_GLYPH)
+    {
+      NSColor *bg = s->hl == DRAW_CURSOR ? FRAME_CURSOR_COLOR(s->f)
+        : [NSColor colorWithUnsignedLong:NS_FACE_BACKGROUND(s->face)];
+      [bg set];
+      NSRectFill(NSMakeRect(x,y-s->font->ascent,s->width,s->font->height));
+    }
+  for (i=from; i<to; ++i)
+    {
+      unichar ch = s->char2b[i];
+      NSString *text = [NSString stringWithCharacters:&ch length:1];
+      [text drawAtPoint:NSMakePoint(x,y-s->font->ascent) withAttributes:attrs];
+      x += lrint([info->nsfont widthOfString:text]);
+    }
+  return to-from;
+}
+
+struct font_driver const nsfont_driver = {
+  .type = LISPSYM_INITIALLY (Qns), .case_sensitive = false,
+  .get_cache = osfont_cache, .list = osfont_list, .match = osfont_match,
+  .list_family = osfont_families, .open_font = osfont_open, .close_font = osfont_close,
+  .has_char = osfont_has_char, .encode_char = osfont_encode,
+  .text_extents = osfont_extents, .draw = osfont_draw
+};
+static void osfont_register (void) { register_font_driver (&nsfont_driver, NULL); }
+void syms_of_nsfont (void)
+{
+  DEFSYM (Qcondensed, "condensed");
+  DEFSYM (Qmedium, "medium");
+  DEFSYM (Qreverse_italic, "reverse-italic");
+  DEFSYM (Qreverse_oblique, "reverse-oblique");
+  DEFSYM (Qexpanded, "expanded");
+  DEFVAR_LISP ("ns-reg-to-script", Vns_reg_to_script,
+              doc: /* Internal map of font registry to Unicode script. */);
+  Vns_reg_to_script = Qnil;
+  pdumper_do_now_and_after_load (osfont_register);
+}
