+- (NSString *)absoluteString { return urlString; }
+- (NSString *)path
+{
+  NSString *path=urlString;
+  if([path hasPrefix:@"file://localhost/"]) path=[path substringFromIndex:16];
+  else if([path hasPrefix:@"file:///"]) path=[path substringFromIndex:7];
+  else if([path hasPrefix:@"file:/"]) path=[path substringFromIndex:5];
+  /* Percent-decode UTF-8 bytes without relying on a later Foundation API. */
+  const unsigned char *s=(const unsigned char *)[path UTF8String];
+  NSMutableData *bytes=[NSMutableData data];
+  while(*s) {
+    unsigned char c=*s++;
+    if(c=='%' && s[0] && s[1]) { unsigned v; char h[3]={(char)s[0],(char)s[1],0};
+      if(sscanf(h,"%2x",&v)==1) {c=v;s+=2;} }
+    [bytes appendBytes:&c length:1];
+  }
+  return [[[NSString alloc] initWithData:bytes encoding:NSUTF8StringEncoding] autorelease];
+}
