diff --git a/openstep/math.h b/openstep/math.h
new file mode 100644
index 0000000..c81f544
--- /dev/null
+++ b/openstep/math.h
@@ -0,0 +1,84 @@
+#ifndef EMACS_OPENSTEP_MATH_H
+#define EMACS_OPENSTEP_MATH_H
+
+#include_next <math.h>
+#ifndef INFINITY
+#if defined __GNUC__ && __GNUC__ >= 4
+#define INFINITY (__builtin_inff ())
+#else
+#define INFINITY ((float) HUGE_VAL)
+#endif
+#endif
+#include <limits.h>
+#include <float.h>
+
+#ifndef isnan
+static __inline__ int openstep_isnan (double x) { return x != x; }
+#define isnan openstep_isnan
+#endif
+#ifndef isfinite
+static __inline__ int openstep_isfinite (double x)
+{ return -DBL_MAX <= x && x <= DBL_MAX; }
+#define isfinite openstep_isfinite
+#endif
+#ifndef isinf
+static __inline__ int openstep_isinf (double x)
+{ return x < -DBL_MAX || x > DBL_MAX; }
+#define isinf openstep_isinf
+#endif
+
+/* OPENSTEP libsys provides these BSD entry points, but hides their
+   declarations when _POSIX_SOURCE is defined. */
+extern double rint (double);
+extern double copysign (double, double);
+
+static __inline__ double
+openstep_scalbn (double x, int n)
+{
+  return ldexp (x, n);
+}
+
+static __inline__ double
+openstep_trunc (double x)
+{
+  return copysign (floor (fabs (x)), x);
+}
+
+static __inline__ long
+openstep_lrint (double x)
+{
+  return (long) rint (x);
+}
+
+static __inline__ long
+openstep_lround (double x)
+{
+  return (long) (x < 0 ? ceil (x - 0.5) : floor (x + 0.5));
+}
+
+static __inline__ int
+openstep_ilogb (double x)
+{
+  int exponent;
+  if (x == 0 || x != x)
+    return INT_MIN;
+  if (x > DBL_MAX || x < -DBL_MAX)
+    return INT_MAX;
+  frexp (x, &exponent);
+  return exponent - 1;
+}
+
+static __inline__ float
+openstep_powf (float x, float y)
+{
+  return (float) pow (x, y);
+}
+
+#define scalbn openstep_scalbn
+#define trunc openstep_trunc
+#define lrint openstep_lrint
+#define lround openstep_lround
+#define ilogb openstep_ilogb
+#define powf openstep_powf
+
+#endif
