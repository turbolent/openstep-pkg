+#ifdef NeXT
+/* OPENSTEP NSMenu tracks left-button events even when a context menu was
+   invoked with the right button.  Translate only within that tracking loop. */
+- (NSEvent *)nextEventMatchingMask:(unsigned int)mask untilDate:(NSDate *)date
+                           inMode:(NSString *)mode dequeue:(BOOL)dequeue
+{
+  NSEvent *event;
+  if (ns_openstep_popup_tracking)
+    {
+      if (mask & NSLeftMouseUpMask) mask |= NSRightMouseUpMask;
+      if (mask & NSLeftMouseDraggedMask) mask |= NSRightMouseDraggedMask;
+    }
+  event = [super nextEventMatchingMask:mask untilDate:date inMode:mode dequeue:dequeue];
+  if (ns_openstep_popup_tracking && event
+      && ([event type] == NSRightMouseUp || [event type] == NSRightMouseDragged))
+    return [NSEvent mouseEventWithType:[event type] == NSRightMouseUp ? NSLeftMouseUp : NSLeftMouseDragged
+      location:[event locationInWindow] modifierFlags:[event modifierFlags]
+      timestamp:[event timestamp] windowNumber:[event windowNumber] context:[event context]
+      eventNumber:[event eventNumber] clickCount:[event clickCount] pressure:[event pressure]];
+  return event;
+}
+
+- (void)openstepSelectTick:(NSTimer *)timer
+{
+  struct timespec zero = {0,0};
+  fd_set r = select_readfds, w = select_writefds, e = openstep_select_exceptfds;
+  int status = thread_select(pselect, select_nfds,
+                select_valid & SELECT_HAVE_READ ? &r : NULL,
+                select_valid & SELECT_HAVE_WRITE ? &w : NULL,
+                openstep_select_has_exceptfds ? &e : NULL, &zero, NULL);
+  if (status != 0)
+    {
+      select_readfds = r; select_writefds = w; openstep_select_exceptfds = e;
+      openstep_select_result = status;
+      ns_send_appdefined(status);
+    }
+  else if (openstep_select_has_deadline &&
+           [NSDate timeIntervalSinceReferenceDate] >= openstep_select_deadline)
+    { openstep_select_result = 0; ns_send_appdefined(-2); }
+}
