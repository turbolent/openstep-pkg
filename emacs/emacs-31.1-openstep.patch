+/* Fast enumeration was added later, but its compiler ABI is independent
+   of the Objective-C runtime. Keep mutation checks for mutable arrays. */
+typedef struct { unsigned long state; id *itemsPtr; unsigned long *mutationsPtr; unsigned long extra[5]; } OSEmacsEnumerationState;
+void objc_enumerationMutation(id object)
+{ [NSException raise:NSGenericException format:@"Collection mutated during enumeration: %@",object]; }
+@implementation NSArray (EmacsOPENSTEP)
+- (id)firstObject { return [self count] ? [self objectAtIndex:0] : nil; }
+- (NSUInteger)countByEnumeratingWithState:(OSEmacsEnumerationState *)s objects:(id *)objects count:(NSUInteger)n
+{
+  NSUInteger i=0,total=[self count];
+  if(!s->state) s->extra[0]=total;
+  else if(s->extra[0]!=total) [NSException raise:NSGenericException format:@"Collection mutated during enumeration"];
+  s->mutationsPtr=&s->extra[0]; s->itemsPtr=objects;
+  while(i<n && s->state<total) objects[i++]=[self objectAtIndex:s->state++];
+  return i;
+}
+@end
+@implementation NSEnumerator (EmacsOPENSTEP)
+- (NSUInteger)countByEnumeratingWithState:(OSEmacsEnumerationState *)s objects:(id *)objects count:(NSUInteger)n
+{ NSUInteger i=0; id obj; s->itemsPtr=objects; s->mutationsPtr=&s->extra[0]; while(i<n && (obj=[self nextObject])) objects[i++]=obj; return i; }
