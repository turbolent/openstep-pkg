+@implementation NSMenu (EmacsOPENSTEP)
++ (void)popUpContextMenu:(NSMenu *)menu withEvent:(NSEvent *)event forView:(NSView *)view
+{
+  /* Native NSMenu instances are NSMenuPanel windows.  Let AppKit track
+     their matrix, including submenus, and dispatch the selected action. */
+  NSWindow *window = (NSWindow *)menu;
+  NSMatrix *matrix;
+  NSRect cell, frame, screen;
+  NSPoint point, location;
+  NSEvent *down;
+  if (![menu numberOfItems]) return;
+  [menu sizeToFit];
+  matrix = [menu itemMatrix];
+  cell = [matrix cellFrameAtRow:0 column:0];
+  location = [matrix convertPoint:NSMakePoint(NSMinX(cell)+8, NSMidY(cell)) toView:nil];
+  point = [[view window] convertBaseToScreen:[event locationInWindow]];
+  frame = [window frame];
+  frame.origin = NSMakePoint(point.x-location.x, point.y-location.y);
+  screen = [[view window] screen] ? [[[view window] screen] frame] : [[NSScreen mainScreen] frame];
+  frame.origin.x = MAX(NSMinX(screen), MIN(frame.origin.x, NSMaxX(screen)-NSWidth(frame)));
+  frame.origin.y = MAX(NSMinY(screen), MIN(frame.origin.y, NSMaxY(screen)-NSHeight(frame)));
+  [window setFrame:frame display:NO];
+  [window orderFront:nil];
+  location = [window convertScreenToBase:point];
+  down = [NSEvent mouseEventWithType:NSLeftMouseDown location:location
+    modifierFlags:[event modifierFlags] timestamp:[event timestamp]
+    windowNumber:[window windowNumber] context:nil eventNumber:0 clickCount:1 pressure:1];
+  ns_openstep_popup_tracking = YES;
+  NS_DURING
+    [menu mouseDown:down];
+  NS_HANDLER
+    ns_openstep_popup_tracking = NO;
+    [window orderOut:nil];
+    [localException raise];
+  NS_ENDHANDLER
+  ns_openstep_popup_tracking = NO;
+  [window orderOut:nil];
+}
+- (NSInteger)numberOfItems { return [[self itemArray] count]; }
