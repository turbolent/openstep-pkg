+@implementation NSImage (EmacsOPENSTEP)
+- (void)drawInRect:(NSRect)dest fromRect:(NSRect)src operation:(NSCompositingOperation)op
+          fraction:(CGFloat)fraction respectFlipped:(BOOL)flipped hints:(NSDictionary *)hints
+{
+  NSSize original=[self size];
+  NSSize scaled=NSMakeSize(original.width*dest.size.width/src.size.width,
+                           original.height*dest.size.height/src.size.height);
+  BOOL oldScales=[self scalesWhenResized];
+  [self setScalesWhenResized:YES];
+  [self setSize:scaled];
+  PSgsave();
+  if(flipped && [[NSView focusView] isFlipped]) {
+    PStranslate(dest.origin.x,dest.origin.y+dest.size.height);
+    PSscale(1,-1);
+  } else PStranslate(dest.origin.x,dest.origin.y);
+  [self compositeToPoint:NSZeroPoint fromRect:NSMakeRect(0,0,scaled.width,scaled.height) operation:op];
+  PSgrestore();
+  [self setSize:original];
+  [self setScalesWhenResized:oldScales];
+}
+@end
