diff --git a/openstep/wchar.h b/openstep/wchar.h
new file mode 100644
index 0000000..ea65669
--- /dev/null
+++ b/openstep/wchar.h
@@ -0,0 +1,42 @@
+#ifndef EMACS_OPENSTEP_WCHAR_H
+#define EMACS_OPENSTEP_WCHAR_H
+/* OPENSTEP has a single-byte C locale.  Emacs performs its own Unicode
+   conversion; these interfaces serve the bundled POSIX regex library. */
+#include <stddef.h>
+#include <limits.h>
+#include <errno.h>
+#include <stdio.h>
+typedef unsigned int wint_t;
+#ifndef mbstate_t
+typedef int mbstate_t;
+#endif
+#define WEOF ((wint_t) -1)
+#ifndef WCHAR_MIN
+#define WCHAR_MIN 0
+#define WCHAR_MAX 65535U
+#endif
+#ifndef WINT_MIN
+#define WINT_MIN 0U
+#define WINT_MAX UINT_MAX
+#endif
+
+static __inline__ int mbsinit (const mbstate_t *s) { return 1; }
+static __inline__ wint_t btowc (int c)
+{ return c == EOF || (unsigned int) c > UCHAR_MAX ? WEOF : c; }
+static __inline__ size_t
+mbrtowc (wchar_t *wc, const char *s, size_t n, mbstate_t *state)
+{
+  if (!s) return 0;
+  if (!n) return (size_t) -2;
+  if (wc) *wc = (unsigned char) *s;
+  return *s ? 1 : 0;
+}
+static __inline__ size_t
+wcrtomb (char *s, wchar_t wc, mbstate_t *state)
+{
+  if (!s) return 1;
+  if ((unsigned int) wc > UCHAR_MAX) { errno = EILSEQ; return (size_t) -1; }
+  *s = (char) wc;
+  return 1;
+}
+#endif
diff --git a/openstep/wctype.h b/openstep/wctype.h
new file mode 100644
index 0000000..1cc7706
--- /dev/null
+++ b/openstep/wctype.h
@@ -0,0 +1,44 @@
+#ifndef EMACS_OPENSTEP_WCTYPE_H
+#define EMACS_OPENSTEP_WCTYPE_H
+#include <wchar.h>
+#include <ctype.h>
+#include <string.h>
+typedef unsigned int wctype_t;
+static __inline__ wctype_t wctype (const char *name)
+{
+  static const char *const names[] = {
+    "alnum", "alpha", "blank", "cntrl", "digit", "graph",
+    "lower", "print", "punct", "space", "upper", "xdigit"
+  };
+  unsigned int i;
+  for (i = 0; i < sizeof names / sizeof names[0]; ++i)
+    if (!strcmp (name, names[i])) return i + 1;
+  return 0;
+}
+static __inline__ int iswctype (wint_t wc, wctype_t type)
+{
+  int c;
+  if (wc > UCHAR_MAX) return 0;
+  c = (unsigned char) wc;
+  switch (type) {
+  case 1: return isalnum (c);
+  case 2: return isalpha (c);
+  case 3: return c == ' ' || c == '\t';
+  case 4: return iscntrl (c);
+  case 5: return isdigit (c);
+  case 6: return isgraph (c);
+  case 7: return islower (c);
+  case 8: return isprint (c);
+  case 9: return ispunct (c);
+  case 10: return isspace (c);
+  case 11: return isupper (c);
+  case 12: return isxdigit (c);
+  default: return 0;
+  }
+}
+static __inline__ int iswalnum (wint_t c) { return iswctype (c, 1); }
+static __inline__ wint_t towlower (wint_t c)
+{ return c <= UCHAR_MAX ? tolower ((unsigned char) c) : c; }
+static __inline__ wint_t towupper (wint_t c)
+{ return c <= UCHAR_MAX ? toupper ((unsigned char) c) : c; }
+#endif
