#!/bin/sh

set -e

DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC=/usr/local/bin/gcc-4.2
CFLAGS="$PKG_GCC42_ARCH_FLAGS "'-O2 -g -D_POSIX_SOURCE -D_NEXT_SOURCE'
CONFIG_SHELL=/usr/local/bin/ksh
MAKE=/usr/local/bin/gnumake
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
# pdksh returns failure for `unset CDPATH` if CDPATH was never set.
CDPATH=
# The header exists, but OPENSTEP libsys does not implement uname.
ac_cv_header_sys_utsname_h=no
export DESTDIR VERSION PATH CC CFLAGS CONFIG_SHELL MAKE GREP EGREP AWK
export ac_cv_header_sys_utsname_h CDPATH
. "$PKG_BUILD_HELPERS"

if [ -d "emacs-$VERSION" ]; then
    cd "emacs-$VERSION"
fi
patch -p1 < "emacs-$VERSION-openstep.patch"
CPPFLAGS="-I`pwd`/openstep -I/usr/local/include"
export CPPFLAGS
# The patch updates both configure.ac and its generated configure.
/usr/bin/touch configure
run_configure --build=$PKG_TARGET --host=$PKG_TARGET \
    --prefix=/usr/local --infodir="/usr/local/share/info/emacs-$VERSION" \
    --without-x --with-ns --disable-ns-self-contained \
    --without-file-notification --without-modules --without-gnutls \
    --without-native-compilation --with-wide-int
# Use the complete upstream Info manuals. Texinfo 4.8 cannot regenerate
# the current Texinfo sources; no documentation sources are changed here.
"$MAKE" SHELL="$CONFIG_SHELL" MAKEINFO=:
"$MAKE" SHELL="$CONFIG_SHELL" MAKEINFO=: install DESTDIR="$DESTDIR"
# Upstream ignores some install errors; reject an incomplete image.
test -f "$DESTDIR/usr/local/share/emacs/$VERSION/lisp/simple.elc"
test -x "$DESTDIR/usr/local/bin/emacs"
test -f "$DESTDIR/usr/local/share/info/emacs-$VERSION/emacs.info" || \
    test -f "$DESTDIR/usr/local/share/info/emacs-$VERSION/emacs.info.gz"
test -f "$DESTDIR/usr/local/share/info/emacs-$VERSION/elisp.info" || \
    test -f "$DESTDIR/usr/local/share/info/emacs-$VERSION/elisp.info.gz"
found_dump=no
for dump in "$DESTDIR/usr/local/libexec/emacs/$VERSION"/*/emacs-*.pdmp; do
    if [ -f "$dump" ]; then
        # pkg copies images with the stock tar, whose pathname limit is
        # 100 bytes. Use Emacs's supported basename dump lookup instead
        # of the longer fingerprint filename.
        dump_dir=${dump%/*}
        mv "$dump" "$dump_dir/emacs.pdmp"
        ln -s emacs.pdmp "$dump_dir/emacs-$VERSION.pdmp"
        found_dump=yes
    fi
done
test "$found_dump" = yes

# A native OPENSTEP bundle for Workspace, sharing the normal installation.
test -d "$DESTDIR/usr/local/Apps" || mkdir "$DESTDIR/usr/local/Apps"
app="$DESTDIR/usr/local/Apps/Emacs.app"
mkdir "$app"
cp nextstep/OPENSTEP-Info.plist "$app/Info.plist"
cp nextstep/GNUstep/Emacs.base/Resources/emacs.tiff "$app/emacs.tiff"
cp nextstep/GNUstep/Emacs.base/Resources/README "$app/README-icon"
ln -s ../../bin/emacs "$app/Emacs"
# OPENSTEP preserves the bundle executable name when looking for the dump.
ln -s emacs.pdmp "$dump_dir/Emacs.pdmp"
