#!/bin/sh

set -e

TMP=/usr/tmp/mpg123-test.$$
MPG123=$LOCAL_ROOT/bin/mpg123
SWEEP=$LOCAL_ROOT/share/doc/mpg123/sweep.mp3
trap '/bin/rm -f "$TMP.c" "$TMP" "$TMP.wav" "$TMP.raw"' 0
trap 'exit 1' 1 2 15

"$MPG123" --version | grep '1\.31\.4' >/dev/null
"$LOCAL_ROOT/bin/out123" --version | grep '1\.31\.4' >/dev/null
"$MPG123" -q -t "$SWEEP"
cat "$SWEEP" | "$MPG123" -q -t -
"$MPG123" -q -w "$TMP.wav" "$SWEEP"
"$MPG123" -q -s "$SWEEP" > "$TMP.raw"
test -s "$TMP.wav"
test -s "$TMP.raw"

cat > "$TMP.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <mpg123.h>
#include <out123.h>
#include <syn123.h>

/* Regression test for the port's bounded-formatting helper. */
extern int INT123_openstep_snprintf(char *, size_t, const char *, ...);

static mpg123_ssize_t empty_reader(void *handle, void *buf, size_t count)
{
    return 0;
}

int main(int argc, char **argv)
{
    mpg123_handle *mh;
    out123_handle *ao;
    syn123_handle *sh;
    unsigned char pcm[16384];
    char text[5], large[8192];
    long rate;
    int channels, encoding, rc, err;
    size_t done, total = 0;
    off_t samples;

    if(argc != 2) return 1;
    if(INT123_openstep_snprintf(text, sizeof(text), "%s:%d", "abcdef", 7) != 8
        || strcmp(text, "abcd")) return 2;
    if(INT123_openstep_snprintf(NULL, 0, "%s", "hello") != 5) return 3;
    memset(large, 'x', sizeof(large)-1);
    large[sizeof(large)-1] = 0;
    if(INT123_openstep_snprintf(text, sizeof(text), "%s", large) != 8191
        || strcmp(text, "xxxx")) return 4;
    if(INT123_openstep_snprintf(text, 1, "%d", 123) != 3 || text[0]) return 5;
    if(syn123_resample_total(8000, 48000, 12637) != 75822) return 6;
    if(syn123_resample_intotal(8000, 48000, 75822) != 12637) return 7;
    sh = syn123_new(44100, 1, MPG123_ENC_SIGNED_16, 0, &err);
    if(!sh) return 8;
    syn123_del(sh);
    ao = out123_new();
    if(!ao) return 9;
    out123_del(ao);
    mh = mpg123_new(NULL, &err);
    if(!mh) return 17;
    mpg123_param(mh, MPG123_ADD_FLAGS, MPG123_QUIET, 0);
    mpg123_param(mh, MPG123_TIMEOUT, 1, 0);
    mpg123_replace_reader_handle(mh, empty_reader, NULL, NULL);
    if(mpg123_open_handle(mh, NULL) == MPG123_OK) return 18;
    mpg123_delete(mh);
    mh = mpg123_new(NULL, &err);
    if(!mh) return 10;
    if(mpg123_open(mh, argv[1]) != MPG123_OK) return 11;
    if(mpg123_getformat(mh, &rate, &channels, &encoding) != MPG123_OK) return 12;
    if(encoding != MPG123_ENC_SIGNED_16 || rate <= 0 || channels < 1) return 13;
    if(mpg123_scan(mh) != MPG123_OK) return 14;
    samples = mpg123_length(mh);
    if(samples <= 0 || mpg123_seek(mh, 0, SEEK_SET) != 0) return 15;
    do {
        rc = mpg123_read(mh, pcm, sizeof(pcm), &done);
        total += done;
    } while(rc == MPG123_OK);
    if(rc != MPG123_DONE || total != (size_t)samples * channels * 2) return 16;
    printf("Decoded %lu bytes, %ld samples at %ld Hz (%d channels)\n",
        (unsigned long)total, (long)samples, rate, channels);
    mpg123_delete(mh);
    mpg123_exit();
    return 0;
}
EOF

SDL_LIBS=`"$LOCAL_ROOT/bin/sdl-config" --libs`
/usr/local/bin/gcc-4.2 -O2 $PKG_GCC42_ARCH_FLAGS -DNeXT -I"$LOCAL_ROOT/include" \
    "$TMP.c" -L"$LOCAL_ROOT/lib" -lmpg123 -lout123 -lsyn123 \
    $SDL_LIBS -lm -o "$TMP"
if [ "$PKG_ARCH" = i386 ]; then
    /bin/csh -f "$LOCAL_ROOT/bin/sdl-fix-macho-i486-subtype" "$TMP" >/dev/null
fi
"$TMP" "$SWEEP"

if test "${MPG123_TEST_AUDIO-0}" = 1; then
    SDL_AUDIODRIVER=openstep
    export SDL_AUDIODRIVER
    "$MPG123" -q -o sdl -f 1024 -n 80 "$SWEEP"
    "$MPG123" -q -o sdl -f 1024 -n 2 "$SWEEP"
fi
echo "mpg123 installed-package tests passed"
