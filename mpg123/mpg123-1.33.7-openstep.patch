 // Net123 variant for our internal code that has safer legacy support for HTTP shoutcast.
 
+#ifdef NeXT
+/* The library cannot time out opaque reader handles. Wait on the actual
+   socket/pipe here, before every read, including HTTP response headers. */
+size_t net123_read_fd(int fd, void *buf, size_t bytes)
+{
+	size_t got = 0;
+	if(param.timeout <= 0) return INT123_unintr_read(fd, buf, bytes);
+	if(fd < 0 || fd >= FD_SETSIZE) return 0;
+	while(got < bytes)
+	{
+		fd_set fds;
+		struct timeval tv;
+		int ready;
+		ssize_t part;
+		FD_ZERO(&fds);
+		FD_SET(fd, &fds);
+		tv.tv_sec = param.timeout;
+		tv.tv_usec = 0;
+		ready = select(fd+1, &fds, NULL, NULL, &tv);
+		if(ready < 0 && errno == EINTR) continue;
+		if(ready <= 0)
+		{
+			if(!ready) error("network read timed out");
+			break;
+		}
+		part = read(fd, (char *)buf+got, bytes-got);
+		if(part > 0) got += part;
+		else if(part < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+		else break;
+	}
+	return got;
+}
+#endif
+
